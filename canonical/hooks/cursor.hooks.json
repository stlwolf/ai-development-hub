{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "$HOME/.cursor/hooks/block-destructive.sh",
        "failClosed": true
      },
      {
        "command": "$HOME/.cursor/hooks/block-force-push.sh",
        "failClosed": true
      },
      {
        "command": "$HOME/.cursor/hooks/cc-lint.sh",
        "failClosed": true
      }
    ]
  }
}
