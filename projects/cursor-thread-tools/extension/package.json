{
  "name": "cursor-thread-tools",
  "displayName": "Cursor Thread Tools",
  "description": "Export Cursor Composer threads to Markdown and manage thread lifecycle",
  "version": "0.1.0",
  "publisher": "stlwolf",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:threadTools.list",
    "onCommand:threadTools.export"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "threadTools.list",
        "title": "Thread Tools: List Threads"
      },
      {
        "command": "threadTools.export",
        "title": "Thread Tools: Export Thread to Markdown"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
