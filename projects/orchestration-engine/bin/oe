#!/usr/bin/env bash
# oe — engine の入口。`oe <verb> [引数...]` で、同じディレクトリの oe-<verb> を exec する（#605）
#
# usage:
#   oe <verb> [引数...]     同じディレクトリの oe-<verb> を、引数をそのままにして exec する
#   oe -h | --help | help   使い方と verb の一覧を標準出力に出す（1行目は engine の bin/ の実体のパス）
#   oe                      使い方と verb の一覧を標準エラーに出す（exit 2）
#
#   verb の使い方は `oe <verb> --help` で見る（入口は --help を verb へそのまま渡す）。
#   1サイクルの自律オーケストレーションの本体は `oe run`（bin/oe-run）である。
#
# 設計の正本は projects/orchestration-engine/docs/plans/2026-11-09-plan-605-single-entry-command.md（DJ-3・DJ-4）。
#
# - 自分の実体のディレクトリは、symlink を1段ずつたどって解く（readlink に -f を付けない。bash 3.2 と
#   readlink -f の無い macOS で動かすため）。解く処理はサブシェルの中で行い、呼び出し元の作業ディレクトリと
#   環境を変えない。CDPATH はそのサブシェルの中で空にする（cd が行き先を標準出力に出して混ざるため）。
# - 振り分け先は、解いたディレクトリの oe-<verb> だけを見る。PATH は探さず、書き換えない。
# - 振り分けは exec で行う。プロセスが1段も増えないので、引数・標準入出力・終了コード・シグナル・環境変数は
#   verb と呼び出し元の間で直に受け渡される（lease の本人確認は CLAUDE_PID とペインの前面のプロセスで行う）。
# - verb の一覧は固定で持たない。oe-<verb> のファイルを足せば、入口を触らずに呼べる。名前 help だけは入口の
#   help に使うので verb の候補にしない（oe-help を置いても一覧に出さず、呼べない）。
# - 入口の判断（場所を解く・名前を確かめる・help を出す）は、すべてサブシェルの中で行う。本体のシェルでは
#   変数に何も代入せずに exec する。呼び出し元が export した同名の変数（dir・verb など）を入口が書き換えて
#   verb に渡すことがないようにするためである（実装SO の指摘 1。bash の local は export の属性を引き継ぐ）。
#
# exit: verb の終了コードのまま / 2 呼び方の誤り / 127 その verb が無い / 1 入口が自分の場所を解けない
#
# 差し替えの口（テスト用）: OE_ENTRY_LINK_LIMIT（symlink をたどる段の上限・既定 40）

set -uo pipefail

oe_entry_err() { printf 'oe: %s\n' "$1" >&2; }

# 自分の実体のディレクトリを出す。失敗したら誤りを出して非0を返す。
oe_entry_dir() (
  CDPATH=''
  local src limit n target
  src="${BASH_SOURCE[0]:-$0}"
  limit="${OE_ENTRY_LINK_LIMIT:-40}"
  case "$limit" in ''|*[!0-9]*) limit=40 ;; esac
  n=0
  while [ -L "$src" ]; do
    n=$((n + 1))
    if [ "$n" -gt "$limit" ]; then
      oe_entry_err "自分の場所を解けません: symlink の段が上限（${limit}）を超えました: ${BASH_SOURCE[0]:-$0}"
      return 1
    fi
    if ! target="$(readlink "$src")"; then
      oe_entry_err "自分の場所を解けません: リンクを読めません: ${src}"
      return 1
    fi
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(dirname "$src")/${target}" ;;
    esac
  done
  if ! cd -P "$(dirname "$src")" 2>/dev/null; then
    oe_entry_err "自分の場所を解けません: ディレクトリに入れません: $(dirname "$src")"
    return 1
  fi
  pwd -P
)

# 振り分けの候補の条件（一覧も同じ条件を使う）。名前の検査を通り、help でなく、oe-<verb> が symlink でない
# 通常のファイルで、実行できること。
# 名前の検査は、端を固定した正規表現で行う（glob で書くと1文字の名前を拒み、abc/def を通す）。
# 正規表現は変数に入れて [[ =~ ]] の右に引用せずに置く（bash 3.2 と 5 で同じに動く形）。
# この関数はサブシェル（oe_entry_check）の中からだけ呼ぶ。
oe_entry_is_verb() {
  local dir="$1" name="$2" f re='^[a-z0-9][a-z0-9-]*$'
  [[ "$name" =~ $re ]] || return 1
  [ "$name" != help ] || return 1
  f="${dir}/oe-${name}"
  [ -f "$f" ] && [ ! -L "$f" ] && [ -x "$f" ]
}

# verb の一覧。説明は2行目が「# oe-<verb> — <説明>」の形のときだけ出す（飾りなので、読めなくても一覧は出す）。
oe_entry_list() {
  local dir="$1" f name line2 desc count=0
  for f in "${dir}"/oe-*; do
    name="${f##*/oe-}"
    oe_entry_is_verb "$dir" "$name" || continue
    desc=''
    if [ -r "$f" ]; then
      line2="$(sed -n '2p' "$f" 2>/dev/null)" || line2=''
      case "$line2" in
        "# oe-${name} — "*) desc="${line2#"# oe-${name} — "}" ;;
      esac
    fi
    printf '  %-16s %s\n' "$name" "$desc"
    count=$((count + 1))
  done
  if [ "$count" -eq 0 ]; then
    printf '  （verb がありません: %s に oe-<verb> の実行できるファイルが無い）\n' "$dir"
  fi
}

oe_entry_help() {
  local dir="$1"
  printf 'bin: %s\n' "$dir"
  printf '\n'
  printf 'usage: oe <verb> [引数...]\n'
  printf '       oe -h | --help | help\n'
  printf '\n'
  printf 'verbs:\n'
  oe_entry_list "$dir"
  printf '\n'
  printf 'verb の使い方は oe <verb> --help で見ます。\n'
  printf 'exit: verb の終了コードのまま / 2 呼び方の誤り / 127 その verb が無い / 1 入口が自分の場所を解けない\n'
}

# 入口の判断をすべて行うサブシェル。終わり方で本体のシェルに伝える。
#   0   振り分けてよい（本体のシェルが exec する）
#   100 help を出し終えた（本体のシェルは 0 で終わる）
#   それ以外  その終了コードで終わる（誤りの文はここで出し終えている）
oe_entry_check() (
  local dir verb
  dir="$(oe_entry_dir)" || exit 1

  if [ "$#" -eq 0 ]; then
    oe_entry_help "$dir" >&2
    exit 2
  fi

  case "$1" in
    -h|--help|help)
      if [ "$#" -gt 1 ]; then
        oe_entry_err "verb の使い方は oe <verb> --help で見ます（例: oe send --help）"
        exit 2
      fi
      oe_entry_help "$dir"
      exit 100
      ;;
    -*)
      oe_entry_err "知らないオプションです: $1"
      oe_entry_help "$dir" >&2
      exit 2
      ;;
  esac

  verb="$1"
  if oe_entry_is_verb "$dir" "$verb"; then
    exit 0
  fi

  oe_entry_err "no such verb: '${verb}'（oe --help で一覧）"
  case "$verb" in
    oe-*)
      if oe_entry_is_verb "$dir" "${verb#oe-}"; then
        oe_entry_err "前置きの oe- は付けません。oe ${verb#oe-} と打ちます"
      fi
      ;;
  esac
  exit 127
)

# 本体のシェルでは変数に代入しない。判断はサブシェルに任せ、通ったら場所を解き直して exec する
# （場所を解く処理は同じ結果を返すので、2回目も同じディレクトリになる）。
oe_entry_check "$@" || exit $(( $? == 100 ? 0 : $? ))
exec "$(oe_entry_dir)/oe-$1" "${@:2}"
