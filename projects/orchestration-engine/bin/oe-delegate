#!/usr/bin/env bash
# oe-delegate — 子 Claude セッションを起動し、タスクをキックする
#
# usage: oe-delegate [-w WORKSPACE] [--brief <path>] [--label <#N|name>] [--claude-arg <arg>]
#                    [--reason <text>] [--elevated] [--print-approval | --approved-digest <digest>] [--] <task>
#
# elevated（bypass / 本番アクセス）子の spawn 段 owner 承認ハンドシェイク（#262 v0）:
#   --print-approval は spawn せず、正規化 argv のダイジェストと owner 向け承認パッケージを印字する
#   （print は子を作らないので auto-mode classifier に block されない）。owner が承認したのち、
#   同じ引数 + --approved-digest <digest> で実 spawn する。oe-delegate は spawn 直前にダイジェストを
#   再計算して照合し、承認内容と実行が一致すること（binding）を機構的に保証する。実 spawn 自体は
#   従来どおり owner ゲート（分類器）を通る——ハンドシェイクは分類器を迂回しない。
#   --elevated（or bypassPermissions）を宣言した spawn は承認済みダイジェストを必須にする
#   （承認を経ず到達する迂回を engine 側で塞ぐ）。通常のローカル auto 委譲は対象外・不変。
#
# 子ペインを tmux split-window で起動し、キックは bin/oe-send 経由で注入する
# （spawn + send の合成）。delegate は委譲（起動とキック）に専念し、戻し（report）の処理は
# 持たない（Unix 哲学・単機能）。子が親へ返したいときは汎用の oe-send を使う。親ペインは
# PARENT_TMUX_PANE 環境変数として子へ渡してあるので oe-send "$PARENT_TMUX_PANE" で返せる。
# Phase 5 HitL 統合はスコープ外（Issue #138）。

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/delegate-registry.sh
source "${BIN_DIR}/../lib/delegate-registry.sh"
# 活動ログ emit（best-effort・#206）。source 失敗や関数不在でも委譲本体は壊さない。
# shellcheck source=../lib/event-bus.sh
# 2>/dev/null は付けない（#322）。消せるのは診断だけで、失敗そのものは止められない。
# || true は残す（event-bus 不在でも delegate は動く・declare -F の no-op と対）。
source "${BIN_DIR}/../lib/event-bus.sh" || true
# lease の記録（#577 PR-2）。registry と両方書く。source に失敗しても委譲本体は壊さない。
# shellcheck source=../lib/lease.sh
source "${BIN_DIR}/../lib/lease.sh" || true
# エージェントごとの差（#562）。起こす引数・権限のモードの読み方・コマンド名の集合はここだけが持つ。
# shellcheck source=../lib/agent.sh
source "${BIN_DIR}/../lib/agent.sh"
# 拍動の床（#562 DJ-6）。hook に依らず、起こしたときに lease の名前で sidecar を1件書く。無くても委譲は続ける。
# shellcheck source=../lib/heartbeat-resolve.sh
source "${BIN_DIR}/../lib/heartbeat-resolve.sh" || true

usage() {
  cat >&2 <<'EOF'
usage: oe-delegate [-w WORKSPACE] [--brief <path>] [--label <#N|name>] [--agent <claude|codex>] [--agent-arg <arg>]
                   [--reason <text>] [--elevated] [--print-approval | --approved-digest <digest>] [--] <task>

  <task>              子セッションへ送るタスク（1行テキスト・改行不可）
                      --brief があれば省略可
  -w, --workspace DIR 子セッションの作業ディレクトリ（デフォルト: カレントディレクトリ）
  --brief <path>      brief doc（委譲指示書）を子に読ませる（"<path> を読んで進めて。" を付加）。
                      子から読めるよう doc のディレクトリを --add-dir で開示する
  --kickoff <path>    --brief の deprecated alias（後方互換・#255）。新規は --brief を使う
  --label <#N|name>   子を registry に登録する際のラベル（後で oe-send <label> で指す）。
                      省略時はラベル無しで登録（wt switch 後は pane-issue の #N で解決可）
  --agent <name>      子として起こすエージェント（claude | codex・既定 claude・#562）。
                      codex は --no-daemon・-c check_for_update_on_startup=false・--approve-for-me（--agent-arg で
                      承認のモードを指定したときは外す）・-c developer_instructions=… を付けて起こす
  --agent-arg <arg>   子の起動時に渡す追加引数（repeatable）。--claude-arg は同じ意味の alias。
                      例: --agent-arg --permission-mode --agent-arg auto
  --reason <text>     承認パッケージに載せる理由（1行・#262 elevated 承認ハンドシェイク用）。
  --elevated          この子を elevated（本番 / 機微アクセス等）と宣言する。宣言すると実 spawn は
                      owner 承認済みダイジェスト（--approved-digest）を必須にする（無ければ exit 3）。
                      bypassPermissions 子は宣言せずとも elevated 扱い。通常のローカル auto 委譲は対象外。
  --print-approval    spawn せず、正規化 argv のダイジェスト + owner 向け承認パッケージを印字。
                      elevated 子の spawn 前に owner 承認を取るのに使う（print は子を作らないので block されない）。
  --approved-digest <digest>
                      実 spawn 時に承認済みダイジェストを渡す。oe-delegate が引数から再計算した
                      ダイジェストと照合し、不一致なら spawn を拒否（承認↔実行の binding・不一致は exit 3）。
                      渡された場合は空文字でも必ず照合する（照合スキップ迂回を塞ぐ）。
  -h, --help          このヘルプを表示

環境変数:
  OE_DELEGATE_WAIT_SEC  claude 起動待ちの秒数（デフォルト: 4）
  TMUX_PANE             tmux 内で自動設定される親ペイン ID（必須）
  PARENT_TMUX_PANE      子へ自動で渡る「親ペイン」コンテキスト（設定不要）。
                        子が親へ返したいときは oe-send "$PARENT_TMUX_PANE" "..." を使う
EOF
}

WORKSPACE="$(pwd)"
BRIEF=""
LABEL=""
AGENT="$OE_AGENT_DEFAULT"
AGENT_ARGS=()
REASON=""
PRINT_APPROVAL=""
APPROVED_DIGEST=""
APPROVED_DIGEST_SET=""
ELEVATED=""
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -w|--workspace)
      [[ $# -ge 2 ]] || { echo "oe-delegate: --workspace requires a value" >&2; exit 2; }
      WORKSPACE="$2"; shift 2 ;;
    --brief|--kickoff)
      # --kickoff は --brief の deprecated alias（後方互換・#255）。エラー文言は実際に
      # 渡された flag（$1）を映す。
      [[ $# -ge 2 ]] || { echo "oe-delegate: $1 requires a value" >&2; exit 2; }
      BRIEF="$2"; shift 2 ;;
    --label)
      [[ $# -ge 2 ]] || { echo "oe-delegate: --label requires a value" >&2; exit 2; }
      # 改行（LF/CR）を含むラベルは registry 経由で oe_reg_list 出力を複数行化し、消費者
      # （oe-list/oe-select/oe-status）の行パースに偽 %N 候補行を紛れ込ませ得る。
      # --claude-arg と同様、書き込み前に fail-fast 拒否する（前例 lib/delegate-send.sh）。
      if [[ "$2" == *$'\n'* || "$2" == *$'\r'* ]]; then
        echo "oe-delegate: --label value must be a single line (no newline)" >&2
        exit 2
      fi
      LABEL="$2"; shift 2 ;;
    --agent)
      [[ $# -ge 2 ]] || { echo "oe-delegate: --agent requires a value" >&2; exit 2; }
      oe_agent_valid "$2" || { echo "oe-delegate: --agent must be one of: ${OE_AGENTS} (got: $2)" >&2; exit 2; }
      AGENT="$2"; shift 2 ;;
    --agent-arg|--claude-arg)
      # --claude-arg は --agent-arg の alias（#562・今までの呼び出し元を壊さない）。エラー文言は渡された flag を映す。
      [[ $# -ge 2 ]] || { echo "oe-delegate: $1 requires a value" >&2; exit 2; }
      if [[ "$2" == *$'\n'* || "$2" == *$'\r'* ]]; then
        echo "oe-delegate: $1 value must be a single argument (no newline)" >&2
        exit 2
      fi
      AGENT_ARGS+=("$2"); shift 2 ;;
    --reason)
      [[ $# -ge 2 ]] || { echo "oe-delegate: --reason requires a value" >&2; exit 2; }
      if [[ "$2" == *$'\n'* || "$2" == *$'\r'* ]]; then
        echo "oe-delegate: --reason value must be a single line (no newline)" >&2
        exit 2
      fi
      REASON="$2"; shift 2 ;;
    --print-approval)
      PRINT_APPROVAL=1; shift ;;
    --elevated)
      ELEVATED=1; shift ;;
    --approved-digest)
      [[ $# -ge 2 ]] || { echo "oe-delegate: --approved-digest requires a value" >&2; exit 2; }
      if [[ "$2" == *$'\n'* || "$2" == *$'\r'* ]]; then
        echo "oe-delegate: --approved-digest value must be a single line (no newline)" >&2
        exit 2
      fi
      # フラグが渡されたこと自体を記録（空文字を渡して照合をスキップする迂回を塞ぐ・実装SO D2）。
      APPROVED_DIGEST="$2"; APPROVED_DIGEST_SET=1; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "oe-delegate: unknown option: $1" >&2; usage; exit 2 ;;
  esac
done

TASK="${1:-}"
# 余分な位置引数は黙って捨てず 2 で弾く。task を捨てたまま spawn すると、切り詰められた
# task で子が起動してしまう（クォート忘れが最も危険な形で通る・#309）。
if [[ $# -gt 1 ]]; then
  echo "oe-delegate: unexpected argument: $2（task は1つだけ。複数語はクォートする）" >&2
  usage
  exit 2
fi
# task は --brief があれば省略可。どちらも無ければエラー。
if [[ -z "$TASK" && -z "$BRIEF" ]]; then
  echo "oe-delegate: task argument is required (or pass --brief)" >&2
  usage
  exit 2
fi
# task は 1 行。改行を含むなら spawn 前に弾く（送信は oe_send_line が拒否するため、
# spawn 後に気づくと無キックの孤児ペインが残る。preflight で防ぐ）。
if [[ "$TASK" == *$'\n'* || "$TASK" == *$'\r'* ]]; then
  echo "oe-delegate: task must be a single line (no newline); 長文は --brief <path> で渡す" >&2
  exit 2
fi

# workspace を検証・絶対化する（実装SO D1/D4）。
#   - 制御文字は承認パッケージ（owner 判断のセキュリティ表示）へ偽の「承認ダイジェスト:」行を注入し得る
#     ため fail-fast 拒否（label 等と同方針）。
#   - 相対パスは cwd 依存で、別 cwd から同じ相対 -w が同一 digest になり binding を迂回できる。
#     絶対化して digest / パッケージ / spawn の -c を一致させる（DJ-2 の「workspace 絶対パス」担保）。
if [[ "$WORKSPACE" =~ [[:cntrl:]] ]]; then
  echo "oe-delegate: --workspace value must not contain control characters" >&2
  exit 2
fi
if _ws_abs="$(cd "$WORKSPACE" 2>/dev/null && pwd)"; then
  WORKSPACE="$_ws_abs"
else
  echo "oe-delegate: workspace directory not found: ${WORKSPACE}" >&2
  exit 2
fi

# tmux 内でのみ実行可能（--print-approval は spawn しないため tmux 不要）
PARENT_PANE="${TMUX_PANE:-}"
if [[ -z "$PRINT_APPROVAL" ]]; then
  [[ -n "$PARENT_PANE" ]] || {
    echo "oe-delegate: TMUX_PANE is not set — must run inside a tmux session" >&2
    exit 1
  }
fi

# --brief を絶対パス化し、子（対話型 claude）が読めるよう doc のディレクトリを
# --add-dir で開示する。spawn.sh の envelope は claude -p + --add-dir /tmp で読ませているが、
# こちらは素の対話型 claude のため明示開示が要る（so 指摘）。
BRIEF_ABS=""
if [[ -n "$BRIEF" ]]; then
  [[ -f "$BRIEF" ]] || { echo "oe-delegate: --brief file not found: ${BRIEF}" >&2; exit 2; }
  case "$BRIEF" in
    *\'*) echo "oe-delegate: --brief path must not contain a single quote" >&2; exit 2 ;;
  esac
  # 制御文字は承認パッケージ表示への行/端末制御注入経路（実装SO D4/R2）。単一引用符に加えて拒否する。
  if [[ "$BRIEF" =~ [[:cntrl:]] ]]; then
    echo "oe-delegate: --brief path must not contain control characters" >&2
    exit 2
  fi
  kdir="$(cd "$(dirname "$BRIEF")" && pwd)"
  BRIEF_ABS="${kdir}/$(basename "$BRIEF")"
fi

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

build_child_command() {
  local cmd
  cmd="PARENT_TMUX_PANE=$(shell_quote "$PARENT_PANE") ${AGENT}"
  # 子の lease（#577 DJ-7 の方法1）。作れたときだけ環境に入れる。PARENT_TMUX_PANE と同じく承認の digest には含めない
  # （ID は起こすたびに違う・承認の対象は子が何をするかである）。
  if [[ -n "${LEASE_ID:-}" ]]; then
    cmd="OE_LEASE_ID=$(shell_quote "$LEASE_ID") OE_GENERATION=$(shell_quote "1") ${cmd}"
  fi
  local arg
  # エージェントごとの既定の引数（#562・lib/agent.sh）。claude は空で、1行は今までと同じ（受入 A-1）。
  # codex は --no-daemon・更新の確認を出さない設定・承認の既定・developer の指示。利用者の引数より前に置く。
  # exec は書かない。tmux が bash の -c で起こす最後の単純コマンドは bash が exec で置き換えるので、
  # 前面のプロセスはエージェントになる（claude と codex の両方を実機で確かめた・#562 の C6）。
  while IFS= read -r arg; do
    [[ -n "$arg" ]] || continue
    cmd="${cmd} $(shell_quote "$arg")"
  done < <(oe_agent_default_args "$AGENT" ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"})
  # Codex の子の sandbox に、そのセッションにだけ渡す権限（#562 の H10）。git の書き込み（本体の .git と gitdir）・
  # engine の状態の置き場・tmux のソケットだけを開く。利用者の引数より前に置く。
  if [[ "$AGENT" == "codex" ]]; then
    while IFS= read -r arg; do
      [[ -n "$arg" ]] || continue
      cmd="${cmd} $(shell_quote "$arg")"
    done < <(oe_agent_codex_sandbox_args "$WORKSPACE")
  fi
  # bash 3.2 では set -u 下で空配列の "${arr[@]}" 展開が unbound variable になる
  # （4.4+ は許容）。oe-kick 等が --agent-arg 無しで呼ぶと AGENT_ARGS は空のため、
  # ${arr[@]+"${arr[@]}"} イディオムで空配列を安全に展開する（ADR-005・oe-select 前例）。
  for arg in ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}; do
    cmd="${cmd} $(shell_quote "$arg")"
  done
  if [[ -n "$BRIEF" ]]; then
    # claude の --add-dir は読める範囲、codex の --add-dir は書ける範囲を広げる引数で意味が違うが、
    # 子が brief の置き場（統括の .oe/）を読み、問いと報告を書けるという要る効果は同じ（#562 の DJ-2・C7）。
    cmd="${cmd} --add-dir $(shell_quote "$kdir")"
  fi
  printf '%s\n' "$cmd"
}

# --- #262 spawn 段 owner 承認ハンドシェイク（binding + approval package） ---

# _sha256 — stdin を sha256 し hex を stdout（darwin=shasum / linux=sha256sum）。
_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
  else return 1; fi
}

# _strip_cntrl — 表示用に制御文字を除去（ESC 等での承認表示 spoof を断つ・実装SO R2）。
_strip_cntrl() { printf '%s' "$1" | tr -d '\000-\037\177'; }

# extract_permission_mode — AGENT_ARGS から子の実効 permission mode を推定（audit / パッケージ用）。
#   読み方はエージェントごとに lib/agent.sh が持つ（claude: --permission-mode / --dangerously-skip-permissions、
#   codex: -a / -s / --approve-for-me / bypass・--yolo・-s danger-full-access は bypassPermissions）。
extract_permission_mode() {
  oe_agent_permission_mode "$AGENT" ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}
}

# compute_spawn_digest — 承認対象の正規化ダイジェスト（承認↔実行 binding 用）を stdout。
#   実行される子コマンドの承認面（workspace 絶対パス / label / claude 引数列 / brief 絶対パス
#   + その内容 hash / task / elevated 宣言）。ephemeral な PARENT_TMUX_PANE と注記の --reason は含めない。
#   WORKSPACE は呼び出し前に絶対化済み（相対 -w のクロス cwd 迂回を防ぐ・実装SO D1）。
#   brief は path だけでなく内容 hash も含め、承認後の内容差し替え（TOCTOU）を捕まえる。
compute_spawn_digest() {
  command -v jq >/dev/null 2>&1 || { echo "oe-delegate: jq is required for the approval digest" >&2; return 2; }
  # 引数配列を JSON へ。値が --permission-mode 等の option 形なので jq --args は使わず
  # （jq が option と誤認する）、--argjson で 1 要素ずつ安全に append する。
  local args_json="[]" arg
  for arg in ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}; do
    args_json="$(jq -cn --argjson acc "$args_json" --arg a "$arg" '$acc + [$a]')" || return 1
  done
  local brief_hash=""
  if [[ -n "$BRIEF_ABS" && -f "$BRIEF_ABS" ]]; then
    brief_hash="$(_sha256 < "$BRIEF_ABS")" || return 1
  fi
  # elevated 宣言も束縛する（実装SO R2）。含めないと、非 elevated の承認 digest に後から
  # --elevated を付けて escalation できる（逆に downgrade も）。digest に焼くことで、owner が
  # 見た elevated 宣言と実 spawn の elevated 属性が一致しなければ照合が落ちる。
  local elevated_json; elevated_json="$([[ -n "$ELEVATED" ]] && echo true || echo false)"
  # agent も束縛する（#562）。claude の承認で codex を起こす差し替えを照合で落とす。鍵の名前を claude_args から
  # agent_args に変えたので、更新の前に取った承認は更新のあとは不一致になる（取り直せば済む・安全側）。
  local canon
  canon="$(jq -cn \
    --arg ws "$WORKSPACE" --arg label "$LABEL" --arg brief "$BRIEF_ABS" \
    --arg bh "$brief_hash" --arg task "$TASK" --argjson el "$elevated_json" \
    --arg agent "$AGENT" --argjson ca "$args_json" \
    '{workspace:$ws, label:$label, brief:$brief, brief_content:$bh, task:$task, elevated:$el, agent:$agent, agent_args:$ca}')" || return 1
  printf '%s' "$canon" | _sha256 | cut -c1-16
}

# build_approval_command — owner が承認 / 実行する実 spawn コマンドを正規順で再構成して stdout。
build_approval_command() {
  local d="$1" cmd arg
  cmd="$(shell_quote "${BIN_DIR}/oe-delegate") -w $(shell_quote "$WORKSPACE")"
  [[ -n "$LABEL" ]] && cmd="${cmd} --label $(shell_quote "$LABEL")"
  [[ "$AGENT" != "$OE_AGENT_DEFAULT" ]] && cmd="${cmd} --agent $(shell_quote "$AGENT")"
  for arg in ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}; do
    cmd="${cmd} --agent-arg $(shell_quote "$arg")"
  done
  [[ -n "$BRIEF_ABS" ]] && cmd="${cmd} --brief $(shell_quote "$BRIEF_ABS")"
  [[ -n "$REASON" ]] && cmd="${cmd} --reason $(shell_quote "$REASON")"
  [[ -n "$ELEVATED" ]] && cmd="${cmd} --elevated"
  cmd="${cmd} --approved-digest $(shell_quote "$d")"
  [[ -n "$TASK" ]] && cmd="${cmd} -- $(shell_quote "$TASK")"
  printf '%s' "$cmd"
}

# print_approval_package — spawn せず owner 向け承認パッケージ + ダイジェストを stdout。
#   表示値は _strip_cntrl でサニタイズする（digest は raw 値で計算・表示は無害化）。
#   WORKSPACE / BRIEF は入力段で制御文字を fail-fast 済み。
print_approval_package() {
  local digest pm task_summary is_elev="no" s_label s_task s_reason
  digest="$(compute_spawn_digest)" || { echo "oe-delegate: failed to compute the approval digest" >&2; exit 2; }
  pm="$(extract_permission_mode)"
  { [[ -n "$ELEVATED" ]] || [[ "$pm" == "bypassPermissions" ]]; } && is_elev="yes"
  task_summary="$TASK"
  [[ -n "$task_summary" ]] || task_summary="(brief 参照: ${BRIEF_ABS:-none})"
  s_label="$(_strip_cntrl "${LABEL:-(ラベル無し)}")"
  s_task="$(_strip_cntrl "$task_summary")"
  s_reason="$(_strip_cntrl "${REASON:-(呼び出し側が会話で補足)}")"
  # エージェントの行は claude 以外のときだけ出す（claude の表示は変更前と同じ・受入 A-1・実装SO の指摘1）。
  local agent_line=""
  [[ "$AGENT" != "$OE_AGENT_DEFAULT" ]] && agent_line="  エージェント    : ${AGENT}
"
  cat <<EOF
========================================================================
[spawn 承認要求] elevated な子セッションを起動します。owner の承認をお願いします。
------------------------------------------------------------------------
  対象の子        : ${s_label}
${agent_line}  要求権限モード  : ${pm}
  elevated 宣言   : ${is_elev}
  作業ディレクトリ: ${WORKSPACE}
  brief           : ${BRIEF_ABS:-(なし)}
  タスク          : ${s_task}
  理由            : ${s_reason}
  blast radius    : auto 子は作業ディレクトリ内で権限プロンプトを自動承認しうる。
                    破壊的コマンドは block-destructive hook が引き続き block する
                    （限定的パターンブロッカーであり完全な sandbox ではない）。
  承認ダイジェスト: ${digest}
------------------------------------------------------------------------
承認方法（owner の 1 アクション）: 下記コマンドを承認する / owner が実行する。
実 spawn コマンド（承認内容と実行の一致をダイジェストで束縛）:

  $(build_approval_command "$digest")

注意: auto-mode classifier は実 spawn の段で評価する。この表示は spawn しない
ため block されない。実 spawn は owner ゲートのまま（分類器は迂回しない）。
========================================================================
EOF
}

# --print-approval: spawn せず承認パッケージを印字して終了（enforcement より前＝承認取得のため）。
if [[ -n "$PRINT_APPROVAL" ]]; then
  print_approval_package
  exit 0
fi

# elevated 判定: 明示 --elevated、または権限無効化モード（bypassPermissions）。通常のローカル
# auto 委譲は elevated ではない（owner: 通常委譲は不変）。auto + 本番アクセスは engine から
# 検知できないため呼び出し側が --elevated を宣言する（skill が指示・分類器が二重ゲート）。
PERM_MODE="$(extract_permission_mode)"
IS_ELEVATED=""
{ [[ -n "$ELEVATED" ]] || oe_agent_mode_is_elevated "$PERM_MODE"; } && IS_ELEVATED=1

# codex の子は、報告の送信（oe send）を承認なしで sandbox の外へ出す実行ポリシーの規則に頼る（#562 DJ-3）。
# 規則の無い環境でも起こすが、報告のたびに承認の要求に回ることを1行で知らせる（PR-2 の配布物が無い状態の制限）。
if [[ "$AGENT" == "codex" ]]; then
  _codex_home="${CODEX_HOME:-${HOME:-}/.codex}"
  if [[ ! -f "${_codex_home}/rules/oe-child.rules" ]]; then
    echo "oe-delegate: ${_codex_home}/rules/oe-child.rules が無いので、子の報告の送信（oe send）は承認の要求に回ります（canonical/codex/rules を sync して配ってください）" >&2
  fi
  if [[ -f "${_codex_home}/config.toml" ]] && grep -q '^[[:space:]]*developer_instructions[[:space:]]*=' "${_codex_home}/config.toml" 2>/dev/null; then
    echo "oe-delegate: 利用者の config.toml の developer_instructions は、この子の中では engine の本文に置き換わります（-c の上書き）" >&2
  fi
fi

# elevated spawn は owner 承認済みダイジェストを必須にする（承認を経ず到達する迂回を塞ぐ・実装SO D3）。
if [[ -n "$IS_ELEVATED" && -z "$APPROVED_DIGEST_SET" ]]; then
  echo "oe-delegate: elevated spawn には owner 承認済みダイジェストが必須 — 先に --print-approval で承認を取り、その --approved-digest を渡すこと" >&2
  exit 3
fi

# --approved-digest が渡されたら（空文字でも）必ず照合する（-n で空をスキップさせない・実装SO D2）。
if [[ -n "$APPROVED_DIGEST_SET" ]]; then
  _computed="$(compute_spawn_digest)" || { echo "oe-delegate: failed to compute the approval digest" >&2; exit 2; }
  if [[ "$_computed" != "$APPROVED_DIGEST" ]]; then
    echo "oe-delegate: approved digest mismatch — the spawn command changed since approval (approved=${APPROVED_DIGEST} computed=${_computed}). 再度 --print-approval で承認を取り直すこと。" >&2
    exit 3
  fi
fi

# 子ペインを作成し claude を起動（PARENT_TMUX_PANE を env として渡す）。
# split は親ペイン（$PARENT_PANE = oe-delegate を起動した pane）を -t で明示する。-t を省くと
# tmux はフォーカス中ペインを分割するため、親が別ウィンドウを active にしている間に委譲すると
# 子が無関係なウィンドウに生える（#203）。-d は focus 移動の抑止で、生える「場所」は -t が決める。
# 子の lease を作る（#577 PR-2・registry と両方書く）。親の lease は、親が自分の環境の OE_LEASE_ID か
# 自分の session_id で名乗れたときだけ入れる（名乗れなければ空＝root）。どこで失敗しても委譲は続ける。
LEASE_ID=""; PARENT_LEASE=""
if declare -F oe_lease_create >/dev/null 2>&1 && [[ -n "${OE_LEASE_DIR:-}" ]]; then
  if _pw="$(oe_lease_whoami 2>/dev/null)" && [[ "$(printf '%s' "$_pw" | jq -r '.state' 2>/dev/null)" == "active" ]]; then
    PARENT_LEASE="$(printf '%s' "$_pw" | jq -r '"\(.lease_id):\(.generation)"' 2>/dev/null)" || PARENT_LEASE=""
  fi
  LEASE_ID="$(oe_lease_create delegation "$LABEL" "$WORKSPACE" "${PARENT_LEASE%%:*}" 1 "$AGENT" 2>/dev/null)" || LEASE_ID=""
  [[ -n "$LEASE_ID" ]] || echo "oe-delegate: lease を作れませんでした（registry だけで続けます）" >&2
fi

CHILD_COMMAND="$(build_child_command)"
CHILD_PANE="$(tmux split-window -d -P -F "#{pane_id}" -t "$PARENT_PANE" -c "$WORKSPACE" "$CHILD_COMMAND")"
echo "oe-delegate: child pane ${CHILD_PANE} started (parent: ${PARENT_PANE}, workspace: ${WORKSPACE})" >&2

# 起動待ち
WAIT_SEC="${OE_DELEGATE_WAIT_SEC:-4}"
sleep "$WAIT_SEC"

# 子ペインの生存確認（-x で完全一致。%1 が %12 に部分一致する誤検知を防ぐ）
tmux list-panes -a -F "#{pane_id}" | grep -qxF "$CHILD_PANE" || {
  echo "oe-delegate: child pane $CHILD_PANE exited during startup" >&2
  exit 1
}

# Codex のフォルダの信頼の確認（#562・owner の答え Q113）。Codex は新しい workspace（worktree ごと）を初めて開くとき
# 「Trust this folder?」の確認を出し、そこへ最初の1行を送ると Enter が選択肢に入る。engine は、workspace のもとの
# リポジトリ（main の作業ツリー）を owner が Codex で信頼済み（$CODEX_HOME/config.toml の [projects."<path>"] に
# trust_level = "trusted"）のときだけ Enter を1回送って進める。config.toml は読むだけで書き換えない。信頼されて
# いないとき・画面を読めないときは、Enter も最初の1行も送らずに止まり、案内を出す（ペインは残す・exit 4）。
if [[ "$AGENT" == "codex" ]]; then
  _cap=""
  if ! _cap="$(tmux capture-pane -p -t "$CHILD_PANE" 2>/dev/null)"; then
    echo "oe-delegate: 子のペイン ${CHILD_PANE} の画面を読めないので、最初の1行を送らずに止めます。画面を見て、フォルダの信頼の確認が出ていなければ oe send ${CHILD_PANE} で1行を送ってください" >&2
    exit 4
  fi
  if printf '%s\n' "$_cap" | grep -qF -- "$OE_AGENT_CODEX_TRUST_PROMPT"; then
    _main="$(oe_agent_codex_main_worktree "$WORKSPACE" 2>/dev/null)" || _main=""
    _trc=1
    if [[ -n "$_main" ]]; then oe_agent_codex_trusted "$_main" && _trc=0 || _trc=$?; fi
    if [[ "$_trc" -eq 0 ]]; then
      tmux send-keys -t "$CHILD_PANE" Enter
      echo "oe-delegate: フォルダの信頼の確認に Enter を送りました（もとのリポジトリ ${_main} は owner が信頼済み・config.toml は書き換えていません）" >&2
      sleep "${OE_DELEGATE_TRUST_WAIT_SEC:-2}"
      if _cap2="$(tmux capture-pane -p -t "$CHILD_PANE" 2>/dev/null)" && printf '%s\n' "$_cap2" | grep -qF -- "$OE_AGENT_CODEX_TRUST_PROMPT"; then
        echo "oe-delegate: 確認の画面が消えないので、最初の1行を送らずに止めます。子のペイン ${CHILD_PANE} を見てください" >&2
        exit 4
      fi
    else
      case "$_trc" in
        2) _why="config.toml（${CODEX_HOME:-${HOME:-}/.codex}/config.toml）を読めない" ;;
        *) _why="もとのリポジトリ ${_main:-（git でない）} が owner の Codex で信頼されていない" ;;
      esac
      echo "oe-delegate: 子のペイン ${CHILD_PANE} にフォルダの信頼の確認が出ています。${_why}ので、engine は Enter を送りません。owner が子のペインで答えてから、oe send ${CHILD_PANE} で1行を送ってください（最初の1行は送っていません）" >&2
      exit 4
    fi
  fi
fi

# spawn レジストリに登録（親スコープ + ゼロベース期の仮ラベル保持）。best-effort。
oe_reg_record "$CHILD_PANE" "$LABEL" "$WORKSPACE" "$PARENT_PANE" "$AGENT" || true

# 子の lease の最初の binding を書く（#577 DJ-18）。起動を確かめたいま、子のペインの端末のフォアグラウンドの
# プロセスを読み、コマンド名が許す名前の集合（claude・codex）にあるときだけ書く。確かめられなければ binding は
# 未確定のまま残し、委譲は続ける（子は報告のときの oe-lease の verb で自分を登録できる）。
CHILD_LEASE=""
if [[ -n "$LEASE_ID" ]] && declare -F oe_tpi_pane_foreground >/dev/null 2>&1; then
  if _fg="$(oe_tpi_pane_foreground "$CHILD_PANE" 2>/dev/null)"; then
    _fpid="${_fg%%"$_OE_TPI_TAB"*}"; _fst="${_fg#*"$_OE_TPI_TAB"}"
    _fcomm="$(oe_tpi_proc_comm "$_fpid" 2>/dev/null)" || _fcomm=""
    if oe_lease_bind "$LEASE_ID" 0 "$_fpid" "$_fst" "$_fcomm" 2>/dev/null; then
      CHILD_LEASE="${LEASE_ID}:1"
      if declare -F oe_event_lease_bound >/dev/null 2>&1; then
        oe_event_lease_bound "$CHILD_PANE" "$LEASE_ID" 1 spawn "$LABEL" || true
      fi
    else
      echo "oe-delegate: 子の lease ${LEASE_ID} に binding を書けませんでした（フォアグラウンドのプロセスが ${OE_AGENT_COMMS// /・} でない・${_fcomm:-不明}）。binding は未確定のままです" >&2
    fi
  else
    echo "oe-delegate: 子のペイン ${CHILD_PANE} のフォアグラウンドのプロセスを確かめられません。lease ${LEASE_ID} の binding は未確定のままです" >&2
  fi
  [[ -n "$CHILD_LEASE" ]] || CHILD_LEASE="${LEASE_ID}:1"
  # 拍動の床（#562 DJ-6）: hook と statusLine に依らず、lease の名前で sidecar を1件書く。lib/heartbeat-resolve.sh は
  # lease_id と generation の一致で候補のペインを選ぶので、子の session_id を知らなくても lease からペインを引ける。
  # 書けなくても委譲は続ける（拍動は装飾で、ペインを引く確かめは前面のプロセスが担う）。
  if declare -F oe_hb_write_floor >/dev/null 2>&1; then
    oe_hb_write_floor "$LEASE_ID" "$CHILD_PANE" "$LEASE_ID" 1 "$AGENT" || true
  fi
fi

# 活動ログに child_spawned を best-effort emit（registry 登録後 ＝ 親 label 解決可）。本体は壊さない。
# permission_mode + elevated を焼き込み、elevated spawn を通常 spawn と事後区別できるようにする
# （#262・audit・実装SO D5＝auto でも elevated 宣言の有無で区別可能に）。
if declare -F oe_event_child_spawned >/dev/null 2>&1; then
  oe_event_child_spawned "$PARENT_PANE" "$CHILD_PANE" "$LABEL" "$PERM_MODE" "${IS_ELEVATED:+true}" "$CHILD_LEASE" "$PARENT_LEASE" || true
fi

# キックを oe-send で注入する。delegate は report を内包しない（戻しは子が oe-send で行う）。
SEND_ARGS=()
if [[ -n "$BRIEF_ABS" ]]; then SEND_ARGS+=(--brief "$BRIEF_ABS"); fi
SEND_ARGS+=(-- "$CHILD_PANE")
if [[ -n "$TASK" ]]; then SEND_ARGS+=("$TASK"); fi
"${BIN_DIR}/oe-send" "${SEND_ARGS[@]}"

echo "oe-delegate: task injected to ${CHILD_PANE}" >&2
