#!/usr/bin/env bash
# oe-handoff — 統括の計画的な交代（前任が応答できる場合）の verb（#390）
#
# 交代は4工程で、走るセッションが違う。
#   prepare  前任のセッション。機械で取れる状態を引き継ぎ文書へ書く（他は何も書き換えない）
#   start    前任のセッション。後継のペインを起こして引き継ぎ文書のパスを送る（PR-2）
#   take     後継のセッション。席を取りに行く（PR-2）
#   retire   後継のセッション。前任を閉じてよいかを判定し、通れば閉じる（PR-3）
#
# 応答しない前任からの復帰は本 verb の担当ではない（#355 の別 verb）。分かれ目は前任が
# 自分の状態を申告できるかどうかの1点である。
#
# usage:
#   oe-handoff prepare [-w <workspace>] [--out <path>] [--predecessor <%pane>]
#   oe-handoff -h | --help
#
# exit: 0 正常 / 2 呼び方の誤り・前提コマンドの不在

set -uo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/handoff-state.sh
source "${BIN_DIR}/../lib/handoff-state.sh"

TEMPLATE="${BIN_DIR}/../templates/handoff.md.template"
MARK_BEGIN='<!-- oe-handoff:machine:begin -->'
MARK_END='<!-- oe-handoff:machine:end -->'

err() { printf '%s\n' "oe-handoff: $*" >&2; }

usage() {
  cat <<'EOF'
usage:
  oe-handoff prepare [-w <workspace>] [--out <path>] [--predecessor <%pane>]

  prepare — 前任のセッションで走らせる。機械で取れる状態を引き継ぎ文書へ書き出し、
            人が書く節は空枠のまま残す。引き継ぎ文書以外は何も書き換えない。

  -w <workspace>      作業ディレクトリ（既定: git のトップレベル、無ければ cwd）
  --out <path>        引き継ぎ文書の置き場（既定: <workspace>/.oe/handoff.md）
  --predecessor <%N>  前任のペイン（既定: $TMUX_PANE）

  環境変数:
    OE_HANDOFF_FILE       --out の既定を上書きする
    OE_DELEGATE_STATE_DIR 登記の置き場
    OE_HEARTBEAT_DIR      拍動 sidecar の置き場
EOF
}

# --- 引数 ---
SUB="${1:-}"
case "$SUB" in
  -h|--help) usage; exit 0 ;;
  prepare)   shift ;;
  "")        err "subcommand がありません"; usage >&2; exit 2 ;;
  *)         err "未知の subcommand: ${SUB}"; usage >&2; exit 2 ;;
esac

WORKSPACE=""
OUT=""
PREDECESSOR=""
while [ $# -gt 0 ]; do
  case "$1" in
    -w)            WORKSPACE="${2:-}"; shift 2 || { err "-w に値がありません"; exit 2; } ;;
    --out)         OUT="${2:-}"; shift 2 || { err "--out に値がありません"; exit 2; } ;;
    --predecessor) PREDECESSOR="${2:-}"; shift 2 || { err "--predecessor に値がありません"; exit 2; } ;;
    -h|--help)     usage; exit 0 ;;
    *)             err "未知の引数: $1"; usage >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { err "jq が要ります"; exit 2; }

if [ -z "$WORKSPACE" ]; then
  WORKSPACE="$(git rev-parse --show-toplevel 2>/dev/null)" || WORKSPACE=""
  [ -n "$WORKSPACE" ] || WORKSPACE="$PWD"
fi
[ -d "$WORKSPACE" ] || { err "workspace がありません: ${WORKSPACE}"; exit 2; }

[ -n "$OUT" ] || OUT="${OE_HANDOFF_FILE:-${WORKSPACE}/.oe/handoff.md}"
[ -n "$PREDECESSOR" ] || PREDECESSOR="${TMUX_PANE:-}"
if [ -z "$PREDECESSOR" ]; then
  err "前任のペインが決まりません（tmux の外なら --predecessor で渡してください）"
  exit 2
fi
[ -f "$TEMPLATE" ] || { err "テンプレートがありません: ${TEMPLATE}"; exit 2; }

# --- 状態を集める（read-only） ---
SPID="$(oe_hs_server_pid)"
SID="$(oe_hs_session_for_pane "$PREDECESSOR")"
CTX="$(oe_hs_context_for_session "$SID")"
BEAT_AGE="$(oe_hs_beat_age_for_pane "$PREDECESSOR")"
# 子を数えられなかったとき（jq 不在・登記の置き場が決まらない）を 0 件に化かさない。
# 0 は「居ない」、unknown は「分からない」で、後段の停止の可否が逆になる。
CHILDREN="$(oe_hs_children_of "$PREDECESSOR")"; CHILD_RC=$?
if [ "$CHILD_RC" -ne 0 ]; then
  CHILD_COUNT="unknown"
  CHILDREN=""
elif [ -z "$CHILDREN" ]; then
  CHILD_COUNT=0
else
  CHILD_COUNT="$(printf '%s\n' "$CHILDREN" | grep -c '^' | tr -d ' ')"
fi
WATCHDOGS="$(oe_hs_watchdogs)"
REPO="$(oe_hs_repo_state "$WORKSPACE")"
PRS="$(oe_hs_open_prs "$WORKSPACE")"
WORKTREES="$(git -C "$WORKSPACE" worktree list 2>/dev/null)" || WORKTREES="unknown"
NOW="$(date '+%Y-%m-%d %H:%M %Z')"

indent_or_none() { # <text> <空のときの文言>
  if [ -z "$1" ]; then printf -- '- %s\n' "$2"; else printf '%s\n' "$1" | sed 's/^/- /'; fi
}

# shellcheck disable=SC2016  # backticks は Markdown のインラインコードで、展開させない
MACHINE="$(
  printf '%s\n' "$MARK_BEGIN"
  printf '%s\n' '## 観測できる状態（機械が書く・毎回上書き・手で直さない）'
  printf '\n'
  printf -- '- 生成時刻: %s\n' "$NOW"
  printf -- '- 前任のペイン: `%s`（tmux server pid `%s`）\n' "$PREDECESSOR" "${SPID:-unknown}"
  printf -- '- 前任の session_id: `%s`\n' "$SID"
  printf -- '- 前任の context%%: %s\n' "$CTX"
  printf -- '- 前任の拍動の古さ: %s 秒前\n' "$BEAT_AGE"
  printf '\n'
  if [ "$SID" = "unknown" ]; then
    printf '%s\n' '**session_id が引けていない。** pane から逆引きできる sidecar がちょうど1件に'
    printf '%s\n' '絞れなかった（0 件か、同じ pane 番号の別世代が複数ある）。**この状態では前任を'
    printf '%s\n' '停止できない**（`claude --resume` で開き直せなくなるため・`retire` が止める）。'
    printf '\n'
  fi
  printf '%s\n' '### 生きている委譲子'
  printf '\n'
  printf -- '- 件数: %s\n' "$CHILD_COUNT"
  if [ "$CHILD_COUNT" = "unknown" ]; then
    printf -- '- 数えられませんでした（登記の置き場が決まらないか jq がありません）\n'
  else
    indent_or_none "$CHILDREN" "なし"
  fi
  printf '\n'
  if [ "$CHILD_COUNT" != "0" ]; then
    printf '%s\n' '**生きた委譲子が居ない、と言える状態ではない。席は動かせない**（`take` が止める）。'
    printf '%s\n' '子の報告先は起動時に前任のペインへ焼き込まれていて、あとから張り替えられない。'
    printf '%s\n' '数えられなかった場合も同じ扱いにする（「分からない」を「居ない」に畳まない）。'
    printf '\n'
  fi
  printf '%s\n' '### open PR'
  printf '\n'
  indent_or_none "$PRS" "なし"
  printf '\n'
  printf '%s\n' '### worktree'
  printf '\n'
  indent_or_none "$WORKTREES" "unknown"
  printf '\n'
  printf '%s\n' '### repo'
  printf '\n'
  indent_or_none "$REPO" "unknown"
  printf '\n'
  printf '%s\n' '### 常駐の見張り'
  printf '\n'
  indent_or_none "$WATCHDOGS" "unknown"
  printf '%s\n' "$MARK_END"
)"

# --- 書き出し（引き継ぎ文書だけを書く） ---
mkdir -p "$(dirname "$OUT")" 2>/dev/null || { err "置き場を作れません: $(dirname "$OUT")"; exit 2; }
if [ ! -f "$OUT" ]; then
  # 引き継ぎ文書は「会話にしか無かったもの」を載せる。umask 任せにせず最初から絞る。
  if ! ( umask 077; cp "$TEMPLATE" "$OUT" ); then err "テンプレートを置けません: ${OUT}"; exit 2; fi
  CREATED=1
else
  CREATED=0
fi

# 目印は「在るか」だけでなく「1組だけか」「順序が正しいか」まで見る。
# 見ないと、end が begin より前にある文書で awk が begin 以降を末尾まで捨てて上書きし、
# **人が書いた節を復元できない形で壊す**。書き換える前に落とす。
# **検査と置換で同じ規則を使う。** 検査が「行のどこかに在る」で、置換が「行頭に在る」だと、
# 目印に空白が1つ付いただけで検査を通過し、awk が終わりを見つけられず人が書いた節を
# 末尾まで消す。どちらも「その行が目印そのものである」に揃える。
N_BEGIN="$(grep -cxF -- "$MARK_BEGIN" "$OUT" | tr -d ' ')"
N_END="$(grep -cxF -- "$MARK_END" "$OUT" | tr -d ' ')"
if [ "$N_BEGIN" != "1" ] || [ "$N_END" != "1" ]; then
  err "機械の節の目印が1組になっていません（${OUT}・begin ${N_BEGIN} 個 / end ${N_END} 個）。手で直してください"
  exit 2
fi
L_BEGIN="$(grep -nxF -- "$MARK_BEGIN" "$OUT" | head -1 | cut -d: -f1)"
L_END="$(grep -nxF -- "$MARK_END" "$OUT" | head -1 | cut -d: -f1)"
if [ -z "$L_BEGIN" ] || [ -z "$L_END" ] || [ "$L_BEGIN" -ge "$L_END" ]; then
  err "機械の節の目印の順序が逆です（${OUT}・begin ${L_BEGIN} 行目 / end ${L_END} 行目）。手で直してください"
  exit 2
fi

TMP="${OUT}.tmp.$$"
MACHINE_FILE="${OUT}.machine.$$"
# 途中で落ちても一時ファイルを残さない（中身は引き継ぎ文書の全文なので、置き去りは漏洩でもある）。
trap 'rm -f "$TMP" "$MACHINE_FILE" 2>/dev/null' EXIT HUP INT TERM
# 書込みの成否を見る。見ないと、書けていない staging を awk が読んで
# **機械の節が空の文書を本物に被せる**。
if ! ( umask 077; printf '%s\n' "$MACHINE" >"$MACHINE_FILE" ); then
  err "機械の節を書き出せませんでした: ${MACHINE_FILE}"
  exit 2
fi
( umask 077; : >"$TMP" ) || { err "一時ファイルを作れません: ${TMP}"; exit 2; }
awk -v b="$MARK_BEGIN" -v e="$MARK_END" -v mf="$MACHINE_FILE" '
  $0 == b { while ((getline line < mf) > 0) print line; close(mf); skip = 1; next }
  $0 == e { skip = 0; next }
  skip != 1 { print }
' "$OUT" >"$TMP"; awk_rc=$?
# 書いている最中も緩めない（全文が入るので、途中の一時ファイルも読まれてはいけない）。
chmod 600 "$TMP" 2>/dev/null || true
[ "$awk_rc" -eq 0 ] || { err "機械の節を差し替えられませんでした"; exit 2; }
# mv は tmp の権限を持ち込むので、元の文書の権限に揃える（umask で 0600 が 0644 に緩まない）。
chmod --reference="$OUT" "$TMP" 2>/dev/null \
  || chmod "$(stat -f %Lp "$OUT" 2>/dev/null || printf '644')" "$TMP" 2>/dev/null || true
mv -f "$TMP" "$OUT" || { err "書き戻せませんでした: ${OUT}"; exit 2; }
rm -f "$MACHINE_FILE"

# --- 表示 ---
printf '=== oe-handoff prepare ===\n'
if [ "$CREATED" -eq 1 ]; then
  printf '引き継ぎ文書を作りました: %s\n' "$OUT"
else
  printf '引き継ぎ文書の機械の節を書き直しました: %s\n' "$OUT"
fi
printf '前任 %s / session_id %s / context%% %s / 生きた委譲子 %s 件\n' \
  "$PREDECESSOR" "$SID" "$CTX" "$CHILD_COUNT"
printf '\n'
printf '次にやること:\n'
printf '  1. %s の「人が書く」節を埋める（機械の節は触らない）\n' "$OUT"
printf '     とくに「渡らないもの」と自己申告の残余は、ここでしか書けません。\n'
if [ "$CHILD_COUNT" = "unknown" ]; then
  printf '  2. **まだ交代できません。** 生きた委譲子を数えられませんでした。数えられないうちは席を動かせません。\n'
elif [ "$CHILD_COUNT" != "0" ]; then
  printf '  2. **まだ交代できません。** 生きた委譲子 %s 件が片づくまで席は動かせません。\n' "$CHILD_COUNT"
elif [ "$SID" = "unknown" ]; then
  # 子のゲートと対称にする。ここで「次は start」と言うと、retire が止める状態なのに
  # 「交代の準備ができた」と読める（片方だけ fail-open になる）。
  printf '  2. **まだ交代できません。** 前任の session_id が引けていないので、停止が取り消せません。\n'
  printf '     拍動と transcript のどちらか（または両方）が、いまの前任のものだと言える状態にありません。\n'
else
  printf '  2. oe-handoff start で後継のペインを起こす（PR-2 で実装）\n'
fi
exit 0
