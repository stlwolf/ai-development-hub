#!/usr/bin/env bash
# oe-handoff — 統括の計画的な交代（前任が応答できる場合）の verb（#390）
#
# 交代は4工程で、走るセッションが違う。
#   prepare  前任のセッション。機械で取れる状態を引き継ぎ文書へ書く（他は何も書き換えない）
#   start    前任のセッション。後継のペインを起こして引き継ぎ文書のパスを送る（PR-2）
#   take     後継のセッション。席を取りに行く（PR-2）
#   retire   後継のセッション。前任を閉じてよいかを判定し、`--execute` で閉じる
#
# 応答しない前任からの復帰は本 verb の担当ではない（#355 の別 verb）。分かれ目は前任が
# 自分の状態を申告できるかどうかの1点である。
#
# usage:
#   oe-handoff prepare [-w <workspace>] [--out <path>] [--predecessor <%pane>]
#   oe-handoff start   [-w <workspace>] [--handoff <path>] [--dry-run]
#   oe-handoff take    [-w <workspace>] [--board <path>] [--handoff <path>]
#                      [--generation <N>] [--predecessor <%pane>] [--reason <r>]
#   oe-handoff retire  [-w <workspace>] [--board <path>] [--handoff <path>] [--execute]
#   oe-handoff -h | --help
#
# exit: 0 正常 / 1 前提を満たさないので席を動かさなかった / 2 呼び方の誤り・前提コマンドの不在

set -uo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/handoff-state.sh
source "${BIN_DIR}/../lib/handoff-state.sh"
# shellcheck source=../lib/seat.sh
source "${BIN_DIR}/../lib/seat.sh"
# shellcheck source=../lib/event-bus.sh
source "${BIN_DIR}/../lib/event-bus.sh" || true

# 外部 verb の実体。テストで差し替えられるようにしておく（実物の登記や席に触れないため）。
OE_HANDOFF_REGISTER="${OE_HANDOFF_REGISTER:-${BIN_DIR}/oe-register}"
OE_HANDOFF_SELFCHECK="${OE_HANDOFF_SELFCHECK:-${BIN_DIR}/oe-selfcheck}"
OE_HANDOFF_SEND="${OE_HANDOFF_SEND:-${BIN_DIR}/oe-send}"
OE_HANDOFF_TMUX="${OE_HANDOFF_TMUX:-tmux}"
OE_HANDOFF_CLAUDE="${OE_HANDOFF_CLAUDE:-claude}"

TEMPLATE="${BIN_DIR}/../templates/handoff.md.template"
MARK_BEGIN='<!-- oe-handoff:machine:begin -->'
MARK_END='<!-- oe-handoff:machine:end -->'

err() { printf '%s\n' "oe-handoff: $*" >&2; }

usage() {
  cat <<'EOF'
usage:
  oe-handoff prepare [-w <workspace>] [--out <path>] [--predecessor <%pane>]
  oe-handoff start   [-w <workspace>] [--handoff <path>] [--dry-run]
  oe-handoff take    [-w <workspace>] [--board <path>] [--handoff <path>]
                     [--generation <N>] [--predecessor <%pane>] [--reason <r>]
  oe-handoff retire  [-w <workspace>] [--board <path>] [--handoff <path>] [--execute]

  prepare — 前任のセッションで走らせる。機械で取れる状態を引き継ぎ文書へ書き出し、
            人が書く節は空枠のまま残す。引き継ぎ文書以外は何も書き換えない。
  start   — 前任のセッションで走らせる。後継のペインを起こして引き継ぎ文書のパスを送る。
            起こすペインは**登記の子にしない**（PARENT_TMUX_PANE も渡さない）。
  take    — 後継のセッションで走らせる。前提を全部確かめてから席を取りに行く。
            確かめるものが先、書き換えるものが後。何度実行しても同じ結果になる。
  retire  — 後継のセッションで走らせる。機械の検査をやり直して前任の申告と突き合わせ、
            停止してよいかを判定する。**引数なしは下見で、何も停止しない。**
            `--execute` は**検査をやり直してから**前任のペインだけを閉じる。

  -w <workspace>      作業ディレクトリ（既定: git のトップレベル、無ければ cwd）
  --out <path>        prepare: 引き継ぎ文書の置き場（既定: <workspace>/.oe/handoff.md）
  --handoff <path>    start/take: 引き継ぎ文書の場所（既定は上と同じ）
  --board <path>      take: board の場所（既定: $OE_BOARD_FILE）
  --generation <N>    take: 後継が何代目か（省略時は board から読もうとする）
  --predecessor <%N>  前任のペイン（prepare の既定は $TMUX_PANE / take の既定は board の宣言）
  --reason <r>        take: 交代の理由（context_exhaustion / planned / unspecified）
  --dry-run           start: 起こさずに、やることを表示するだけ
  --execute           retire: 検査をやり直してから前任のペインを閉じる（打つのは後継）

  環境変数:
    OE_HANDOFF_FILE       引き継ぎ文書の既定を上書きする
    OE_BOARD_FILE         board の既定
    OE_DELEGATE_STATE_DIR 登記の置き場
    OE_HEARTBEAT_DIR      拍動 sidecar の置き場
    OE_EVENT_DIR          活動ログの置き場
EOF
}

# --- 引数 ---
SUB="${1:-}"
case "$SUB" in
  -h|--help)               usage; exit 0 ;;
  prepare|start|take|retire) shift ;;
  "")                      err "subcommand がありません"; usage >&2; exit 2 ;;
  *)                       err "未知の subcommand: ${SUB}"; usage >&2; exit 2 ;;
esac

WORKSPACE=""
OUT=""
PREDECESSOR=""
BOARD=""
HANDOFF=""
GENERATION=""
REASON="unspecified"
DRY_RUN=0
EXECUTE=0
RETIRE_PRED=""
RETIRE_SID=""
# 機械の節の本体（段階2 が pid を読む。**文書全体から拾わない**）
RETIRE_MACHINE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -w)            WORKSPACE="${2:-}"; shift 2 || { err "-w に値がありません"; exit 2; } ;;
    --out)         OUT="${2:-}"; shift 2 || { err "--out に値がありません"; exit 2; } ;;
    --handoff)     HANDOFF="${2:-}"; shift 2 || { err "--handoff に値がありません"; exit 2; } ;;
    --board)       BOARD="${2:-}"; shift 2 || { err "--board に値がありません"; exit 2; } ;;
    --generation)  GENERATION="${2:-}"; shift 2 || { err "--generation に値がありません"; exit 2; } ;;
    --reason)      REASON="${2:-}"; shift 2 || { err "--reason に値がありません"; exit 2; } ;;
    --predecessor) PREDECESSOR="${2:-}"; shift 2 || { err "--predecessor に値がありません"; exit 2; } ;;
    --dry-run)     DRY_RUN=1; shift ;;
    --execute)     EXECUTE=1; shift ;;
    -h|--help)     usage; exit 0 ;;
    *)             err "未知の引数: $1"; usage >&2; exit 2 ;;
  esac
done

if [ -n "$GENERATION" ]; then
  # 世代を検証せずに通すと、board には「統括abc代目」と書いたうえでイベント側だけが
  # 値を畳んで記録を省く、という部分更新の不整合ができる。呼び方の誤りとして止める。
  case "$GENERATION" in
    ''|*[!0-9]*) err "--generation は正の整数です: ${GENERATION}"; exit 2 ;;
    0)           err "--generation は 1 以上です"; exit 2 ;;
  esac
fi
case "$REASON" in
  context_exhaustion|planned|unspecified) ;;
  *) err "--reason は context_exhaustion / planned / unspecified のいずれかです: ${REASON}"; exit 2 ;;
esac

command -v jq >/dev/null 2>&1 || { err "jq が要ります"; exit 2; }

if [ -z "$WORKSPACE" ]; then
  WORKSPACE="$(git rev-parse --show-toplevel 2>/dev/null)" || WORKSPACE=""
  [ -n "$WORKSPACE" ] || WORKSPACE="$PWD"
fi
[ -d "$WORKSPACE" ] || { err "workspace がありません: ${WORKSPACE}"; exit 2; }

cmd_prepare() {
  [ -n "$OUT" ] || OUT="${OE_HANDOFF_FILE:-${WORKSPACE}/.oe/handoff.md}"
  [ -n "$PREDECESSOR" ] || PREDECESSOR="${TMUX_PANE:-}"
  if [ -z "$PREDECESSOR" ]; then
    err "前任のペインが決まりません（tmux の外なら --predecessor で渡してください）"
    exit 2
  fi
  [ -f "$TEMPLATE" ] || { err "テンプレートがありません: ${TEMPLATE}"; exit 2; }

  # --- 状態を集める（read-only） ---
  SPID="$(oe_hs_server_pid)"
  SID="$(oe_hs_session_for_pane "$PREDECESSOR")"
  # 逆引きが unknown になった理由は lib が持っている。**実装を写した説明を手で書かない**
  # （書くと、実装を変えたときに文書だけ古いまま残る）。
  oe_hs_session_for_pane "$PREDECESSOR" >/dev/null
  SID_REASON="$OE_HS_SESSION_REASON"
  CTX="$(oe_hs_context_for_session "$SID")"
  BEAT_AGE="$(oe_hs_beat_age_for_pane "$PREDECESSOR")"
  # 子を数えられなかったとき（jq 不在・登記の置き場が決まらない）を 0 件に化かさない。
  # 0 は「居ない」、unknown は「分からない」で、後段の停止の可否が逆になる。
  CHILDREN="$(oe_hs_children_of "$PREDECESSOR")"; CHILD_RC=$?
  # ペインの pid。引けなければ空にする（**空を「一致した」に畳まないのは retire の側の責任**）。
  PRED_PID="$(oe_hs_pane_pid "$PREDECESSOR")" || PRED_PID=""
  if [ "$CHILD_RC" -ne 0 ]; then
    CHILD_COUNT="unknown"
    CHILDREN=""
  elif [ -z "$CHILDREN" ]; then
    CHILD_COUNT=0
  else
    CHILD_COUNT="$(printf '%s\n' "$CHILDREN" | grep -c '^' | tr -d ' ')"
  fi
  WATCHDOGS="$(oe_hs_watchdogs)"
  REPO="$(oe_hs_repo_state "$WORKSPACE")"
  PRS="$(oe_hs_open_prs "$WORKSPACE")"
  WORKTREES="$(git -C "$WORKSPACE" worktree list 2>/dev/null)" || WORKTREES="unknown"
  NOW="$(date '+%Y-%m-%d %H:%M %Z')"

  indent_or_none() { # <text> <空のときの文言>
    if [ -z "$1" ]; then printf -- '- %s\n' "$2"; else printf '%s\n' "$1" | sed 's/^/- /'; fi
  }

  # shellcheck disable=SC2016  # backticks は Markdown のインラインコードで、展開させない
  MACHINE="$(
    printf '%s\n' "$MARK_BEGIN"
    printf '%s\n' '## 観測できる状態（機械が書く・毎回上書き・手で直さない）'
    printf '\n'
    printf -- '- 生成時刻: %s\n' "$NOW"
    printf -- '- 前任のペイン: `%s`（tmux server pid `%s`）\n' "$PREDECESSOR" "${SPID:-unknown}"
    printf -- '- 前任の session_id: `%s`\n' "$SID"
    printf -- '- 前任の context%%: %s\n' "$CTX"
    # **停止の直前にペインの同一性を確かめるための鍵。** 拍動に依らない（再利用直後の窓を塞ぐ）。
    if [ -n "$PRED_PID" ]; then
      printf -- '- 前任のペインの pid: `%s`\n' "$PRED_PID"
    else
      printf -- '- 前任のペインの pid: 取れなかった（`retire` は停止しない）\n'
    fi
    if [ "$BEAT_AGE" = "unknown" ]; then
      printf -- '- 前任の拍動の古さ: 取れなかった\n'
    else
      printf -- '- 前任の拍動の古さ: %s 秒前\n' "$BEAT_AGE"
    fi
    printf '\n'
    if [ "$SID" = "unknown" ]; then
      printf '%s\n' '**session_id が引けていない。** 理由は次のとおりである。'
      printf '\n'
      printf -- '- %s\n' "${SID_REASON:-理由を取れなかった}"
      printf '\n'
      printf '%s\n' '**この状態では前任を停止できない**（`claude --resume` で開き直せなくなるため・'
      printf '%s\n' '`retire` が止める）。'
      printf '\n'
    fi
    printf '%s\n' '### 生きている委譲子'
    printf '\n'
    printf -- '- 件数: %s\n' "$CHILD_COUNT"
    if [ "$CHILD_COUNT" = "unknown" ]; then
      printf -- '- **数えられませんでした。0 件ではありません**（登記を読み切れていない）\n'
    else
      indent_or_none "$CHILDREN" "なし"
    fi
    printf '\n'
    if [ "$CHILD_COUNT" != "0" ]; then
      printf '%s\n' '**この子は後継がまるごと引き受ける。交代は止まらない**（owner 裁定 2026-09-13）。'
      printf '%s\n' 'supervision はリクエストとレスポンスで回るので、後継が指示を送れば子は送ってきた相手に返す。'
      printf '%s\n' '**残る穴は、誰にも聞かれずに子が自分から報告を出す経路だけ**である（`PARENT_TMUX_PANE` が'
      printf '%s\n' '前任を指したまま残る）。**後継は上の一覧の各子へ、報告の宛先が自分になったことを明示して伝えること。**'
      printf '%s\n' '挨拶では塞がらない。`oe-report` は `PARENT_TMUX_PANE` を先に読み、`oe-delegate` は差し替えの口を'
      printf '%s\n' '書き出さないので、**宛先が変わるのは子が新しい pane を明示して送るときだけ**である。'
      printf '\n'
    fi
    printf '%s\n' '### open PR'
    printf '\n'
    indent_or_none "$PRS" "なし"
    printf '\n'
    printf '%s\n' '### worktree'
    printf '\n'
    indent_or_none "$WORKTREES" "unknown"
    printf '\n'
    printf '%s\n' '### repo'
    printf '\n'
    indent_or_none "$REPO" "unknown"
    printf '\n'
    printf '%s\n' '### 常駐の見張り'
    printf '\n'
    indent_or_none "$WATCHDOGS" "unknown"
    printf '%s\n' "$MARK_END"
  )"

  # --- 書き出し（引き継ぎ文書だけを書く） ---
  mkdir -p "$(dirname "$OUT")" 2>/dev/null || { err "置き場を作れません: $(dirname "$OUT")"; exit 2; }
  if [ ! -f "$OUT" ]; then
    # 引き継ぎ文書は「会話にしか無かったもの」を載せる。umask 任せにせず最初から絞る。
    if ! ( umask 077; cp "$TEMPLATE" "$OUT" ); then err "テンプレートを置けません: ${OUT}"; exit 2; fi
    CREATED=1
  else
    CREATED=0
  fi

  # 目印は「在るか」だけでなく「1組だけか」「順序が正しいか」まで見る。
  # 見ないと、end が begin より前にある文書で awk が begin 以降を末尾まで捨てて上書きし、
  # **人が書いた節を復元できない形で壊す**。書き換える前に落とす。
  # **検査と置換で同じ規則を使う。** 検査が「行のどこかに在る」で、置換が「行頭に在る」だと、
  # 目印に空白が1つ付いただけで検査を通過し、awk が終わりを見つけられず人が書いた節を
  # 末尾まで消す。どちらも「その行が目印そのものである」に揃える。
  N_BEGIN="$(grep -cxF -- "$MARK_BEGIN" "$OUT" | tr -d ' ')"
  N_END="$(grep -cxF -- "$MARK_END" "$OUT" | tr -d ' ')"
  if [ "$N_BEGIN" != "1" ] || [ "$N_END" != "1" ]; then
    err "機械の節の目印が1組になっていません（${OUT}・begin ${N_BEGIN} 個 / end ${N_END} 個）。手で直してください"
    exit 2
  fi
  L_BEGIN="$(grep -nxF -- "$MARK_BEGIN" "$OUT" | head -1 | cut -d: -f1)"
  L_END="$(grep -nxF -- "$MARK_END" "$OUT" | head -1 | cut -d: -f1)"
  if [ -z "$L_BEGIN" ] || [ -z "$L_END" ] || [ "$L_BEGIN" -ge "$L_END" ]; then
    err "機械の節の目印の順序が逆です（${OUT}・begin ${L_BEGIN} 行目 / end ${L_END} 行目）。手で直してください"
    exit 2
  fi

  TMP="${OUT}.tmp.$$"
  MACHINE_FILE="${OUT}.machine.$$"
  # 途中で落ちても一時ファイルを残さない（中身は引き継ぎ文書の全文なので、置き去りは漏洩でもある）。
  trap 'rm -f "$TMP" "$MACHINE_FILE" 2>/dev/null' EXIT HUP INT TERM
  # 書込みの成否を見る。見ないと、書けていない staging を awk が読んで
  # **機械の節が空の文書を本物に被せる**。
  if ! ( umask 077; printf '%s\n' "$MACHINE" >"$MACHINE_FILE" ); then
    err "機械の節を書き出せませんでした: ${MACHINE_FILE}"
    exit 2
  fi
  ( umask 077; : >"$TMP" ) || { err "一時ファイルを作れません: ${TMP}"; exit 2; }
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" -v mf="$MACHINE_FILE" '
    $0 == b {
        while ((r = (getline line < mf)) > 0) print line
        close(mf)
        # getline はファイルを開けないとき -1 を返す。`> 0` だけで見ると、-1 も 0 も
        # 「ループに入らない」になり、**機械の節が空の文書ができて awk は 0 で終わる**。
        if (r < 0) { exit 3 }
        skip = 1; next
    }
    $0 == e { skip = 0; next }
    skip != 1 { print }
  ' "$OUT" >"$TMP"; awk_rc=$?
  # 書いている最中も緩めない（全文が入るので、途中の一時ファイルも読まれてはいけない）。
  chmod 600 "$TMP" 2>/dev/null || true
  if [ "$awk_rc" -eq 3 ]; then
    err "機械の節を読み出せませんでした（staging を開けない）。文書は変更していません"
    exit 2
  fi
  [ "$awk_rc" -eq 0 ] || { err "機械の節を差し替えられませんでした"; exit 2; }
  # 自分で名指しした故障の片側だけを塞がない。差し替えた結果に目印が1組あり、
  # 機械の節が空でないことを、被せる前に確かめる。
  if [ "$(grep -cxF -- "$MARK_BEGIN" "$TMP" | tr -d ' ')" != "1" ] \
     || [ "$(grep -cxF -- "$MARK_END" "$TMP" | tr -d ' ')" != "1" ] \
     || ! grep -qF -- '## 観測できる状態' "$TMP"; then
    err "差し替えた結果が壊れています。文書は変更していません"
    exit 2
  fi
  # mv は tmp の権限を持ち込むので、元の文書の権限に揃える（umask で 0600 が 0644 に緩まない）。
  chmod --reference="$OUT" "$TMP" 2>/dev/null \
    || chmod "$(stat -f %Lp "$OUT" 2>/dev/null || printf '644')" "$TMP" 2>/dev/null || true
  mv -f "$TMP" "$OUT" || { err "書き戻せませんでした: ${OUT}"; exit 2; }
  rm -f "$MACHINE_FILE"

  # --- 表示 ---
  printf '=== oe-handoff prepare ===\n'
  if [ "$CREATED" -eq 1 ]; then
    printf '引き継ぎ文書を作りました: %s\n' "$OUT"
  else
    printf '引き継ぎ文書の機械の節を書き直しました: %s\n' "$OUT"
  fi
  printf '前任 %s / session_id %s / context%% %s / 生きた委譲子 %s 件\n' \
    "$PREDECESSOR" "$SID" "$CTX" "$CHILD_COUNT"
  printf '\n'
  printf '次にやること:\n'
  printf '  1. %s の「人が書く」節を埋める（機械の節は触らない）\n' "$OUT"
  printf '     とくに「渡らないもの」と自己申告の残余は、ここでしか書けません。\n'
  if [ "$SID" = "unknown" ]; then
    # **ここで「次は start」と言わない。** `retire` が止める状態なのに「交代の準備ができた」と
    # 読める（片方だけ fail-open になる）。**生きた委譲子は交代を止めない**（owner 裁定
    # 2026-09-13）ので、止める理由として残るのは session_id だけである。
    printf '  2. **まだ交代できません。** 前任の session_id が引けていないので、停止が取り消せません。\n'
    printf '     拍動と transcript のどちらか（または両方）が、いまの前任のものだと言える状態にありません。\n'
  else
    printf '  2. oe-handoff start で後継のペインを起こす\n'
  fi
  if [ "$CHILD_COUNT" != "0" ]; then
    printf '  3. **後継へ子を引き渡す。** 生きた委譲子 %s 件は後継がまるごと引き受ける（交代は止まらない）。\n' "$CHILD_COUNT"
    printf '     後継は各子へ「報告の宛先は後継の pane である」ことを明示して伝えること。\n'
    printf '     伝えるまで、子が自分から出す報告は前任のペインを指したままである（PARENT_TMUX_PANE は差し替えられない）。\n'
  fi
  exit 0
}


# --- start: 後継のペインを起こして引き継ぎ文書のパスを送る ---------------------------
#
# **後継を登記の子にしない。** `oe-delegate` を使わず、素の tmux split で `claude` を起こす。
# `PARENT_TMUX_PANE` も渡さない。理由は、後継の自発的な報告の宛先が、これから停止する前任の
# ペインに焼き込まれるからである。
#
# **以前はもう1つ理由があったが、いまは無い。** 「後継自身が生きた委譲子に数えられて `take` が
# 永久に通らない」という理由は、子の数で `take` を止めていた前提のものである。owner 裁定
# （2026-09-13）で子は交代を止めなくなったので、この理由は効かない。**登記の子にしない判断
# そのものは、上の焼き込みの理由だけで維持する。**
#
# **起動と kickoff を分ける。** 起こした直後のペインは入力を受け付けられないことがあり、そこへ
# 送ると取りこぼす。ペインが現れてから送る。
cmd_start() {
  local handoff pane rc
  handoff="${HANDOFF:-${OE_HANDOFF_FILE:-${WORKSPACE}/.oe/handoff.md}}"
  [ -f "$handoff" ] || {
    err "引き継ぎ文書がありません: ${handoff}（先に oe-handoff prepare を走らせてください）"
    exit 1; }
  if ! grep -qF -- "$MARK_BEGIN" "$handoff"; then
    err "引き継ぎ文書に機械の節がありません: ${handoff}"
    exit 1
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '=== oe-handoff start（dry-run・何も起こしません）===\n'
    printf '起こすもの  : %s（%s で・PARENT_TMUX_PANE は渡さない）\n' "$OE_HANDOFF_CLAUDE" "$WORKSPACE"
    printf '送るもの    : %s を読んで進めて。\n' "$handoff"
    printf '登記        : しない（後継は委譲子ではない）\n'
    exit 0
  fi

  command -v "$OE_HANDOFF_TMUX" >/dev/null 2>&1 || { err "tmux が要ります"; exit 2; }
  pane="$("$OE_HANDOFF_TMUX" split-window -d -P -F '#{pane_id}' -c "$WORKSPACE" "$OE_HANDOFF_CLAUDE" 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$pane" ]; then
    err "後継のペインを起こせませんでした"
    exit 1
  fi
  printf '=== oe-handoff start ===\n'
  printf '後継のペインを起こしました: %s（登記していません・PARENT_TMUX_PANE も渡していません）\n' "$pane"

  # 起動と kickoff の分離。ペインが一覧に現れるまで待ってから送る。
  #
  # **これは「入力を受け付けられる」ことの確認ではない。** ペインの存在は作った直後から成立し、
  # その中の TUI が初期化を終えたかは分からない。画面を読んで判定する形は採らない（版で消える
  # 目印に頼る形になる）。だから確認できるのは存在までで、そのうえで落ち着くまで待つ。
  # **待っても現れなければ送らない。** 送っても取りこぼすだけで、送ったつもりだけが残る。
  local i=0 appeared=0
  while [ "$i" -lt "${OE_HANDOFF_START_WAIT:-10}" ]; do
    if "$OE_HANDOFF_TMUX" list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qxF -- "$pane"; then appeared=1; break; fi
    i=$((i + 1))
    sleep 1
  done
  if [ "$appeared" -ne 1 ]; then
    printf '起こしたペイン %s が一覧に現れませんでした。送っていません。\n' "$pane"
    printf 'ペインを確かめてから、手で貼ってください:\n  %s を読んで進めて。\n' "$handoff"
    exit 1
  fi
  sleep "${OE_HANDOFF_START_SETTLE:-2}"

  if "$OE_HANDOFF_SEND" "$pane" "${handoff} を読んで進めて。" >/dev/null 2>&1; then
    printf '引き継ぎ文書のパスを送りました: %s\n' "$handoff"
  else
    printf '引き継ぎ文書のパスを送れませんでした。ペイン %s に手で貼ってください:\n' "$pane"
    printf '  %s を読んで進めて。\n' "$handoff"
  fi
  printf '\n次にやること: 後継のセッションで oe-handoff take を走らせる\n'
  exit 0
}

# --- take: 後継が席を取りに行く -----------------------------------------------------
#
# 順序は「確かめるものが先、書き換えるものが後」。前提の検査を全部済ませてから登記と board を
# 触る。途中で落ちても、何が済んで何が済んでいないかを表示する。何度実行しても同じ結果になる。
cmd_take() {
  local board handoff self pred sid children child_rc child_count rc
  board="${BOARD:-${OE_BOARD_FILE:-}}"
  handoff="${HANDOFF:-${OE_HANDOFF_FILE:-${WORKSPACE}/.oe/handoff.md}}"
  self="${TMUX_PANE:-}"

  local -a done_items=() undone_items=()
  note_done()   { done_items+=("$1"); }
  note_undone() { undone_items+=("$1"); }
  report_and_exit() { # <rc>
    # format が '-' で始まると bash の printf が option と解釈して落ちる（実機で確認）。
    # 見出しは %s で流す。
    printf '\n%s\n' '--- 済んだこと ---'
    if [ "${#done_items[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${done_items[@]}"; fi
    printf '%s\n' '--- 済んでいないこと ---'
    if [ "${#undone_items[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${undone_items[@]}"; fi
    if [ "${1:-0}" -ne 0 ]; then
      printf '\n直したうえで oe-handoff take をもう一度走らせてください（済んだところは飛ばします）。\n'
    fi
    exit "${1:-0}"
  }

  printf '=== oe-handoff take ===\n'

  # --- (1) 前提の検査（ここでは何も書き換えない） ---
  [ -n "$self" ] || { err "自分のペインが分かりません（tmux の中で走らせてください）"; exit 2; }
  [ -n "$board" ] || { err "board の場所が決まりません（--board か OE_BOARD_FILE で渡してください）"; exit 2; }
  [ -r "$board" ] || { err "board が読めません: ${board}"; exit 2; }
  [ -w "$board" ] || { err "board が書けません: ${board}"; exit 2; }

  if [ ! -f "$handoff" ]; then
    err "引き継ぎ文書がありません: ${handoff}"
    note_undone "引き継ぎ文書が無いので席を動かしていない（先に前任のセッションで prepare を走らせる）"
    report_and_exit 1
  fi

  local declared
  declared="$(oe_seat_resolve "$board")"
  if [ -n "$PREDECESSOR" ]; then
    # **渡された前任が board の宣言と食い違っていたら進まない。**
    # 食い違ったまま進むと、検査した相手（渡された pane）と書き換える相手（board の席）が
    # ずれ、いま座っている統括を黙って上書きできてしまう。
    # 例外は「board が既に自分を指している」場合だけで、これは席を取った後にイベントの
    # 記録だけが落ちたときの修復にあたる（board は書き換えずイベントだけ足す）。
    if [ "$PREDECESSOR" != "$declared" ] && [ "$declared" != "$self" ]; then
      err "渡された前任（${PREDECESSOR}）が board の宣言（${declared:-空}）と違います"
      note_undone "前任の食い違いがあるので席を動かしていない"
      report_and_exit 1
    fi
  else
    PREDECESSOR="$declared"
  fi
  pred="$PREDECESSOR"
  if [ -z "$pred" ]; then
    err "board から前任のペインを読めません（現統括: の宣言が見つからない）"
    note_undone "前任が分からないので席を動かしていない"
    report_and_exit 1
  fi

  if [ "$declared" = "$self" ] && [ "$pred" = "$self" ]; then
    # 既に席に居て、前任も明示されていない。**ここで成功として終える。**
    # この先の検査は「前任」に対するもので、前任が自分になると意味が変わる
    # （自分の session_id を前任として確かめ、self → self の偽の交代イベントを書く）。
    printf '席は既に自分（%s）を指しています。何もしていません。\n' "$self"
    note_done "board の宣言は既に自分を指している（書き換えていない）"
    # **server_pid を渡す。** 渡さないと、別 server の時代に同じ番号だった pane 宛ての
    # 古いイベントを「今回の交代の記録」と誤認して、未記録なのに記録済みと報告する。
    if oe_event_succession_recorded "" "$self" 0 "" "$(oe_hs_server_pid)"; then
      note_done "交代イベントは記録されている"
    else
      note_undone "交代イベントが記録されていない（--predecessor <前任> と --generation を明示して実行すると、board は触らずに記録だけ足せます）"
    fi
    report_and_exit 0
  fi

  # 生きた委譲子。**数えるが、席は止めない**（owner 裁定 2026-09-13）。
  #
  # 以前はここで子0体を要求していた（旧 DJ-11）。前提は「前任の pane を閉じると生きている子の
  # 戻し先が死ぬ」だったが、**実測がこれを否定した。** 統括の交代をまたいで同じ子が後継へ報告した
  # 実例がログに在る。supervision はリクエストとレスポンスで回るので、後継が指示を送れば子は
  # **送ってきた相手に返す**。`PARENT_TMUX_PANE` が効くのは、誰にも聞かれずに子が自分から報告を
  # 出す経路だけである。**狭い前提を主経路に一般化していた。**
  #
  # **それでも数えて出す。** 後継は「誰を引き受けたか」を知る必要がある。
  # **数えられなかったことを0に畳まない。** 席は動かすが「確かめた」とは書かない。
  if [ "$pred" != "$self" ]; then
    children="$(oe_hs_children_of "$pred")"; child_rc=$?
    if [ "$child_rc" -ne 0 ]; then
      printf '生きた委譲子: **数えられませんでした。0 件ではありません**（登記を読み切れていない）\n'
      note_undone "引き受けた委譲子が分からない（数えられなかった）。席は動かすが、誰を引き受けたかは確かめられていない"
    else
      if [ -z "$children" ]; then child_count=0; else child_count="$(printf '%s\n' "$children" | grep -c '^' | tr -d ' ')"; fi
      printf '生きた委譲子: %s 件\n' "$child_count"
      if [ "$child_count" -ne 0 ]; then
        printf '%s\n' "$children" | sed 's/^/  - /'
        note_done "引き受けた委譲子を確かめた（${child_count} 件・交代は止めない）"
        note_undone "上の子へ新しい報告先を伝えていない。**伝えるまで、子が自分から出す報告は前任のペインを指したままである**（PARENT_TMUX_PANE は差し替えられないので、宛先が変わるのは子が後継の pane を明示して送るときだけである）"
      else
        note_done "前任に生きた委譲子は居ない"
      fi
    fi
  fi

  # 前任の session_id。停止（PR-3）の前提条件なので、ここで引けないなら先へ進めない。
  sid="$(oe_hs_session_for_pane "$pred")"
  if [ "$sid" = "unknown" ]; then
    err "前任の session_id が引けません: ${OE_HS_SESSION_REASON:-理由不明}"
    note_undone "session_id が引けないので席を動かしていない（停止が取り消せなくなる）"
    report_and_exit 1
  fi
  note_done "前任の session_id を確かめた（${sid}）"

  # --- (2) 見張りの状態（終了コードでは判定しない） ---
  local sc_json wd_row
  # **終了コードで捨てない。** oe-selfcheck は broken が1つでもあれば 1 を返すので、
  # `|| sc_json=""` と書くと、いま screen-marker が broken である以上、出力を常に捨てる。
  # 見たいのは watchdog-freshness の行であって、全体の合否ではない。
  sc_json="$("$OE_HANDOFF_SELFCHECK" --json 2>/dev/null; true)"
  # **実物の `oe-selfcheck --json` は素の配列を返す。** 配列に `.checks` を当てると jq は
  # `Cannot index array with string "checks"` で誤りになり、**`//` は誤りを拾わない**（拾うのは
  # null と false だけ）。`2>/dev/null` に飲まれるので、`(.checks // .)` と書くと実物に対して
  # この行は**必ず空になる**。予行で実測した（#390・2026-09-13）。
  # 配列を主として扱い、object で包まれた形も受ける。
  if [ -n "$sc_json" ] && command -v jq >/dev/null 2>&1; then
    wd_row="$(printf '%s' "$sc_json" | jq -r 'if type == "array" then .[] else (.checks // [])[] end | select(.check == "watchdog-freshness") | .verdict + " " + (.detail // "")' 2>/dev/null | head -1)" || wd_row=""
  else
    wd_row=""
  fi
  if [ -n "$wd_row" ]; then
    printf '見張り（watchdog-freshness）: %s\n' "$wd_row"
    case "$wd_row" in
      ok*) note_done "見張り（oe-confirm）の最終走査が新しいことを確かめた" ;;
      *)   note_undone "見張りの生存を確かめられていない（watchdog-freshness=${wd_row%% *}）。席は取るが、統括が死んでも気づかれない可能性がある" ;;
    esac
  else
    printf '見張り（watchdog-freshness）: 読めませんでした（oe-selfcheck の出力を取れない）\n'
    note_undone "見張りの生存を確かめられていない（oe-selfcheck の出力を取れない）"
  fi
  printf '%s\n' "常駐の見張りの登録:" ; oe_hs_watchdogs | sed 's/^/  - /'
  # **`watchdog-freshness` が見ているのは oe-confirm の最終走査であって oe-vitals ではない。**
  # oe-vitals には最終走査を残す記録が無いので、登録の有無までしか言えない。
  note_undone "oe-vitals の最終走査は確かめられていない（登録の有無しか分からない・そういう記録が無い）"

  # 見張りが確かめられなくても席は取る。取らないと交代そのものが止まり、context を使い切った
  # 統括が座り続けるほうが害が大きい。**ただし「確かめた」とは書かない。**

  # --- (3) 世代 ---
  if [ -z "$GENERATION" ]; then
    GENERATION="$(grep -m1 -- '現統括:' "$board" 2>/dev/null | grep -oE '統括\*{0,2}[0-9]+代目' | head -1 | grep -oE '[0-9]+' || true)"
    if [ -n "$GENERATION" ]; then GENERATION=$((GENERATION + 1)); fi
  fi

  # --- (4) 登記（自分を root に）---
  # 既に自分が root として登記されているなら書かない（何度実行しても同じ結果になる）。
  local self_key already_root=0
  self_key="$(printf '%s' "$(oe_hs_server_pid)_${self}" | tr -c 'A-Za-z0-9' '_')"
  if [ -n "$OE_DELEGATE_STATE_DIR" ] && [ -f "${OE_DELEGATE_STATE_DIR}/${self_key}.json" ] \
     && command -v jq >/dev/null 2>&1 \
     && [ "$(jq -r '.parent_pane // "x"' "${OE_DELEGATE_STATE_DIR}/${self_key}.json" 2>/dev/null)" = "" ]; then
    already_root=1
  fi
  if [ "$already_root" -eq 1 ]; then
    note_done "自分は既に root として登記されている（登記し直していない）"
  elif "$OE_HANDOFF_REGISTER" root --label cockpit --force >/dev/null 2>&1; then
    note_done "自分を root として登記した（label cockpit）"
  else
    note_undone "自己登記に失敗した"
    err "自己登記に失敗しました"
    report_and_exit 1
  fi

  # --- (5) board の張替 ---
  # **書き換える直前にもう一度 board を確かめる**（compare-and-swap）。検査から書き換えまでの
  # あいだに別の後継が席を取っていたら、それを黙って上書きしない。
  oe_seat_rewrite "$board" "$self" "${GENERATION:-}" "$(date '+%Y-%m-%d')" "$pred" "$pred"; rc=$?
  case "$rc" in
    0) note_done "board の宣言を自分（${self}）へ張り替えた（前任 ${pred} は退任申告済み・停止待ちとして併記）" ;;
    1) note_done "board の宣言は既に自分を指していた（書き換えていない）" ;;
    4) err "いま別のプロセスが同じ board を書き換えています"
       note_undone "ロックを取れなかったので張り替えていない（少し待ってからもう一度）"
       report_and_exit 1 ;;
    3) err "board の宣言が ${pred} から動いています。検査してから書き換えるまでの間に席が動きました"
       note_undone "席が動いたので張り替えていない（もう一度 take を実行してください）"
       report_and_exit 1 ;;
    *) err "board を張り替えられませんでした"
       note_undone "board の張替に失敗した（登記だけ済んでいる）"
       report_and_exit 1 ;;
  esac

  # --- (6) 検算（張り替えた本人が別の規則で確かめない）---
  local got
  if got="$(oe_seat_verify "$board" "$self")"; then
    note_done "張替後に同じ規則で読み直して自分が返ることを確かめた"
  else
    err "検算に失敗しました。board の宣言は ${got:-空} を指しています"
    note_undone "検算が通らない（board の宣言が自分を指していない）"
    report_and_exit 1
  fi

  # --- (7) 交代イベント ---
  if [ -z "$GENERATION" ]; then
    note_undone "交代イベントを記録していない（世代が分からない。--generation で渡せます）"
  else
    # emit の**前**の行数を覚えておき、読み直しはそれより後ろだけを見る。
    # 「過去に同じ from/to の行がある」で成功にすると、今回の emit が落ちても素通りする。
    local ev_file ev_before=0
    ev_file="${OE_EVENT_DIR:-}/oe-events.jsonl"
    [ -r "$ev_file" ] && ev_before="$(grep -c '' "$ev_file" 2>/dev/null | tr -d ' ')"
    oe_event_supervisor_succession "$pred" "$self" "$GENERATION" "$REASON" "$(oe_hs_server_pid)" "cockpit" "cockpit" || true
    if oe_event_succession_recorded "$pred" "$self" "$ev_before" "$GENERATION" "$(oe_hs_server_pid)"; then
      note_done "交代イベントを記録した（${pred} → ${self}・${GENERATION}代目・${REASON}）"
    else
      note_undone "交代イベントが記録されていない（emit は失敗を飲み込むので読み直して確かめた）"
    fi
  fi

  report_and_exit 0
}

# --- retire: 前任を閉じてよいかを判定し、--execute で閉じる -------------------------
#
# **引数なしは下見である。何も停止しない。** `--execute` だけが閉じる。
#
# `--execute` は**検査をやり直してから**閉じる。下見で通ったことを根拠に閉じない。下見と
# 実行のあいだに新しい報告や委譲や board の更新が入りうるので、**検査と停止のあいだに人の
# 操作を挟ませない**（そのために両方を同じコマンドの中に置く）。
#
# **段階1 で触れてよいのは前任のペインだけである。** board・登記・イベントログ・worktree・PR
# には触れない。後始末（登記の掃除・worktree の掃除・issue の close）は人のゲートのまま残す。
cmd_retire() {
  local board handoff self pred sid_rec

  local -a fail=() diff_items=() ok_items=() info_items=()
  note_ok()   { ok_items+=("$1"); }
  note_fail() { fail+=("$1"); }
  note_diff() { diff_items+=("$1"); }
  # **閉じない理由にはしないが、後継が知る必要があること。** 判定に効かせないので fail とは
  # 別の配列に入れる（混ぜると「閉じない理由」が水増しされて読めなくなる）。
  note_info() { info_items+=("$1"); }

  board="${BOARD:-${OE_BOARD_FILE:-}}"
  handoff="${HANDOFF:-${OE_HANDOFF_FILE:-${WORKSPACE}/.oe/handoff.md}}"
  self="${TMUX_PANE:-}"

  printf '=== oe-handoff retire%s ===\n' "$([ "$EXECUTE" -eq 1 ] && printf ' --execute' || printf '（下見・何も停止しません）')"

  [ -f "$handoff" ] || { err "引き継ぎ文書がありません: ${handoff}"; exit 2; }
  # **閉じる判断に要る材料が観測できないなら、判断しない。**
  # board と自ペインは「あれば見る」ではなく必須にする。無いまま進むと、後継本人かどうかも
  # 席が動いていないかも確かめずに前任を閉じられる（閉じる操作は取り消しにくい）。
  [ -n "$self" ] || { err "自分のペインが分かりません（tmux の中で走らせてください）"; exit 2; }
  [ -n "$board" ] || { err "board の場所が決まりません（--board か OE_BOARD_FILE で渡してください）"; exit 2; }
  [ -r "$board" ] || { err "board が読めません: ${board}"; exit 2; }

  # --- 機械の節を切り出し、目印の完全性を確かめる ---
  # **文書全体から拾わない。** 以前は `grep -m1 '^- 前任のペイン: '` を文書全体に当てていたので、
  # **機械の節が欠落・破損していても、同じ形の行が散文にあれば値を信用した**（実装SO の指摘・
  # 2026-09-13）。閉じる相手の pane・session_id・pid は、**機械が書いた節の中の値だけ**を使う。
  # 検査の規則は `prepare` と同じ（目印は行全体が一致・1組だけ・順序が正しい）。
  local n_begin n_end l_begin l_end machine_block
  n_begin="$(grep -cxF -- "$MARK_BEGIN" "$handoff" | tr -d ' ')"
  n_end="$(grep -cxF -- "$MARK_END" "$handoff" | tr -d ' ')"
  if [ "$n_begin" != "1" ] || [ "$n_end" != "1" ]; then
    err "引き継ぎ文書の機械の節の目印が1組になっていません（begin ${n_begin} 個 / end ${n_end} 個）。**機械が書いた記録だと言えないので閉じません。** 前任のセッションで oe-handoff prepare を走らせ直してください"
    exit 2
  fi
  l_begin="$(grep -nxF -- "$MARK_BEGIN" "$handoff" | head -1 | cut -d: -f1)"
  l_end="$(grep -nxF -- "$MARK_END" "$handoff" | head -1 | cut -d: -f1)"
  if [ -z "$l_begin" ] || [ -z "$l_end" ] || [ "$l_begin" -ge "$l_end" ]; then
    err "引き継ぎ文書の機械の節の目印の順序が逆です（begin ${l_begin} 行目 / end ${l_end} 行目）。**機械が書いた記録だと言えないので閉じません**"
    exit 2
  fi
  machine_block="$(sed -n "${l_begin},${l_end}p" "$handoff")" || machine_block=""

  # --- 前任の pane と session_id は「機械の節」から取る ---
  # board の註からも取れるが、**2つが食い違っていたら進まない**（検査した相手と閉じる相手が
  # ずれるのを防ぐ。PR-2 で踏んだのと同じ型）。
  pred="$(printf '%s\n' "$machine_block" | grep -m1 -- '^- 前任のペイン: ' | grep -oE '%[0-9]+' | head -1)" || pred=""
  # shellcheck disable=SC2016  # backtick は引き継ぎ文書の Markdown 記法で、展開させない
  sid_rec="$(printf '%s\n' "$machine_block" | grep -m1 -- '^- 前任の session_id: ' | sed -E 's/.*`([^`]*)`.*/\1/')" || sid_rec=""
  if [ -z "$pred" ]; then
    err "機械の節から前任のペインを読めません（${handoff}）"
    exit 2
  fi
  if true; then
    local board_pred
    # shellcheck disable=SC2016  # backtick は board の Markdown 記法で、展開させない
    board_pred="$(grep -m1 -- '現統括:' "$board" | grep -oE '前任 `%[0-9]+`' | grep -oE '%[0-9]+' | head -1)" || board_pred=""
    if [ -z "$board_pred" ]; then
      # 註が読めないことを「食い違っていない」に畳まない。
      note_fail "board の註から前任を読めない（「前任 \`%N\` は退任申告済み・停止待ち」の形が無い）。引き継ぎ記録と突き合わせられないので閉じない"
    elif [ "$board_pred" != "$pred" ]; then
      err "引き継ぎ記録の前任（${pred}）と board の註（${board_pred}）が食い違っています"
      note_fail "前任が一意に決まらないので閉じない"
      _retire_report
    else
      note_ok "引き継ぎ記録の前任と board の註が一致している（${pred}）"
    fi
    # 席が自分に移っていることも見る（移っていないなら、まだ交代が済んでいない）
    local seat
    seat="$(oe_seat_resolve "$board")"
    if [ -z "$seat" ]; then
      # **この枝はテストで踏めていない。** 上の註の検査が先に走り、註に前任の `%N` が在れば
      # 席の解決も同じ行の `%N` を拾うので、「註は読めるが席は読めない」を fixture で作れない。
      # 防御として残す（読めないことを「自分の席だ」に畳まないため）。
      note_fail "board から席を読めない。自分が後継であることを確かめられないので閉じない"
    elif [ "$seat" != "$self" ]; then
      note_fail "board の席が自分（${self}）でなく ${seat} を指している。先に take を通す"
    else
      note_ok "board の席は自分を指している"
    fi
  fi
  [ "$pred" != "$self" ] || { err "前任と自分が同じペイン（${self}）です"; exit 2; }
  RETIRE_PRED="$pred"
  RETIRE_SID="$sid_rec"
  RETIRE_MACHINE="$machine_block"

  # --- 必須条件1: session_id が引き継ぎ記録に残っている ---
  # **必須条件は2つである**（1 と 3）。以前あった「生きた委譲子が0体」は owner 裁定
  # （2026-09-13）で要求をやめた。番号は記録との対応を保つため振り直さない。
  if [ -z "$sid_rec" ] || [ "$sid_rec" = "unknown" ]; then
    note_fail "前任の session_id が引き継ぎ記録に無い（${sid_rec:-空}）。閉じると claude --resume で開き直せない"
  else
    note_ok "前任の session_id が引き継ぎ記録にある（${sid_rec}）"
  fi

  # --- 生きた委譲子（**閉じない理由にはしない**・owner 裁定 2026-09-13）---
  # 以前はここが必須条件2で、子が居ると閉じなかった。子が生きたままの交代が正常系であり、
  # 止めているほうが不具合である、という裁定で要求をやめた。**残る穴は自発的な報告の経路だけ**で、
  # 後継が各子へ新しい報告先を明示して伝えれば塞がる。**穴が在ることは下の出力に書く。**
  # **数えられなかったことを0に畳まない。**
  local children child_rc child_count
  children="$(oe_hs_children_of "$pred")"; child_rc=$?
  if [ "$child_rc" -ne 0 ]; then
    note_info "前任の生きた委譲子を数えられない（閉じない理由にはしない。誰を引き受けたかは確かめられていない）"
  else
    if [ -z "$children" ]; then child_count=0; else child_count="$(printf '%s\n' "$children" | grep -c '^' | tr -d ' ')"; fi
    if [ "$child_count" -ne 0 ]; then
      note_info "前任に生きた委譲子が ${child_count} 件ある（後継が引き受ける。閉じない理由にはしない）"
      printf '%s\n' "$children" | sed 's/^/    - /'
    else
      note_info "前任に生きた委譲子は居ない"
    fi
  fi

  # --- 必須条件2（旧・必須条件3）: 申告の各項目に処分が付いている ---
  local decl parsed bad_rows
  # **散文ではなく「処分が付いた表の行」を照合の相手にする。** 申告の節のどこかに番号が
  # 現れるだけで通すと、`返信待ち: PR #501` と書くだけで未処分の PR を通せる（実装SO の
  # 2レーンが独立に再現した・2026-09-13）。
  DISPOSED=""
  decl="$(awk '/^## 前任の自己申告/,/^## [^前]/' "$handoff")" || decl=""
  if [ -z "$decl" ]; then
    note_fail "引き継ぎ文書に自己申告の節が無い"
  else
    # 表の本体（見出しと区切りを除く）で、項目が空でない行を「項目<TAB>処分」に直す。
    #
    # **`awk -F'|'` で素朴に割らない。** Markdown の escaped pipe（`\|`）はセルの中身なので、
    # 境界として数えると列がずれる。`| command \| 済んだ |  | … |` は処分欄が**空**だが、
    # 素朴に割ると3番目の欄が `済んだ` に見えて、**未処分の項目が必須条件を通る**（実装SO の
    # 指摘・2026-09-13。実測で再現した）。
    #
    # **見出しと区切りを「内容」で判定しない。** 以前は項目名に「項目」を含む行を見出しとして
    # 捨てていたので、`| この項目 |  | … |` のような**実データ行が黙って数から消えていた**。
    # 表の何行目かと、セルが罫線だけかで判定する。
    #
    # **行頭の空白を許す。** `/^\|/` で錨を打つと、字下げされた行（Markdown では表の行として
    # 有効）が**黙って数から消える**。全部が字下げなら「項目が1つも無い」で止まるが、一部だけ
    # 字下げされていると、その行の未処分を見逃す（自分で試して見つけた・2026-09-13）。
    #
    # **塞げていないもの**: コードスパンの中のパイプ（`` | `a | b` | … | ``）はセルの境界として
    # 数える。この場合、処分の欄が語彙の外の文字列になるので**必須条件は落ちる**（fail-closed）。
    # 項目名の表示はずれるが、未処分が通ることはない。**Markdown の完全な解析はしない。**
    # **区切り文字で往復させない。** 以前は「項目<TAB>処分」に直してから `awk -F'\t'` で
    # 読み直していたが、**項目名に literal TAB があると列がずれる**。`| foo<TAB>済んだ |  | … |`
    # は処分欄が空でも `$2` が `済んだ` に見えて必須条件を通った（実装SO の指摘・2026-09-13）。
    # 語彙の判定と件数と「処分の付いた項目」の抽出を**同じ awk の中で**済ませ、出力は行頭1文字の
    # 種別だけで区別する（1行1件で、セルに改行は入らないので曖昧にならない）。
    #   C <件数> / B <表示用の落ちた行> / D <処分が付いた項目名>
    parsed="$(printf '%s\n' "$decl" | awk '
      /^[ \t]*\|/ {
        line = $0
        gsub(/\\\|/, "\001", line)
        n = split(line, c, "|")
        item = c[2]; disp = c[3]
        gsub(/^[ \t]+|[ \t]+$/, "", item); gsub(/^[ \t]+|[ \t]+$/, "", disp)
        rowno++
        if (rowno == 1) next
        # **GFM の alignment delimiter（`:---` / `:---:` / `---:`）も区切りである。**
        # `^-{2,}$` だけを区切りとしていたので、**正当に全項目へ処分を付けた申告が恒常的に
        # 通らなくなっていた**（区切り行が未処分のデータ行として数えられる・実装SO の指摘・
        # 2026-09-13。fail-closed だが誤判定である）。
        if (item ~ /^:?-+:?$/) next
        if (item == "") next
        gsub(/\001/, "\\|", item); gsub(/\001/, "\\|", disp)
        count++
        if (disp ~ /^(済んだ|引き継ぐ|取り消す)$/) { printf "D %s\n", item }
        else { printf "B %s → 処分[%s]\n", item, disp }
      }
      END { printf "C %d\n", count }')" || parsed=""
    local row_count
    row_count="$(printf '%s\n' "$parsed" | sed -n 's/^C //p' | head -1)"
    bad_rows="$(printf '%s\n' "$parsed" | sed -n 's/^B //p')"
    # **処分の付いた項目だけを、あとの照合の相手にする。** 申告の散文に番号を書いただけで
    # 通ってはいけない（下の「機械の節が挙げた項目」の照合で使う）。
    DISPOSED="$(printf '%s\n' "$parsed" | sed -n 's/^D //p')"
    if [ -z "${row_count:-}" ] || [ "$row_count" -eq 0 ]; then
      note_fail "自己申告の表に項目が1つも書かれていない（「保留ゼロ」とだけ書く形は通さない）"
    elif [ -n "$bad_rows" ]; then
      note_fail "処分が付いていない（または語彙の外の）項目がある"
      printf '%s\n' "$bad_rows" | sed 's/^/    /'
    else
      note_ok "申告の全項目に処分が付いている（${row_count} 件）"
    fi
  fi

  # --- 機械の節が挙げた項目それぞれに処分が付いているかを見る ---
  # **表に1行あって語彙が正しいだけでは足りない。** 機械が挙げた項目が申告に出てこなければ、
  # その項目には処分が付いていない。
  # 上で切り出して目印を検査した block をそのまま使う（2度切り出すと規則が分かれる）。
  local machine
  machine="$machine_block"
  local mnum
  # **部分一致で照合しない。** `grep -F 501` は申告の「#3501」や「2026-09-501」にも当たるので、
  # 別の PR を書いた申告で欠落を見逃す（fail-open）。数字の前後が数字でないことまで見る。
  # **照合の相手は `$DISPOSED`（処分が付いた表の行の項目名）である。** 申告の節全体を見ると、
  # 散文に番号を書いただけで通る。
  # **番号だけの一致にしない。** 項目名の中の境界付き数字で照合していたので、
  # `worktree topic-501` という処分済みの行が **PR #501 の処分としても一致**した
  # （種別をまたいだ誤一致・実装SO の指摘・2026-09-13。実測で再現した）。
  # PR は `#<番号>` の形で書かれていることを要求する（機械の節も `#` 付きで表示する）。
  for mnum in $(printf '%s' "$machine" | grep -oE '^- [0-9]+ draft=' | grep -oE '[0-9]+' || true); do
    if printf '%s\n' "$DISPOSED" | grep -qE "#[ ]*${mnum}([^0-9]|\$)"; then
      :
    else
      note_fail "機械の節が挙げた PR #${mnum} に処分が付いていない（処分の付いた申告の行に \`#${mnum}\` の形で出てこない）"
    fi
  done
  if printf '%s' "$machine" | grep -qE 'unpushed=[1-9]'; then
    if printf '%s\n' "$DISPOSED" | grep -qE '未 ?push|unpushed'; then :; else
      note_fail "機械の節が未 push を挙げているのに、処分の付いた申告の行に出てこない"
    fi
  fi

  # --- 機械の検査をやり直して申告と突き合わせる ---
  # **下見の時点の値ではなく、いまの値で突き合わせる。**
  local prs
  prs="$(oe_hs_open_prs "$WORKSPACE")"
  if [ -n "$prs" ] && [ "$prs" != "none" ]; then
    local n
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      case "$n" in unknown*) note_diff "open PR を数えられなかった（${n}）" ; continue ;; esac
      local num; num="${n%% *}"
      if printf '%s\n' "$DISPOSED" | grep -qE "#[ ]*${num}([^0-9]|\$)"; then
        :
      else
        note_diff "open PR #${num} に処分が付いていない（\`#${num}\` の形で書く・${n#* }）"
      fi
    done <<EOF_PRS
$prs
EOF_PRS
  fi
  # 未 push と worktree も見る（open PR だけでは欠落を拾えない）
  local repo_now
  repo_now="$(oe_hs_repo_state "$WORKSPACE")"
  # worktree も見る。前任の作業枝が残っているのに申告に出てこない形を拾う。
  # **`git worktree list` の失敗を「worktree は無い」に畳まない。** 畳むと、観測できていない
  # のに未処分の worktree が無いことにして閉じる（実装SO の指摘・2026-09-13）。
  # `pipefail` の有無で結果が変わらないよう、パイプを使わずに rc を取る。
  local wt_now wt_raw wt_rc
  wt_raw="$(git -C "$WORKSPACE" worktree list 2>/dev/null)"; wt_rc=$?
  if [ "$wt_rc" -ne 0 ]; then
    note_diff "worktree を数えられなかった（git worktree list が失敗した）。未処分の worktree が無いとは言えない"
    wt_now=""
  else
    wt_now="$(printf '%s\n' "$wt_raw" | awk 'NR>1 {print $1}')"
  fi
  if [ -n "$wt_now" ]; then
    local wtp base
    while IFS= read -r wtp; do
      [ -n "$wtp" ] || continue
      base="$(basename "$wtp")"
      printf '%s\n' "$DISPOSED" | grep -qF -- "$base" \
        || note_diff "main 以外の worktree に処分が付いていない（${base}）"
    done <<EOF_WT
$wt_now
EOF_WT
  fi

  # **「上流が無い」と「数えられなかった」を分ける。** 上流が無い枝は正当な状態で、比べる相手が
  # 無いだけである。これを「分からない」と同じに扱うと、正当な状態で交代が止まる。
  case "$repo_now" in
    *'unpushed=unknown(no-upstream)'*) note_ok "未 push は比べる相手が無い（上流を持たない枝）" ;;
    *unpushed=unknown*)                note_diff "未 push を数えられなかった（${repo_now}）" ;;
    *unpushed=0*)                      note_ok "未 push は無い" ;;
    # **ここも散文ではなく処分の付いた行を見る。** 5箇所目である（機械の節の PR・未 push の
    # 申告・open PR の再検査・worktree・ここ）。1つ取り残すと、そこだけ散文で通る。
    *)                                 printf '%s\n' "$DISPOSED" | grep -qE '未 ?push|unpushed' \
                                         || note_diff "未 push が残っているのに、処分の付いた申告の行に出てこない（${repo_now}）" ;;
  esac

  _retire_report
}

_retire_report() {
  printf '\n%s\n' '--- 確かめられたこと ---'
  if [ "${#ok_items[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${ok_items[@]}"; fi
  printf '%s\n' '--- 後継が引き受けるもの（閉じない理由にはしない）---'
  if [ "${#info_items[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${info_items[@]}"; fi
  printf '%s\n' '--- 閉じられない理由 ---'
  if [ "${#fail[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${fail[@]}"; fi
  printf '%s\n' '--- 申告と機械の検査の食い違い ---'
  if [ "${#diff_items[@]}" -eq 0 ]; then printf '  （なし）\n'; else printf '  - %s\n' "${diff_items[@]}"; fi

  if [ "${#fail[@]}" -ne 0 ]; then
    printf '\n閉じません。上の理由を片づけてからもう一度実行してください。\n'
    exit 1
  fi
  if [ "${#diff_items[@]}" -ne 0 ]; then
    printf '\n申告と機械の検査が食い違っています。**閉じません。**\n'
    printf '申告を直すか、食い違いの中身を確かめてからもう一度実行してください。\n'
    exit 1
  fi

  if [ "$EXECUTE" -ne 1 ]; then
    printf '\n判定: 閉じてよい。**下見なので何もしていません。**\n'
    printf '閉じるには次を実行してください（検査をやり直してから閉じます）:\n'
    printf '  oe-handoff retire --execute\n'
    exit 0
  fi

  # --- 停止（前任のペインだけ）---
  if ! command -v "$OE_HANDOFF_TMUX" >/dev/null 2>&1; then
    err "tmux が要ります"; exit 2
  fi

  # **閉じる直前に session_id がまだ使えるかを確かめ直す。**
  # 必須条件が見ているのは「記録に在るか」で、**いま開き直せるか**は別である。transcript が
  # 消えていれば、閉じたあとに `claude --resume` は通らない（停止が取り消せなくなる）。
  if ! oe_hs_transcript_usable "$RETIRE_SID"; then
    err "前任の transcript が見つからないか古すぎます（${RETIRE_SID}）。閉じると claude --resume で開き直せません"
    exit 1
  fi


  # **閉じる直前にもう一度数える。止めるためではなく、後継が誰を引き受けたかを出すためである。**
  # 子は交代を止めない（owner 裁定 2026-09-13）ので、下見と実行のあいだに子が増えても閉じる。
  # ただし**増えたことは出す**。後継が声をかける相手が変わるからである。
  local last_children last_rc last_count
  last_children="$(oe_hs_children_of "$RETIRE_PRED")"; last_rc=$?
  if [ "$last_rc" -ne 0 ]; then
    printf '閉じる直前の数え直しができませんでした（誰を引き受けたかは確かめられていません）。閉じます。\n'
  else
    if [ -z "$last_children" ]; then last_count=0; else last_count="$(printf '%s\n' "$last_children" | grep -c '^' | tr -d ' ')"; fi
    printf '閉じる直前の生きた委譲子: %s 件\n' "$last_count"
    if [ "$last_count" -ne 0 ]; then
      printf '%s\n' "$last_children" | sed 's/^/    - /'
      printf '**この子は後継が引き受ける。声をかけるまで、子が自分から出す報告は前任のペインを指したままである。**\n'
    fi
  fi

  # **閉じるペインが、いまも記録の session のものであることを確かめる。**
  # transcript が使えることは「記録の session が生きている」ことしか言わない。**ペイン番号が
  # 再利用されていれば、そのペインに座っているのは別の session である**（拍動 198 件に対して
  # 実在する pane 番号は 171 で、再利用は既に起きている）。確かめずに閉じると、**関係のない
  # セッションを閉じたうえで「前任は claude --resume で開き直せる」と報告する**（実装SO の指摘・
  # 2026-09-13）。
  # **`unknown` を一致に数えない。** 引けないなら閉じない。
  local sid_now
  sid_now="$(oe_hs_session_for_pane "$RETIRE_PRED")"
  if [ -z "$sid_now" ] || [ "$sid_now" = "unknown" ]; then
    err "閉じる直前に ${RETIRE_PRED} の session_id を引けませんでした（${OE_HS_SESSION_REASON:-理由を取れなかった}）。**そのペインが前任のものだと確かめられないので閉じません**"
    exit 1
  fi
  if [ "$sid_now" != "$RETIRE_SID" ]; then
    err "${RETIRE_PRED} に座っているのは別の session です（記録 ${RETIRE_SID} / いま ${sid_now}）。**ペイン番号が再利用されています。閉じません**"
    exit 1
  fi

  # **同一性の検査は kill の直前に置く。** 以前はこのブロックが子の数え直しより前にあり、
  # 検査と `kill-pane` のあいだに別の処理が入っていた。そのあいだに前任が終わってペイン番号が
  # 再利用されると、**確かめた相手と閉じる相手がずれる**（実装SO の指摘・2026-09-13）。
  # 窓を0にはできないが、**あいだに何も挟まない**ところまでは寄せられる。
  # **session_id の突合だけでは足りない。** `oe_hs_session_for_pane` には「ペインが再利用され、
  # 新しいセッションがまだ一度も拍動を書いていないあいだは旧世代の session_id を返す」穴がある
  # （`lib/handoff-state.sh` の注記）。その窓では上の突合が通ってしまい、**無関係な新しい
  # セッションを閉じる**（実装SO の指摘・2026-09-13）。
  # **pid は tmux が握っているので、拍動を書く前でも変わる。** これで窓を塞ぐ。
  local pid_rec pid_now
  # shellcheck disable=SC2016  # backtick は引き継ぎ文書の Markdown 記法で、展開させない
  pid_rec="$(printf '%s\n' "$RETIRE_MACHINE" | grep -m1 -- '^- 前任のペインの pid: ' | sed -E 's/.*`([^`]*)`.*/\1/')" || pid_rec=""
  case "$pid_rec" in
    ''|*[!0-9]*)
      err "引き継ぎ記録に前任のペインの pid がありません（古い形式の引き継ぎ文書です）。**ペインの同一性を確かめられないので閉じません。** 前任のセッションで oe-handoff prepare を走らせ直してください"
      exit 1 ;;
  esac
  if ! pid_now="$(oe_hs_pane_pid "$RETIRE_PRED")"; then
    err "${RETIRE_PRED} の pid を引けませんでした。**そのペインが前任のものだと確かめられないので閉じません**"
    exit 1
  fi
  if [ "$pid_now" != "$pid_rec" ]; then
    err "${RETIRE_PRED} で走っているプロセスが変わっています（記録 pid ${pid_rec} / いま ${pid_now}）。**ペインが作り直されたか再利用されています。閉じません**"
    exit 1
  fi

  printf '\n前任のペイン %s を閉じます（board・登記・イベントログ・worktree・PR には触れません）。\n' "$RETIRE_PRED"
  if "$OE_HANDOFF_TMUX" kill-pane -t "$RETIRE_PRED" 2>/dev/null; then
    printf '閉じました。\n'
  else
    err "閉じられませんでした（既に不在かもしれません）"
    exit 1
  fi
  # 停止の確認は list-panes の集合所属で見る（display-message は不在でも rc=0 と空を返す）。
  # **一覧そのものが引けなかったことを「不在」に畳まない。** 畳むと、観測できていないのに
  # 「不在を確認した」と報告することになる。
  local panes_after
  if ! panes_after="$("$OE_HANDOFF_TMUX" list-panes -a -F '#{pane_id}' 2>/dev/null)"; then
    err "停止後のペイン一覧を引けませんでした。**不在を確認できていません**（kill-pane は成功しています）"
    exit 1
  fi
  if [ -z "$panes_after" ]; then
    err "停止後のペイン一覧が空でした。**不在を確認できていません**"
    exit 1
  fi
  if printf '%s\n' "$panes_after" | grep -qxF -- "$RETIRE_PRED"; then
    err "まだ生存しています: ${RETIRE_PRED}"
    exit 1
  fi
  printf '不在を確認しました（list-panes の集合所属で確認）。\n'
  printf '\n後始末（登記の掃除・worktree の掃除・issue の close）はしていません。人のゲートです。\n'
  printf '残る穴: 生きた委譲子が自分から出す報告は、前任のペインを指したまま残ります（PARENT_TMUX_PANE は張り替えられません）。\n'
  printf '        **後継が各子へ「報告の宛先は後継の pane である」と明示して伝えれば塞がります。**\n'
  printf '        挨拶では塞がりません。oe-report は PARENT_TMUX_PANE を先に読み、oe-delegate は差し替えの口を書き出さないので、\n'
  printf '        宛先が変わるのは子が新しい pane を明示して送るときだけです。\n'
  printf '前任の会話は claude --resume %s で開き直せます。\n' "$RETIRE_SID"
  exit 0
}

case "$SUB" in
  prepare) cmd_prepare ;;
  start)   cmd_start ;;
  take)    cmd_take ;;
  retire)  cmd_retire ;;
esac
