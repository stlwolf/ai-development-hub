#!/usr/bin/env bash
# oe-hookfire — 止める側のフックが直近の窓で発火したかを見る read-only 検査（#309）
#
# なぜ要るか:
#   止める側のフック3本（block-destructive / block-force-push / cc-lint）は、
#   発火したことを1行も記録していなかった。そのため「強制点が本当に発火したか」を
#   当事者以外が確かめる手段が無く、#305 のアンカー設計が3ラウンド続けて反証された。
#   3本が tally を書くようになったので、本 verb はそれを読んで判定する。
#
# 判定は3値である（oe-selfcheck と同じ契約）:
#   ok            直近の窓で発火している
#   broken        前提が崩れている（記録が失敗している・内部エラーが出ている）
#   indeterminate 検査自体が成立しなかった（**ok ではない**）
#   info          判定ではなく値の報告
#
# **累計で ok を出さない。** 「これまでに1件でもあれば ok」にすると、フックが停止した
#   後も永久に緑を返す。tally は「1バイト以上あり、かつ mtime が窓の中」のときだけ ok に
#   する（サイズ 0 を発火と読むと touch / truncate で緑になる）。deny.jsonl と diag.jsonl は
#   **行の ts** で窓を切る（ファイルの mtime で切ると、大昔の1件が今日の別イベントで蘇る）。
#
# **前回との比較（サイズ後退の検出）は行わない。** それには読み出しが状態を持つ必要があり、
#   本 verb は read-only を保つ側に倒した。単発で分かるのはサイズ 0 までである。
#
# **「記録が0件」を「発火しなかった」と読まないこと。** 0件は (a) フックが動いていない
#   (b) エージェントが Bash を使っていない（idle）(c) Codex が trust されず黙って
#   skip している、のどれでも起きる。区別できるのは意図的に撃つプローブだけなので、
#   本 verb が返す ok / indeterminate はプローブと併せて読む（手順は canonical/hooks/README.md）。
#
# **この台帳の値打ちは、読み手が実際に走ることに条件付けられている。** 定期実行の配線は
#   #301 で未着手であり、人が打つまで本 verb は動かない。溜まっているだけの台帳は
#   Sensor が埋まったことを意味しない。先例（oe-prompt-receipt.sh のヘッダ）と同じ但し書きである。
#
# read-only: 何も書き換えない。
# exit: broken が1つでもあれば 1 / broken は無いが indeterminate が在れば 2 / 全部 ok なら 0。
#   **indeterminate を exit 0 にしない。**
#
set -uo pipefail

# HOME を暗黙の既定パスに使ってよいかを決める（#322・全箇所で byte 一致させる）。
# 非空だけでは足りない: HOME=/ は //.claude/... ＝ root 直下を掴み、相対 HOME は cwd 配下へ
# state を散らす。先例（canonical/hooks/scripts/cc-lint.sh:39-41）が -n で済むのは、あちらが
# tally を 1 バイト追記するだけの best-effort だからで、state を作る engine には足りない。
declare -F _oe_home_usable >/dev/null 2>&1 || _oe_home_usable() { case "${HOME:-}" in /|//) return 1;; /*) return 0;; *) return 1;; esac; }
# _oe_state_dir <変数名> <suffix> — 明示指定（空文字も含む）を尊重 / 無ければ HOME 由来 /
# それも無ければ空。値ではなく**変数名**を受けるのは、${VAR:-} で渡すと明示的な空文字が
# 「未設定」に畳まれて既定値へ戻ってしまうためである（#322 DJ-1 と同じ理由）。
declare -F _oe_state_dir >/dev/null 2>&1 || _oe_state_dir() {
  local _n="$1"
  if   [ -n "${!_n+x}" ]; then printf '%s' "${!_n}"
  elif _oe_home_usable; then printf '%s%s' "$HOME" "$2"
  fi
}

FIRE_DIR="$(_oe_state_dir HOOK_FIRING_DIR "/.claude/state/hook-firing")"
TALLY_DIR="${FIRE_DIR}/tally"
DENY_LOG="${FIRE_DIR}/deny.jsonl"
DIAG_LOG="${FIRE_DIR}/diag.jsonl"
HOOKS="block-destructive block-force-push cc-lint"
# 3本は3ツールすべてへ配られる。期待する軸を明示して、丸ごと欠けた場合を検出する。
EXPECTED_TOOLS="${OE_HOOKFIRE_TOOLS:-claude cursor codex}"
DAYS="${OE_HOOKFIRE_DAYS:-7}"

# usage は表示だけを担う。**exit は呼び出し側が決める。**
# help は成功（0）、呼び方の誤りは 2 で、どちらも broken の帯（1）とは別に置く。
# **2 は indeterminate の帯でもあるので、そこは共有したまま残る**（分離は #301 で決める）。
usage() {
  cat >&2 <<'EOF'
usage: oe-hookfire [--days N] [--json] [-h|--help]

止める側のフックが直近の窓で発火したかを見る（read-only・何も書き換えない）。

判定:
  ok             直近の窓で発火している
  broken         前提が崩れている（記録の失敗・内部エラー）
  indeterminate  検査自体が成立しなかった（ok ではない）
  info           判定ではなく値の報告

exit: 0 → 全部 ok（-h / --help もここ）
      1 → broken≥1
      2 → 呼び方の誤り（unknown option・余分な引数・--days が非整数）
           または broken=0 かつ indeterminate≥1

**2 を見て自動で再試行しないこと。** 2 は「呼び方が違う」と「検査が成立
しなかった」を兼ねている。前者は人が直すまで永久に再発するので、再試行は
空振りし続ける。どちらなのかは stderr と --json にしか出ない。
判定の分離（indeterminate を別の番号へ）は #301 で決める。

「0 件 = 発火しなかった」とは読めない。idle と silent skip でも 0 になる。
配備物を通したプローブと併せて読むこと（canonical/hooks/README.md の陽性対照）。
EOF
}

JSON=0
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --days)
      # 値が無いまま shift 2 すると bash は「out of range」でシフトせず非 0 を返す。
      # -e が無いので実行は続き、$1 が --days のまま残って無限ループになる（実測で踏んだ）。
      [ "$#" -ge 2 ] || { echo "oe-hookfire: --days に値がありません" >&2; usage; exit 2; }
      DAYS="$2"; shift 2 ;;
    --days=*) DAYS="${1#--days=}"; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "oe-hookfire: unknown option: $1" >&2; usage; exit 2 ;;
  esac
done
# **残余引数を黙って捨てない。** ループはハイフンで始まらない引数で抜けるので、
# 検査しないと `oe-hookfire foo --bogus` が --bogus を読まずに判定表を出す
# （help も同様に効かない）。呼び方の誤りが正当な観測に化ける経路なので弾く。
[ "$#" -eq 0 ] || { echo "oe-hookfire: unexpected argument: $1" >&2; usage; exit 2; }
case "$DAYS" in ''|*[!0-9]*) echo "oe-hookfire: --days は整数" >&2; exit 2 ;; esac

# 窓の下限を ISO 8601 の日付で作る。ts は ISO なので文字列比較で足りる。
# date の相対指定は BSD（-v-Nd）と GNU（-d 'N days ago'）で非互換なので両方試す。
CUTOFF="$(date -u -v-"${DAYS}"d +%Y-%m-%dT00:00:00Z 2>/dev/null \
          || date -u -d "${DAYS} days ago" +%Y-%m-%dT00:00:00Z 2>/dev/null \
          || printf '0000-01-01T00:00:00Z')"

ROWS=()
BROKEN=0
INDET=0
add() { # add <name> <verdict> <detail>
  ROWS+=("$1"$'\037'"$2"$'\037'"$3")
  [[ "$2" == "broken" ]] && BROKEN=$((BROKEN + 1))
  [[ "$2" == "indeterminate" ]] && INDET=$((INDET + 1))
  return 0
}

# サイズは wc -c で取る。stat は BSD（-f %z）と GNU（-c %s）で非互換なので分岐が要る。
# **読めなかったことを 0 に潰さない。** 空ファイルと読めないファイルは別物で、
# 潰すと「読めないが mtime は新しい」tally を「0 件」と報告してしまう。
# 読めないときは空文字を返し、呼び出し側が indeterminate に振る。
size_of() {
  local v
  v="$(wc -c < "$1" 2>/dev/null)" || { printf ''; return 1; }
  printf '%s' "${v// /}"
}

# jsonl を行ごとに読み、filter に当たる行の件数を返す。
# **jq の失敗を 0 件に潰さない。** `jq ... | wc -l` の形だと、権限・IO エラーで jq が
# 落ちても wc が 0 を返し、ok「0 件」に化ける（#530）。件数は jq 自身に数えさせて
# 終了コードを拾い、失敗したら空文字を返す（size_of と同じ決まり）。
# fromjson? で壊れた行は黙って飛ばす（1行の破損で以降が読めなくなるのを避ける）。
count_jsonl() { # count_jsonl <log> <jq の select 式> [jq の追加引数...]
  local log="$1" sel="$2" v
  shift 2
  v="$(jq -nR "$@" "[inputs | fromjson? | ${sel}] | length" "$log" 2>/dev/null)" \
    || { printf ''; return 1; }
  case "$v" in ''|*[!0-9]*) printf ''; return 1 ;; esac
  printf '%s' "$v"
}

# ログの置かれ方を分ける。unreachable（置き場のディレクトリを辿れない）/ absent /
# dangling（壊れた symlink）/ notfile（ディレクトリ・FIFO など。FIFO を jq で読むと
# 書き手が来るまで止まる）/ file。
# **壊れた symlink を「無い」と読まない。** -f も -e も解決先で判定するので、
# 壊れた symlink は「ファイルが無い」の分岐に落ちて ok を出していた（#530）。
# 途中のディレクトリに検索権限が無いときも -e は偽になるので、先に分けておく。直上だけでなく
# 祖先も見る: 在ると確かめられる最も近い祖先まで遡り、そこを辿れなければ unreachable である。
log_state() {
  local d up
  d="$(dirname "$1")"
  while [ ! -e "$d" ] && [ ! -L "$d" ]; do
    up="$(dirname "$d")"
    [ "$up" = "$d" ] && break
    d="$up"
  done
  if [ -d "$d" ] && [ ! -x "$d" ]; then printf 'unreachable'
  elif [ -L "$1" ] && [ ! -e "$1" ]; then printf 'dangling'
  elif [ ! -e "$1" ]; then printf 'absent'
  elif [ ! -f "$1" ]; then printf 'notfile'
  else printf 'file'
  fi
}
# log_state の結果を判定表に書く言葉にする。
log_state_label() {
  case "$1" in
    dangling)    printf '壊れた symlink' ;;
    unreachable) printf '在るかどうか分からない（置き場までのディレクトリを辿れない）' ;;
    *)           printf '通常のファイルでない（ディレクトリ・FIFO など）' ;;
  esac
}

# mtime が直近 $DAYS 日の中か。find -newermt は GNU 依存なので使わない。
fresh() { [ -n "$(find "$1" -type f -mtime "-${DAYS}" 2>/dev/null)" ]; }

# --- 1. 記録機構そのものが在るか（陽性対照が取れる状態か）---
if [ ! -d "$TALLY_DIR" ]; then
  add "tally-store" "indeterminate" \
    "$( [ -n "$FIRE_DIR" ] \
        && printf '%s が無い。フックが一度も発火していないか、配備されていない' "$TALLY_DIR" \
        || printf '記録先が決まらない（HOME 未設定・HOOK_FIRING_DIR も未指定）' )。0 件を「危険な操作が無かった」と読まないこと"
else
  found="$(find "$TALLY_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$found" = "0" ]; then
    add "tally-store" "indeterminate" "tally が1件も無い。検査が成立しない"
  else
    add "tally-store" "ok" "${found} 個の tally がある"
  fi
fi

# --- 2. ツール × フックごとの発火（窓で判定する）---
# **存在するディレクトリだけを回さない。** それだと Cursor / Codex が丸ごと未配備でも
# 行が1つも出ず exit 0 に到達する（＝いちばん恐れている silent skip が緑になる）。
# 期待するツールを先に列挙し、無ければ無いことを indeterminate として言う。
TOOLS_SEEN=""
if [ -d "$TALLY_DIR" ]; then
  for tool_dir in "$TALLY_DIR"/*; do
    [ -d "$tool_dir" ] || continue
    TOOLS_SEEN="${TOOLS_SEEN}$(basename "$tool_dir") "
  done
fi
for tool in $EXPECTED_TOOLS; do
  case " $TOOLS_SEEN " in
    *" $tool "*) ;;
    *) add "fire/${tool}" "indeterminate" \
         "このツールの記録が1件も無い。未配備・未登録・trust されず skip・単にそのツールを使っていない、のどれかは これだけでは決まらない" ;;
  esac
done
if [ -d "$TALLY_DIR" ]; then
  for tool_dir in "$TALLY_DIR"/*; do
    [ -d "$tool_dir" ] || continue
    tool="$(basename "$tool_dir")"
    # unknown はツールではない。3節（tool-attribution）が窓で見るので、ここで行を足さない。
    [ "$tool" = "unknown" ] && continue
    for hook in $HOOKS; do
      a="${tool_dir}/${hook}.allow"
      d="${tool_dir}/${hook}.deny"
      if [ ! -e "$a" ] && [ ! -e "$d" ]; then
        add "fire/${tool}/${hook}" "indeterminate" "このツールでの記録が無い"
        continue
      fi
      na=0; nd=0; unreadable=0
      if [ -f "$a" ]; then na="$(size_of "$a")" || unreadable=1; fi
      if [ -f "$d" ]; then nd="$(size_of "$d")" || unreadable=1; fi
      [ -n "$na" ] || { na=0; unreadable=1; }
      [ -n "$nd" ] || { nd=0; unreadable=1; }
      if [ "$unreadable" = "1" ]; then
        add "fire/${tool}/${hook}" "indeterminate" "tally を読めなかった（権限・IO）。0 件と区別できない"
        continue
      fi
      # **サイズ 0 を「発火した」と読まない。** mtime だけで判定すると、truncate や
      # touch でセンサーが緑になる。1バイト以上あって、かつ mtime が窓の中のときだけ ok。
      if [ $(( na + nd )) -eq 0 ]; then
        add "fire/${tool}/${hook}" "indeterminate" \
          "記録ファイルは在るが中身が 0 件。truncate されたか、書き込みに失敗している"
      elif { [ -s "$a" ] && fresh "$a"; } || { [ -s "$d" ] && fresh "$d"; }; then
        add "fire/${tool}/${hook}" "ok" "直近 ${DAYS} 日に発火（累計 allow=${na} deny=${nd}）"
      else
        add "fire/${tool}/${hook}" "indeterminate" \
          "直近 ${DAYS} 日の発火が無い（累計 allow=${na} deny=${nd}）。停止か idle か skip かはこれだけでは決まらない"
      fi
    done
  done
fi

# --- 3. unknown へ落ちていないか ---
# $0 によるツール判別は、ホストが解決済みの絶対パスで起動する形に変われば静かに
# unknown へ落ちる。**静かに消えるのが本 issue の敵**なので、件数を必ず表に出す。
# **broken は窓で切る（#529）。** 累計で判定すると、手でのプローブ1回で unknown に落ちた記録が
# 残るかぎり、判別が正しく動いていても broken を出し続ける（internal-error で踏んだのと同じ形）。
# 窓の中に1バイト以上ある unknown の tally があるときだけ broken にし、窓の外だけなら累計を
# 表に出したうえで ok にする。サイズ 0 は記録ではない（2節と同じ）が、窓の中で 0 なら truncate か
# 書き込みの失敗で、unknown に落ちたことを消している可能性があるので ok にもしない。
# **窓で切ると、見落としが ok に化ける。** 変更前は unknown が在るだけで broken だったので、
# 数え方の取りこぼしは表に出なかった。そこで次の形で数える（実装SO の指摘）。
#   - 件数は find 自身の述語で数え、-print0 の NUL を数える（ファイル名の改行で割れない）
#   - -L で symlink を辿る（フックの >> は symlink の先へ追記できる）。-L の下でも型が l のまま
#     残るのは辿れない symlink なので、1つでもあれば indeterminate（Copilot の指摘）
#   - find・cat が1つでも失敗したら indeterminate（読めないときは 0 件に潰さない・#530）
#   - 入口は log_state で分ける（祖先を辿れない・壊れた symlink を「無い」と読まない）
UNKNOWN_DIR="${TALLY_DIR}/unknown"
# count_files <型> [find の述語...] — UNKNOWN_DIR の下で型（f / l）と述語に当たるものの数。
# 失敗したら空文字。
count_files() {
  local v t="$1"
  shift
  v="$(find -L "$UNKNOWN_DIR" -type "$t" "$@" -print0 2>/dev/null | tr -cd '\000' | wc -c)" \
    || { printf ''; return 1; }
  printf '%s' "${v// /}"
}
st="$(log_state "$UNKNOWN_DIR")"
if [ "$st" = "absent" ]; then
  add "tool-attribution" "ok" "unknown へ落ちた記録は無い"
elif [ "$st" = "unreachable" ] || [ "$st" = "dangling" ] || [ ! -d "$UNKNOWN_DIR" ]; then
  add "tool-attribution" "indeterminate" \
    "unknown が$(log_state_label "$st")。ツール不明の記録が在るかどうか分からない"
elif ! n="$(count_files f)" \
     || ! ndang="$(count_files l)" \
     || ! nfresh="$(count_files f -size +0 -mtime "-${DAYS}")" \
     || ! nzero="$(count_files f -size 0 -mtime "-${DAYS}")" \
     || ! tot="$(find -L "$UNKNOWN_DIR" -type f -exec cat {} + 2>/dev/null | wc -c)"; then
  add "tool-attribution" "indeterminate" "unknown の記録を読めなかった（権限・IO）。窓の中に在るかどうか分からない"
else
  tot="${tot// /}"
  if [ "$nfresh" -eq 0 ] && [ "$ndang" -gt 0 ]; then
    add "tool-attribution" "indeterminate" \
      "unknown の下に辿れない symlink が ${ndang} 個ある。その先に記録が在るかどうか分からない"
  elif [ "$n" -eq 0 ]; then
    add "tool-attribution" "ok" "unknown へ落ちた記録は無い（unknown のディレクトリは在るが空）"
  elif [ "$nfresh" -gt 0 ]; then
    add "tool-attribution" "broken" \
      "直近 ${DAYS} 日にツール不明の記録がある（${nfresh} ファイル。累計 ${n} ファイル・計 ${tot} 件）。\$0 による判別が効いていない（ホストの起動パスが変わった疑い）"
  elif [ "$nzero" -gt 0 ]; then
    add "tool-attribution" "indeterminate" \
      "直近 ${DAYS} 日に更新された unknown の tally が在るが中身が 0 件（${nzero} ファイル）。truncate されたか、書き込みに失敗している"
  else
    add "tool-attribution" "ok" \
      "直近 ${DAYS} 日に unknown へ落ちた記録は無い（窓の外に累計 ${n} ファイル・計 ${tot} 件）"
  fi
fi

# --- 4. 記録そのものが失敗していないか ---
st="$(log_state "$DIAG_LOG")"
# shellcheck disable=SC2016  # $cut は jq の変数（--arg で渡す）なので展開させない
if [ "$st" = "absent" ]; then
  add "record-health" "ok" "記録の失敗は記録されていない"
elif [ "$st" != "file" ]; then
  add "record-health" "indeterminate" \
    "diag.jsonl が$(log_state_label "$st")。記録の失敗が 0 件かどうか分からない"
elif ! command -v jq >/dev/null 2>&1; then
  add "record-health" "indeterminate" "jq が無いので ts で窓を切れない"
elif ! n="$(count_jsonl "$DIAG_LOG" 'select((.ts? // "") >= $cut)' --arg cut "$CUTOFF")"; then
  add "record-health" "indeterminate" "diag.jsonl を読めなかった（権限・IO）。0 件と区別できない"
else
  if [ "$n" -gt 0 ]; then
    add "record-health" "broken" \
      "直近 ${DAYS} 日に記録の失敗が ${n} 件ある。この間の tally は過小なので ok の根拠に使えない"
  else
    add "record-health" "ok" "直近 ${DAYS} 日の記録失敗は 0 件"
  fi
fi

# --- 5. 内部エラーが deny へ収束していないか（trap の発火率）---
# **窓は行の ts で切る。** ファイルの mtime + 累計件数で判定すると、大昔の1件が
# 残ったまま今日の通常 deny で mtime が新しくなるだけで broken を出し続ける（実測で踏んだ）。
st="$(log_state "$DENY_LOG")"
# shellcheck disable=SC2016  # $cut は jq の変数（--arg で渡す）なので展開させない
if [ "$st" = "absent" ]; then
  add "internal-error" "indeterminate" "deny.jsonl が無い。deny が一度も起きていないだけかもしれない"
elif [ "$st" != "file" ]; then
  add "internal-error" "indeterminate" \
    "deny.jsonl が$(log_state_label "$st")。内部エラーが 0 件かどうか分からない"
elif ! command -v jq >/dev/null 2>&1; then
  add "internal-error" "indeterminate" "jq が無いので ts で窓を切れない"
elif ! n="$(count_jsonl "$DENY_LOG" \
              'select((.rule? == "internal-error") and (.ts? // "") >= $cut)' --arg cut "$CUTOFF")" \
     || ! tot="$(count_jsonl "$DENY_LOG" 'select(.rule? == "internal-error")')"; then
  add "internal-error" "indeterminate" "deny.jsonl を読めなかった（権限・IO）。0 件と区別できない"
else
  if [ "$n" -gt 0 ]; then
    add "internal-error" "broken" \
      "直近 ${DAYS} 日に内部エラーで deny へ収束した記録が ${n} 件ある（累計 ${tot} 件）。フックが壊れている疑い"
  else
    add "internal-error" "ok" "直近 ${DAYS} 日の内部エラーは 0 件（累計 ${tot} 件）"
  fi
fi

# --- 6. 3本の allow が揃っているか（設定を読まずに脱落を局在化する）---
# 3本は同じイベントに配線されているので allow はほぼ同数になるはず。
# ただし deny 後の短絡や逐次/並行の違いでズレうるため、判定は info に留める。
if [ -d "$TALLY_DIR" ]; then
  for tool_dir in "$TALLY_DIR"/*; do
    [ -d "$tool_dir" ] || continue
    tool="$(basename "$tool_dir")"
    [ "$tool" = "unknown" ] && continue
    counts=""; min=""; max=""
    for hook in $HOOKS; do
      f="${tool_dir}/${hook}.allow"
      c=0; if [ -f "$f" ]; then c="$(size_of "$f")" || c=0; fi; [ -n "$c" ] || c=0
      counts="${counts}${hook}=${c} "
      [ -z "$min" ] && { min="$c"; max="$c"; }
      [ "$c" -lt "$min" ] && min="$c"
      [ "$c" -gt "$max" ] && max="$c"
    done
    add "cross-check/${tool}" "info" "allow の内訳: ${counts}(最小 ${min} / 最大 ${max})"
  done
fi

# --- 出力 ---
if [ "$JSON" = "1" ]; then
  printf '['
  first=1
  for row in "${ROWS[@]}"; do
    IFS=$'\037' read -r n v d <<< "$row"
    [ "$first" = "1" ] || printf ','
    first=0
    if command -v jq >/dev/null 2>&1; then
      jq -cn --arg n "$n" --arg v "$v" --arg d "$d" '{name:$n,verdict:$v,detail:$d}' | tr -d '\n'
    else
      printf '{"name":"%s","verdict":"%s"}' "$n" "$v"
    fi
  done
  printf ']\n'
else
  printf '窓: 直近 %s 日 / 記録先: %s\n\n' "$DAYS" "${FIRE_DIR:-（決まらない: HOME 未設定）}"
  for row in "${ROWS[@]}"; do
    IFS=$'\037' read -r n v d <<< "$row"
    printf '  %-14s %-28s %s\n' "$v" "$n" "$d"
  done
  printf '\n'
  if [ "$BROKEN" -gt 0 ]; then
    printf '判定: broken %s 件。前提が崩れている\n' "$BROKEN"
  elif [ "$INDET" -gt 0 ]; then
    printf '判定: indeterminate %s 件。検査が成立していない（ok ではない）\n' "$INDET"
  else
    printf '判定: すべて ok\n'
  fi
  printf '注意: 0 件は「発火しなかった」ではない。idle と silent skip でも 0 になる。\n'
  printf '      配備物を通したプローブと併せて読むこと（canonical/hooks/README.md の陽性対照）。\n'
fi

[ "$BROKEN" -gt 0 ] && exit 1
[ "$INDET" -gt 0 ] && exit 2
exit 0
