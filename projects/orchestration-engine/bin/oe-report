#!/usr/bin/env bash
# oe-report — 親 Claude セッションへ申し送り / レビュー依頼を送る
#
# usage: oe-report [--review] <message>
#
# 親ペイン ID の解決順:
#   1. 環境変数 PARENT_TMUX_PANE（oe-delegate が子へ渡す。これが主経路）
#   2. /tmp/oe-parent-{TMUX_PANE#%} ファイル（手動設定時のみ。oe-delegate は書き出さない）
# どちらもなければエラー終了（exit 1）。
# 注: 戻しは汎用 oe-send への一本化が方針。本コマンドは legacy（整理は #142 論点E）。
# 送信は oe_send_line（delegate-send.sh）経由 — 生 send-keys 時代は message_sent を emit せず
# 活動ログ（inbox / report_received ループ・#206A）の盲点だった。載せ替えで 1 行保証・
# 死ペイン検知・copy-mode 解除・finalize・message_sent emit が oe-send と同じに揃う（#142 の部分前倒し）。

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/delegate-send.sh
source "${BIN_DIR}/../lib/delegate-send.sh"

usage() {
  cat >&2 <<'EOF'
usage: oe-report [--review] <message>

  <message>   1行の申し送りテキスト（必須）
  --review    レビュー依頼として送る（プレフィックスが "レビュー依頼:" になる）
  -h, --help  このヘルプを表示

親ペイン ID の解決:
  1. 環境変数 PARENT_TMUX_PANE（oe-delegate が子へ渡す）
  2. /tmp/oe-parent-{TMUX_PANE#%} ファイル（手動設定時のみ。oe-delegate は書き出さない）

注: 戻しは oe-send に一本化が方針。本コマンドは legacy。
EOF
  exit 1
}

REVIEW=0
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --review) REVIEW=1; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    *) echo "oe-report: unknown option: $1" >&2; usage ;;
  esac
done

MESSAGE="${1:-}"
[[ -n "$MESSAGE" ]] || { echo "oe-report: message argument is required" >&2; usage; }

# 親ペイン ID を解決
PARENT_PANE="${PARENT_TMUX_PANE:-}"

if [[ -z "$PARENT_PANE" ]]; then
  SELF_PANE="${TMUX_PANE:-}"
  if [[ -n "$SELF_PANE" ]]; then
    PARENT_FILE="/tmp/oe-parent-${SELF_PANE#%}"
    if [[ -f "$PARENT_FILE" ]]; then
      PARENT_PANE="$(cat "$PARENT_FILE")"
    fi
  fi
fi

[[ -n "$PARENT_PANE" ]] || {
  echo "oe-report: parent pane not found — set PARENT_TMUX_PANE or run via oe-delegate" >&2
  exit 1
}

# メッセージを組み立てて送信（1 行保証・emit 込みの oe_send_line。失敗は rc をそのまま返す）
if [[ "$REVIEW" -eq 1 ]]; then
  PREFIX="レビュー依頼"
else
  PREFIX="申し送り"
fi

oe_send_line "$PARENT_PANE" "${PREFIX}: ${MESSAGE}"
