#!/usr/bin/env bash
# oe-threads — 生存ペインごとに Claude スレッドのモデル名とコンテキスト% を出す read-only 観測 verb (#327)
#
# usage:
#   oe-threads                    自 server の生存ペイン + pane を持たない fresh スレッド
#   oe-threads --all              全 sidecar を AGE つきで出す（鮮度で絞らない・墓地も見える）
#   oe-threads --fresh <sec>      帰属を解決する鮮度窓（既定 900）
#   oe-threads -h | --help
#
# read-only / 非検出: 読むのは (1) statusLine 拍動 sidecar（OE_HEARTBEAT_DIR）(2) tmux のペイン存在
#   （mux query）(3) pane-issue / spawn-registry の state ファイル のみ。write path は一切持たず、
#   ペイン出力も読まない（capture 走査・自動反応はしない）。この列挙は閉じた集合として固定する
#   （#177 / #188 の read-only 観測規律・oe-tree:40-44 と同じ宣言）。
#
# 母集団（DJ-A）: 自 server の生存ペインを左辺にした左外部結合。sidecar 側から列挙しない。
#   sidecar は同じ pane に何日分も溜まる（実測: %0 に7件・うち6件が約4日前）ので、sidecar 起点だと
#   生きているペインほど墓地が増えて一覧が使えなくなる。左辺を生存ペインにすると行数はペイン数で
#   固定される。pane を持たない fresh な sidecar だけは末尾に unbound 行として足す（pane が伝播
#   しない環境のスレッドを落とさないため）。
#
# 鮮度の使い分け（DJ-B）: 行を落とすのには使わない / 帰属の解決には使う。生存ペインの行は鮮度に
#   関係なく常に出る（静かなスレッドが消えない）。一方どの sidecar をそのペインの現役とみなすかは
#   鮮度窓で決める（古い sidecar は候補にしない）。
#
# 帰属の曖昧さ（DJ-C）: fresh な候補が1件なら値を出す。2件以上なら PANE に ? を付けて値は出さない
#   （最新で潰さない — pane 再利用の誤帰属を「解決済み」に見せない）。0件なら値は - にする。
#
# server identity（DJ-D）: 突合は server_pid と pane の組で行う。pane 番号は tmux server 内でのみ
#   一意なので、pane だけでは別 server の同番ペインと衝突する。sidecar 側の server_pid が空のもの
#   （producer 更新前に書かれた記録・TMUX 不在で書かれた記録）は pane だけで突合する劣化動作とし、
#   非空で不一致のものは候補にしない。
#
# 列（DJ-E）: PANE / CTX / AGE / MODEL / LABEL。MODEL は幅で切らない（display_name の末尾に
#   1M 版の区別が載るため）。可変幅が2列あるので、切らない MODEL に最小幅を与え、溢れは最後の
#   LABEL 側へ逃がす（oe-tree:529 と同じ「長い値は溢れてよい」degrade）。
#
# exit: 0 正常 / 2 前提が満たせない（jq 不在・置き場が決まらない・tmux 不在や list-panes 失敗）。
#   空表を「0 件」として exit 0 で返さない（読めていないことを成功に化かさない・#322 DJ-3）。

set -uo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "${BIN_DIR}/.." && pwd)"
# shellcheck source=../lib/delegate-registry.sh
source "${PROJECT_DIR}/lib/delegate-registry.sh"

err() { printf 'oe-threads: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF' >&2
usage:
  oe-threads                  自 server の生存ペイン + pane を持たない fresh スレッド
  oe-threads --all            全 sidecar を AGE つきで出す（鮮度で絞らない）
  oe-threads --fresh <sec>    帰属を解決する鮮度窓（既定 900・OE_THREADS_FRESH_SEC でも指定可）
  oe-threads -h | --help

読むのは sidecar / tmux のペイン存在 / pane-issue だけで、書き込みはしない。
EOF
}

DEFAULT_FRESH=900
FRESH="${OE_THREADS_FRESH_SEC:-$DEFAULT_FRESH}"
SHOW_ALL=0

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --all) SHOW_ALL=1; shift ;;
    --fresh)
      shift
      [[ -n "${1:-}" ]] || { err "--fresh は秒数（正の整数）が必要です"; usage; exit 2; }
      FRESH="$1"; shift ;;
    --fresh=*) FRESH="${1#--fresh=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) err "unknown option: $1"; usage; exit 2 ;;
  esac
done
[[ $# -eq 0 ]] || { err "unexpected argument: $1"; usage; exit 2; }
[[ "$FRESH" =~ ^[0-9]+$ && "$FRESH" -gt 0 ]] || { err "fresh は正の整数（秒）: got [$FRESH]"; usage; exit 2; }

command -v jq >/dev/null 2>&1 || { err "jq が必要です（sidecar の投影に使用）"; exit 2; }

# --- sidecar の置き場（producer と同じ env ノブ・#322 の帯）---
declare -F _oe_home_usable >/dev/null 2>&1 || _oe_home_usable() { case "${HOME:-}" in /|//) return 1;; /*) return 0;; *) return 1;; esac; }
declare -F _oe_state_dir >/dev/null 2>&1 || _oe_state_dir() {
  local _n="$1"
  if   [ -n "${!_n+x}" ]; then printf '%s' "${!_n}"
  elif _oe_home_usable; then printf '%s%s' "$HOME" "$2"
  fi
}
BEAT_DIR="$(_oe_state_dir OE_HEARTBEAT_DIR "/.claude/state/oe-heartbeat")"
if [[ -z "$BEAT_DIR" ]]; then
  err "sidecar の置き場が決まりません（HOME 未設定・OE_HEARTBEAT_DIR も未指定）"
  exit 2
fi

NOW="${NOW_EPOCH:-$(date +%s 2>/dev/null)}"
[[ "$NOW" =~ ^[0-9]+$ ]] || { err "現在時刻が取れません"; exit 2; }

SERVER_PID="$(_oe_reg_server_pid 2>/dev/null || true)"

# _oe_reg_label が global で返す2値（bash 3.2 に nameref が無いため・lib 側で毎回リセットされる）。
# 呼び出し前に宣言しておく（source 先の代入は shellcheck から見えないため）。
_oe_reg_label_out=""
_oe_reg_source_out=""

# --- 表示用 sanitize ---
# 制御文字は tr の8進レンジで空白へ畳む（jq の \u レンジ表記を使わない＝生バイト混入の経路を避ける）。
# その後 codepoint 上限で切る。上限は表示崩れの防止であって MODEL の幅切りではない（実データは
# 19 文字級で上限に当たらない）。jq -Rrs は末尾改行を含むので rtrimstr で落とす。
_out() { # <text> [max_cp]
  local max="${2:-200}" s
  s="$(printf '%s' "$1" | LC_ALL=C tr '\000-\037\177' ' ')"
  printf '%s' "$s" | jq -Rrs --argjson max "$max" \
    'rtrimstr("\n") | if (length > $max) then (.[0:$max] + "...") else . end' 2>/dev/null \
    || printf '%s' "$s"
}

_age() { # <seconds>
  local s="$1"
  if   [[ "$s" -lt 0 ]];     then printf 'future'
  elif [[ "$s" -lt 60 ]];    then printf '%ds' "$s"
  elif [[ "$s" -lt 3600 ]];  then printf '%dm' "$((s / 60))"
  elif [[ "$s" -lt 86400 ]]; then printf '%dh' "$((s / 3600))"
  else                            printf '%dd' "$((s / 86400))"
  fi
}

# --- sidecar を1件ずつ投影して集める（壊れた JSON は個別に skip・oe-vitals と同型）---
# レコードの区切りは US(0x1f)。@tsv で1行1レコードにしてから TAB を US へ変換する。
#   - @tsv は値の中の TAB / 改行 / バックスラッシュをエスケープするので、変換後の US は区切りだけになる。
#   - 区切りに TAB を使ってはいけない。TAB は IFS の空白文字なので read が連続する区切りを1つに畳み、
#     空フィールド（pane 空の unbound / server_pid 空の旧 sidecar / ctx 非数値）で列がずれる。US は
#     非空白なので空フィールドが保たれる（oe-tree の ENTRIES と同じ区切り）。
_US="$(printf '\037')"
RECS=()
shopt -s nullglob
for _f in "$BEAT_DIR"/*.json; do
  _line="$(jq -r 'select(type=="object")
      | [ (input_filename | split("/") | last | sub("\\.json$"; "")),
          (.ts // 0),
          (if (.context_pct | type) == "number" then (.context_pct | tostring) else "" end),
          (.pane // ""),
          (.server_pid // ""),
          (if (.model | type) == "object" then (.model.display_name // "") else "" end) ]
      | @tsv' "$_f" 2>/dev/null | tr '\011' '\037')" || continue
  [[ -n "$_line" ]] || continue
  RECS+=("$_line")
done
shopt -u nullglob

# --- --all: 鮮度で絞らず全件を出す ---
if [[ "$SHOW_ALL" -eq 1 ]]; then
  printf '%-8s %-6s %5s %6s  %-20s %s\n' "PANE" "SRVPID" "CTX" "AGE" "MODEL" "SESSION"
  for _r in ${RECS[@]+"${RECS[@]}"}; do
    IFS="$_US" read -r _sid _ts _ctx _pane _spid _model <<< "$_r"
    [[ "$_ts" =~ ^[0-9]+$ ]] || _ts=0
    printf '%-8s %-6s %5s %6s  %-20s %s\n' \
      "${_pane:--}" "${_spid:--}" "${_ctx:--}" "$(_age "$((NOW - _ts))")" \
      "$(_out "${_model:--}" 60)" "${_sid:0:8}"
  done
  exit 0
fi

# --- 既定: 自 server の生存ペインを左辺にする ---
LIVE=""
if ! LIVE="$(tmux list-panes -a -F '#{pane_id}' 2>&1)"; then
  err "tmux のペイン一覧が取れません（tmux 不在 / server 不通）: ${LIVE}"
  exit 2
fi

printf '%-8s %5s %6s  %-20s %s\n' "PANE" "CTX" "AGE" "MODEL" "LABEL"

while IFS= read -r _p; do
  [[ -n "$_p" ]] || continue
  _n=0; _ts=0; _ctx=""; _model=""
  for _r in ${RECS[@]+"${RECS[@]}"}; do
    IFS="$_US" read -r _rsid _rts _rctx _rpane _rspid _rmodel <<< "$_r"
    [[ "$_rpane" == "$_p" ]] || continue
    [[ "$_rts" =~ ^[0-9]+$ ]] || continue
    # server identity: 非空で不一致なら候補にしない（別 server の同番ペインを誤帰属しない）
    if [[ -n "$_rspid" && -n "$SERVER_PID" && "$_rspid" != "$SERVER_PID" ]]; then continue; fi
    # 鮮度窓の外は候補にしない（帰属の解決にだけ鮮度を使う）
    [[ $((NOW - _rts)) -le "$FRESH" && $((NOW - _rts)) -ge 0 ]] || continue
    _n=$((_n + 1))
    _ts="$_rts"; _ctx="$_rctx"; _model="$_rmodel"
  done

  _oe_reg_label "$_p" "" 0
  _label="$(_out "$_oe_reg_label_out" 120)"

  if [[ "$_n" -eq 1 ]]; then
    printf '%-8s %5s %6s  %-20s %s\n' \
      "$_p" "${_ctx:--}" "$(_age "$((NOW - _ts))")" "$(_out "${_model:--}" 60)" "$_label"
  elif [[ "$_n" -gt 1 ]]; then
    # 曖昧: 最新で潰さず、値を出さない（どれが現役か決められないことを表示で示す）
    printf '%-8s %5s %6s  %-20s %s\n' "${_p}?" "-" "-" "ambiguous(${_n})" "$_label"
  else
    printf '%-8s %5s %6s  %-20s %s\n' "$_p" "-" "-" "-" "$_label"
  fi
done <<< "$LIVE"

# --- pane を持たない fresh スレッドを末尾に足す（落とさない）---
for _r in ${RECS[@]+"${RECS[@]}"}; do
  IFS="$_US" read -r _rsid _rts _rctx _rpane _rspid _rmodel <<< "$_r"
  [[ -z "$_rpane" ]] || continue
  [[ "$_rts" =~ ^[0-9]+$ ]] || continue
  [[ $((NOW - _rts)) -le "$FRESH" && $((NOW - _rts)) -ge 0 ]] || continue
  printf '%-8s %5s %6s  %-20s %s\n' \
    "-" "${_rctx:--}" "$(_age "$((NOW - _rts))")" "$(_out "${_rmodel:--}" 60)" \
    "unbound session ${_rsid:0:8}"
done

exit 0
