#!/usr/bin/env bash
# oe-tree — spawn トポロジ（親→子→孫）を read-only でツリー表示する（#221 / live 化 #223 / 対話ナビ #227）
#
# usage: oe-tree [--watch [--interval N]] | [--pick]
#
# spawn registry（~/.claude/state/oe-delegate/）の現 tmux server 分を走査し、
# parent_pane 連鎖から森林を再構成して罫線ツリーで表示する。oe-list が flat な
# 宛先候補（自分の直下の子に scoping）なのに対し、oe-tree は「何が何を立てたか」
# 「どのペインが孫か」を現 server 全域で描く観測ビュー（oe-activity / oe-status と
# 同クラス）。--watch で poll 再描画の live 表示（tmux popup からの常用を想定・#223）。
#
# --pick（対話ナビ・#227）: 森ツリーからノードを fzf で選び、その %N へ oe-jump で
#   focus（jump ロジックは再利用・複製しない）→ 対象 window を resize-pane -Z で最大化する。
#   prefix+g の session picker のトポロジ版 + 最大化。森構築/描画は本ツールの既存ロジックを
#   内部モード --pick-list（%N<TAB>表示行 を emit）で再利用し、新規に足すのは fzf 選択 +
#   ensure-zoomed のみ。fzf 非在時は番号フォールバック（oe-select 同型）。
#   jump/zoom は「ユーザーが明示的に命じるナビ」＝受動検出でも自動作用でもなく、registry/
#   トポロジのデータは編集しない（#221/#223 の read-only 不変条件は保たれる・prefix+g picker が
#   select-pane するのと同カテゴリ）。純ビュー（引数なし / --watch）はデフォルトで温存。
#
# 意味論（設計SO で明文化を要求された点・DJ-221-2/6）:
#   - 本ビューは「現在の登記のスナップショット」であり歴史ではない。gone entry は
#     次の oe_reg_record 時の GC まで表示される（read-only ではデータ源の性質を
#     変えられない）。--watch でも同じ: kill は alive→gone の遷移として反映され、
#     ノードがツリーから消えるのは次 spawn の GC 時（DJ-223-10・hg-1 受入済み）。
#     spawn の歴史フローは oe-activity（event log）の領分。
#   - liveness は oe-activity と同じ mux 存在 query（tmux list-panes -a 突合）:
#     pane が在る=alive / 無い=gone / query 失敗=?（degrade・観測は止めない）。
#     同じ 1 コールの format 拡張で tmux 座標（session:window.pane）も取り、%N より前に
#     表示する（DJ-223-11 + hg-2: 人間の導線 = window/pane 番号が先・%N は oe-send /
#     oe-jump / oe-list との突合キーとして併記維持。gone/不明は "-" — tmux 上に存在
#     しない pane に座標は無い）。session: は複数セッション時のみ前置（適応表示）。
#     並びは画面配置順（session→window→pane 昇順・座標なしは末尾に pane 番号順）。
#   - root 親は registry に entry を持たない（parent_pane 参照としてのみ現れる）
#     ため合成し、ラベルは pane-issue > pane_title(alive のみ) > "?"（honest —
#     無い物を捏造しない。oe-ident と同方針）。
#   - role 列は持たない: ツリーは関係そのものを描くため parent/child は木の形が
#     搬送する（oe-ident が role を前置するのは単一ペインの孤立表示だから）。
#
# read-only / 非検出: 読むのは (1) registry / pane-issue の state ファイル
#   (2) tmux のペイン存在・座標・pane_title（mux query）(3) statusLine 拍動 sidecar
#   （OE_HEARTBEAT_DIR・#327）のみ。oe_reg_gc 等の write path は一切呼ばない
#   （#177 / #188 の read-only 観測規律）。--watch の poll はこの read セットを
#   反復するだけで「何を読むか」の線は動かさない（capture 走査・自動反応に踏み込まない —
#   oe-status DJ-1(c) が守った非検出境界との整合 = DJ-223-9・hg-1 裁定済み）。
#
#   **(3) は 2026-08-30 に owner が再裁定して加えた。** それまでこの列挙は (1)(2) の2系統に
#   閉じており「裁定済み」と明記されていた。cockpit（`Ctrl+Space` → `v` の popup = 本 verb の
#   `--pick`）にモデル名とコンテキスト% を出すには第3のソースが要る、という理由による。
#   **書き込みと非検出の境界は動かしていない** — sidecar も読むだけで、ペイン出力は依然読まない。
#
# exit: 0=表示成功（登記 0 件の空表示を含む）/ 2=環境エラー（tmux scope 不能・jq 不在・
#   引数不正）。$TMUX 不在は server_pid が導出できず scoping も liveness も成立しない＝
#   部分価値を残す degrade が構造的に無いため、lib 家族の規約（oe_reg_list /
#   oe_reg_resolve）に合わせ exit 2（DJ-221-7）。--watch 中の env エラーは popup(-E) が
#   即閉じてメッセージが読めないため、TTY のときだけ 3s hold してから exit 2。

set -euo pipefail

# invoked path を symlink 解決してから lib dir を決める（~/bin 経由の symlink 起動でも
# lib を source できるように・#223 配布対応）。macOS の readlink は -f 非対応のためループで解決。
_oe_src="${BASH_SOURCE[0]:-$0}"
while [[ -h "$_oe_src" ]]; do
  _oe_dir="$(cd -P "$(dirname "$_oe_src")" && pwd)"
  _oe_src="$(readlink "$_oe_src")"
  case "$_oe_src" in /*) ;; *) _oe_src="$_oe_dir/$_oe_src" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$_oe_src")" && pwd)"
# 再帰起動（--pick の候補取得 / --watch の tick 再描画 / fzf の ctrl-r reload）用の絶対パス。
# fzf は bind を `$SHELL -c` で走らせ $0 がシェル名になるため、reload には解決済み絶対パスが要る。
OE_TREE_SELF="${BIN_DIR}/$(basename "$_oe_src")"
# shellcheck source=../lib/delegate-registry.sh
source "${BIN_DIR}/../lib/delegate-registry.sh"

WATCH=0
PICK=0
MODE=view          # view（既定・純ビュー） / picklist（内部・--pick の候補 emit）
INTERVAL=2
INTERVAL_SET=0
usage_err() {
  echo "oe-tree: $1" >&2
  echo "usage: oe-tree [--watch [--interval N]] | [--pick]" >&2
  exit 2
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat >&2 <<'EOF'
usage: oe-tree [--watch [--interval N]] | [--pick]

spawn registry の parent_pane 連鎖から親→子→孫のトポロジを罫線ツリーで表示する
（read-only・現 tmux server の全森林）。
各ノード: <座標 win.pane|-> <pane> <liveness> <label> [~workspace] [(you)] [モデル ctx%]
（座標は複数セッション時のみ session: を前置。並びは画面配置順 = window→pane 昇順・
gone は末尾）

  --watch       poll 再描画の live 表示（q / Esc / C-c で終了）
  --interval N  --watch の更新間隔（秒・正整数・既定 2）
  --pick        対話ナビ: ノードを fzf で選び、その %N へ oe-jump で focus →
                対象 window を resize-pane -Z で最大化（fzf 非在時は番号選択）。
                enter=jump+zoom / ctrl-r=refresh / esc=cancel。--watch とは併用不可。

注: 現在の登記のスナップショット（kill は alive→gone 遷移として反映・ノードが消えるのは
次の spawn 登記時の GC）。歴史は oe-activity を参照。--pick の jump/zoom はユーザー起点の
ナビでデータは read-only のまま（registry/トポロジを編集しない）。
EOF
      exit 0 ;;
    --watch) WATCH=1 ;;
    --pick) PICK=1 ;;
    --pick-list) MODE=picklist ;;   # 内部用: --pick が候補（%N<TAB>表示行）を取るため自身を再帰起動する
    --interval)
      shift
      [[ $# -gt 0 ]] || usage_err "--interval requires a value"
      INTERVAL="$1"
      INTERVAL_SET=1 ;;
    *) usage_err "unexpected argument: $1" ;;
  esac
  shift
done
# モードは排他: 純ビュー / --watch(live) / --pick(対話) / --pick-list(内部) は 1 つだけ。
[[ "$WATCH" -eq 1 && "$PICK" -eq 1 ]] && usage_err "--pick and --watch are mutually exclusive"
[[ "$MODE" == picklist && ( "$WATCH" -eq 1 || "$PICK" -eq 1 ) ]] \
  && usage_err "--pick-list is internal and cannot be combined with --watch/--pick"
[[ "$INTERVAL_SET" -eq 1 && "$WATCH" -eq 0 ]] && usage_err "--interval requires --watch"
if [[ "$WATCH" -eq 1 ]]; then
  [[ "$INTERVAL" =~ ^[0-9]+$ && "$INTERVAL" -ge 1 ]] \
    || usage_err "--interval must be a positive integer (seconds), got: ${INTERVAL}"
fi

# watch モードの env エラーは popup(-E) が即閉じてメッセージが読めないため、
# TTY のときだけ 3s hold してから exit する（非 TTY = テスト/パイプは即 exit）。
env_fail() {
  echo "oe-tree: $1" >&2
  if [[ "$WATCH" -eq 1 && -t 0 ]]; then
    read -r -s -t 3 -n 1 2>/dev/null || true
  fi
  exit 2
}

command -v jq >/dev/null 2>&1 || env_fail "jq is required"

SERVER_PID="$(_oe_reg_server_pid)"
if [[ -z "$SERVER_PID" ]]; then
  env_fail "not inside tmux (\$TMUX is unset) — spawn registry is scoped by tmux server pid"
fi

# --- watch モード: tick ごとに自分自身（snapshot モード）を re-exec して描画（DJ-223-6）---
# 中核ロジック（森林構築・render・sanitize・#221 実装SO 3周通過）を refactor せず温存し、
# 各フレームを一発実行と厳密に同一のコードパスにする（watch と snapshot の意味論乖離を防ぐ）。
if [[ "$WATCH" -eq 1 ]]; then
  # (you) の SELF freeze: popup 内では TMUX_PANE が unset（実測・#223）。開始時の active pane
  # （= popup を開いたペイン）を 1 回だけ解決して子 re-exec へ export する。per-tick 解決は
  # フォーカス移動で (you) が drift するため凍結（DJ-223-6）。query 失敗はマーカーなし degrade。
  if [[ -z "${TMUX_PANE:-}" ]]; then
    _self="$(tmux display-message -p '#{pane_id}' 2>/dev/null)" || _self=""
    if [[ -n "$_self" ]]; then
      export TMUX_PANE="$_self"
    fi
  fi
  # alt screen + cursor hide。tput 非依存の標準シーケンス（popup / 常設ペインで同じ挙動）。
  # フレームは \e[H（home）+ 本文 + \e[J（末尾消去）— 全画面 clear のフリッカーを避ける。
  trap 'printf "\e[?25h\e[?1049l"' EXIT
  trap 'exit 0' INT TERM
  printf '\e[?1049h\e[?25l'
  while :; do
    _frame="$("$0" 2>&1)" || true # tick 失敗も出力ごと表示して観測を止めない
    _block="oe-tree --watch · interval=${INTERVAL}s · $(date +%H:%M:%S) · q/Esc: quit

${_frame}"
    # 中身の描画位置（hg-2）: TTY のときはブロックをパネル中央に置く（左上張り付きの是正）。
    # 非 TTY（テスト・パイプ）は無加工。幅は近似 wcwidth（ASCII=1 / 罫線 │├└─ =1 /
    # それ以外=2）。和文以外の非 ASCII 記号が混ざるとなお誤差は残る（表示ツールの許容誤差）。
    # サイズ取得失敗は pad 0 で従来表示に degrade。
    if [[ -t 1 ]]; then
      # サイズは stty size < /dev/tty を一次にする: tmux popup 内では tput が実 pty を
      # 引けず 80x24 の fallback を返す（実測・hg-2）— stty は popup 実サイズを返す。
      if _sz="$(stty size </dev/tty 2>/dev/null)" && [[ "$_sz" =~ ^[0-9]+\ [0-9]+$ ]]; then
        _rows="${_sz%% *}"
        _cols="${_sz##* }"
      else
        _rows="$(tput lines 2>/dev/null)" || _rows=0
        _cols="$(tput cols 2>/dev/null)" || _cols=0
      fi
      [[ "$_rows" =~ ^[0-9]+$ ]] || _rows=0
      [[ "$_cols" =~ ^[0-9]+$ ]] || _cols=0
      _h=0
      _w=0
      while IFS= read -r _l; do
        _h=$((_h + 1))
        _nc=${#_l}
        _ascii="${_l//[^ -~]/}"
        _box="${_l//[^│├└─]/}"
        _lw=$((_nc + (_nc - ${#_ascii}) - ${#_box}))
        _w=$((_lw > _w ? _lw : _w))
      done <<< "$_block"
      _top=$(((_rows - _h) / 2))
      _top=$((_top < 0 ? 0 : _top))
      _left=$(((_cols - _w) / 2))
      _left=$((_left < 0 ? 0 : _left))
      _lpad="$(printf '%*s' "$_left" '')"
      _out=""
      for ((_i = 0; _i < _top; _i++)); do _out+=$'\n'; done
      while IFS= read -r _l; do _out+="${_lpad}${_l}"$'\n'; done <<< "$_block"
      printf '\e[H%s\e[J' "$_out"
    else
      printf '\e[H%s\n\e[J' "$_block"
    fi
    # read が sleep 兼 key listener（popup stdin は TTY — 実測）。q / Esc で終了。
    if read -r -s -t "$INTERVAL" -n 1 _key 2>/dev/null; then
      case "$_key" in q|Q|$'\e') exit 0 ;; esac
    else
      _rc=$?
      # rc>128 = timeout（正常 tick）。それ以外（stdin EOF 等）は busy-loop 防止で sleep へ退避
      [[ "$_rc" -gt 128 ]] || sleep "$INTERVAL"
    fi
  done
fi

# --- pick モード: 森ツリーからノードを選び oe-jump で focus → 対象 window を最大化（#227）---
# 森構築/描画は本ツールの既存ロジックを再利用する（自身を --pick-list で再帰起動して候補を
# 取る＝森ロジックを複製しない・DJ-223-6 の「フレーム=一発実行と同一コードパス」を踏襲）。
# jump は oe-jump 再利用（jump ロジックを複製しない）。新規は fzf 選択 + ensure-zoomed のみ。
# データは read-only のまま（jump/zoom は registry/トポロジを編集しない・ユーザー起点のナビ）。
if [[ "$PICK" -eq 1 ]]; then
  # 番号フォールバックの対話入力は端末から直接読む（既定 /dev/tty）。OE_TREE_TTY はテスト用シーム。
  OE_TREE_TTY="${OE_TREE_TTY:-/dev/tty}"

  # (you) の SELF freeze（--watch と同型）: popup 内では TMUX_PANE が unset（実測・#223）。
  # 候補 emit の再帰起動へ export し、フォーカス移動前の自ペインを (you) として一貫表示する。
  if [[ -z "${TMUX_PANE:-}" ]]; then
    _self="$(tmux display-message -p '#{pane_id}' 2>/dev/null)" || _self=""
    [[ -n "$_self" ]] && export TMUX_PANE="$_self"
  fi

  # popup(-E) は終了で即閉じる。jump 不能（gone 等）や zoom 失敗のメッセージを読めるよう、
  # TTY のとき 3s hold してから抜ける（--watch の env_fail と同パターン・DJ-227-4/7）。
  pick_hold() { if [[ -t 0 ]]; then read -r -s -t 3 -n 1 2>/dev/null || true; fi; }

  # ensure_zoom <pane> — 対象 window が未 zoom のときだけ resize-pane -Z -t <pane>（冪等）。
  # 既 zoom(1) は再 -Z しない（トグルで解除される事故を防ぐ・隔離 tmux 3.5a で実測）。
  # flag が 0 / query 失敗（"") のときは -Z を試みる（単一 pane window では無害な no-op）。
  # -t <pane> で対象 window に結びつけるのが要点（無指定は popup/現 window を掴む・設計SO R1）。
  ensure_zoom() {
    local pane="$1" zf
    zf="$(tmux display-message -p -t "$pane" '#{window_zoomed_flag}' 2>/dev/null)" || zf=""
    [[ "$zf" == "1" ]] && return 0
    tmux resize-pane -Z -t "$pane" 2>/dev/null || return 1
    return 0
  }

  # 候補は自身を --pick-list で再帰起動して取得。stdout = "%N<TAB>表示行" のみ／note・空森
  # メッセージは stderr（候補に混ぜない）。mapfile は macOS の bash 3.2 に無いので while-read。
  # ループ: jump 失敗（gone/未解決）は exit せず picker に戻る（#227 hg 追修正）。抜けるのは
  # 成功 / cancel(Esc・空・EOF) / fzf エラー / 空森 / zoom 失敗(既に移動済) のみ。候補は毎回取り直す。
  while :; do
    CANDS=()
    while IFS= read -r _l; do
      [[ "$_l" == %[0-9]*$'\t'* ]] && CANDS+=("$_l")
    done < <("$OE_TREE_SELF" --pick-list)
    if [[ ${#CANDS[@]} -eq 0 ]]; then
      echo "oe-tree: no spawn nodes to pick (see notes above; try: oe-tree)" >&2
      pick_hold
      exit 1
    fi

    # 選択: fzf があれば fzf、無ければ番号フォールバック（oe-select 同型）。
    SELECTED=""
    if command -v fzf >/dev/null 2>&1; then
      # 1 列目（%N）は隠しキー: --delimiter TAB + --with-nth 2 で表示/検索は 2 列目のみ。
      # ctrl-r reload は同一 --pick-list を再実行（fzf は bind を $SHELL -c で走らせるため絶対パス）。
      rc=0
      SELECTED="$(printf '%s\n' "${CANDS[@]}" | fzf \
        --delimiter=$'\t' \
        --with-nth=2 \
        --layout=reverse \
        --prompt='jump> ' \
        --header='enter: jump+zoom   ctrl-r: refresh   esc: cancel' \
        --bind="ctrl-r:reload('${OE_TREE_SELF}' --pick-list)")" || rc=$?
      # rc 130（Ctrl-C）/ 1（no match=未選択）→ cancel(130) / rc>=2（fzf 自体のエラー）→ 2
      if [[ "$rc" -eq 130 || "$rc" -eq 1 ]]; then
        exit 130
      elif [[ "$rc" -ge 2 ]]; then
        echo "oe-tree: fzf failed (rc=${rc})" >&2
        exit 2
      fi
    else
      echo "oe-tree: select a node to jump to:" >&2
      _i=1
      for _l in "${CANDS[@]}"; do
        printf '%3d) %s\n' "$_i" "${_l#*$'\t'}" >&2   # 表示は %N を落とした 2 列目（木の形は保つ）
        _i=$((_i + 1))
      done
      printf 'number> ' >&2
      _reply=""
      if ! IFS= read -r _reply <"$OE_TREE_TTY"; then exit 130; fi   # EOF=cancel
      [[ -n "$_reply" ]] || exit 130                                # 空入力=cancel
      if ! [[ "$_reply" =~ ^[0-9]+$ ]]; then
        echo "oe-tree: invalid selection" >&2; exit 2
      fi
      # 先頭ゼロの 8 進解釈を避けて 10 進化してから範囲チェック（oe-select と同型）。
      _idx=$((10#$_reply))
      if [[ "$_idx" -lt 1 || "$_idx" -gt ${#CANDS[@]} ]]; then
        echo "oe-tree: invalid selection" >&2; exit 2
      fi
      SELECTED="${CANDS[$((_idx - 1))]}"
    fi

    [[ -n "$SELECTED" ]] || exit 130   # 空選択（fzf rc0 + 空 stdout 等）も cancel
    PANE="${SELECTED%%$'\t'*}"
    if ! [[ "$PANE" =~ ^%[0-9]+$ ]]; then
      echo "oe-tree: could not extract pane id from selection" >&2
      exit 1
    fi

    # jump（oe-jump 再利用・focus）。失敗（gone/未解決）は理由を一瞬出して picker に戻る（exit しない）。
    if ! "${BIN_DIR}/oe-jump" -- "$PANE"; then
      echo "oe-tree: '${PANE}' へ jump できません（gone/未解決）— picker に戻ります" >&2
      pick_hold
      continue
    fi

    # zoom（対象指定 ensure-zoomed）。jump は成功済み＝既に移動 — zoom 失敗は部分成功として exit 1
    # （「ジャンプし最大化」を偽らない・戻らない）。
    if ! ensure_zoom "$PANE"; then
      echo "oe-tree: jumped to ${PANE} but failed to zoom (resize-pane -Z)" >&2
      pick_hold
      exit 1
    fi
    exit 0
  done
fi

SELF="${TMUX_PANE:-}"

# --- liveness + 座標（mux 存在 query。1 コールで取る — 追加プロセスなし・DJ-223-11）---
# タブ区切り: pane_id<TAB>window.pane<TAB>session_name。**内部境界に使う列は安全な形式の
# もののみ**にする — $1(pane_id=%N) と $2(window.pane=数値) は tmux が制御文字を含み得ない
# 値で返し、liveness/座標/順序判定はこの 2 列だけで行う。user-controlled な session_name は
# 必ず**最終列**に置き、表示時に sanitize_out を通す（実装SO#2 codex 指摘: session_name を
# 内部区切りに生で混ぜるのを避ける。tmux format は制御文字をリテラルエスケープするため実
# LF/TAB の行・列注入は元々到達不能〔本環境 tmux 3.5a で実測〕だが、その暗黙依存を構造的に
# 断つ — #221 の「表示ツールは自分の脅威モデルで守る」方針と一貫）。
# query 失敗は ? で degrade — oe-activity と同方針。
HAVE_LIVE=0
LIVE_SET=""
_TAB=$'\t'
if LIVE_SET="$(tmux list-panes -a -F "#{pane_id}${_TAB}#{window_index}.#{pane_index}${_TAB}#{session_name}" 2>/dev/null)"; then
  HAVE_LIVE=1
fi
is_alive() { # <pane> — LIVE_SET の第 1 列（pane_id）と厳密一致
  [[ "$HAVE_LIVE" -eq 1 ]] || return 1
  printf '%s\n' "$LIVE_SET" | awk -F '\t' -v p="$1" '$1==p{f=1} END{exit f?0:1}'
}
liveness_of() {
  local pane="$1"
  if [[ "$HAVE_LIVE" -ne 1 ]]; then printf '?'; return; fi
  if is_alive "$pane"; then printf 'alive'; else printf 'gone'; fi
}
winpane_of() { # <pane> — alive ペインの window.pane（安全な数値列 $2）。gone / 不明は "-"
  local c=""
  if [[ "$HAVE_LIVE" -eq 1 ]]; then
    c="$(printf '%s\n' "$LIVE_SET" | awk -F '\t' -v p="$1" '$1==p{print $2; exit}')"
  fi
  printf '%s' "${c:--}"
}
session_of() { # <pane> — alive ペインの session_name（最終列 $3・user-controlled）。無ければ空
  [[ "$HAVE_LIVE" -eq 1 ]] || return 0
  printf '%s\n' "$LIVE_SET" | awk -F '\t' -v p="$1" '$1==p{print $3; exit}'
}
# セッション前置は適応表示（hg-2 ユーザー要望）: live ペインが単一セッションに収まる間は
# window.pane だけを見せ（人間の導線は window/pane 番号）、複数セッションにまたがった時だけ
# session: を自動で前置する（落とすと同名 window.pane が衝突して曖昧になるため）。
SINGLE_SESSION=0
if [[ "$HAVE_LIVE" -eq 1 ]]; then
  _sess_n="$(printf '%s\n' "$LIVE_SET" | awk -F '\t' 'NF>=3{print $3}' | sort -u | grep -c . || true)"
  [[ "$_sess_n" -le 1 ]] && SINGLE_SESSION=1
fi
coord_of() { # <pane> — 表示用座標。単一=window.pane / 複数=session:window.pane / gone=-
  local wp
  wp="$(winpane_of "$1")"
  [[ "$wp" == "-" ]] && { printf '-'; return; }
  if [[ "$SINGLE_SESSION" -eq 1 ]]; then
    printf '%s' "$wp"
  else
    printf '%s:%s' "$(session_of "$1")" "$wp"
  fi
}
# order_panes — stdin の pane 列を表示順に並べる（root と兄弟の順序・hg-2 ユーザー要望）。
# 画面配置順: 座標あり（alive）を session 名 → window 番号 → pane 番号の昇順で先に、
# 座標なし（gone / 不明）は末尾に pane 番号昇順で置く（人間の導線 = 「どの window にいるか」。
# gone root は子が alive でも座標を持たないため末尾に回る — スナップショット意味論の帰結）。
# ソートキーは安全列（winpane $2・session $3）だけを使う。
order_panes() {
  local p wp w pi
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    wp="$(winpane_of "$p")"
    if [[ "$wp" == "-" || "$wp" != *.* ]]; then
      printf '1\t\t0\t0\t%s\t%s\n' "${p#%}" "$p"
    else
      w="${wp%%.*}"
      pi="${wp##*.}"
      printf '0\t%s\t%s\t%s\t%s\t%s\n' "$(session_of "$p")" "$w" "$pi" "${p#%}" "$p"
    fi
  done | sort -t $'\t' -k1,1n -k2,2 -k3,3n -k4,4n -k5,5n | awk -F '\t' '{print $NF}'
}

# --- 現 server の entry 収集（US 区切り: pane<US>parent<US>workspace<US>label）---
# 制御文字は jq 側で C0 全域 + DEL + C1（U+0000-001F / 007F / 0080-009F）を空白へ畳む:
#   - US は行内プロトコルの区切りを壊す（event-bus と同根）・LF/CR は行指向出力の偽行注入
#     （oe_reg_list L155-162 と同じ防御）・TAB は表示崩れ（oe-activity の畳み方針）。
#   - ESC/CSI/OSC 等はツリー行の視覚偽装・画面消去・端末制御に到達し得る（oe-delegate の
#     --label は LF/CR しか拒否しない＝registry 経由で到達可能・実装SO codex 指摘）。
#     oe_reg_list は ANSI を「別軸・scope 外」と注記するが、oe-tree は人間向け cockpit
#     表示そのものなので視覚偽装が本ツールの脅威モデルに入る — codepoint レベルで畳む。
ENTRIES=""
FOREIGN=0
SKIPPED=0
SEEN_PANES=" "
# 置き場が決まらないときは走査しない（#322）。空文字のまま glob すると /*.json ＝ root を
# 走査したうえで空ツリーを exit 0 で出すので、「子は居ない」という誤った成功になる。
if [[ -z "$OE_DELEGATE_STATE_DIR" ]]; then
  echo "oe-tree: 登記の置き場が決まりません（HOME 未設定・OE_DELEGATE_STATE_DIR も未指定）" >&2
  exit 2
fi
for _f in "${OE_DELEGATE_STATE_DIR}"/*.json; do
  [[ -e "$_f" ]] || continue
  _base="$(basename "$_f" .json)"
  if [[ "$_base" != "${SERVER_PID}_"* ]]; then
    FOREIGN=$((FOREIGN + 1))
    continue
  fi
  _line="$(jq -r '
    def clean: tostring | gsub("[\u0000-\u001f\u007f-\u009f]"; " ");
    [ (.pane // "" | clean), (.parent_pane // "" | clean),
      (.workspace // "" | clean), (.label // "" | clean) ] | join("\u001f")
  ' "$_f" 2>/dev/null)" || { SKIPPED=$((SKIPPED + 1)); continue; }
  [[ -n "$_line" ]] || { SKIPPED=$((SKIPPED + 1)); continue; }
  _pane="${_line%%$'\037'*}"
  # pane が %N 形でない entry は辺として解釈できない（壊れた JSON と同扱い）。
  # 同一 pane の重複 entry（key と .pane の不整合＝write 側不変条件違反）は先勝ちで捨てる
  # — dedup しないと 2 回目の render が visited に当たり偽 [cycle] を表示する（実装SO 指摘）。
  if ! [[ "$_pane" =~ ^%[0-9]+$ ]] || [[ "$SEEN_PANES" == *" ${_pane} "* ]]; then
    SKIPPED=$((SKIPPED + 1))
    continue
  fi
  SEEN_PANES+="${_pane} "
  ENTRIES+="${_line}"$'\n'
done

# --- 拍動 sidecar（#327）---
# 目的の面は本 verb の `--pick`（cockpit の popup）。行末にモデル名とコンテキスト% を足す。
#
# **拍動のために起こす jq を sidecar の件数に比例させない**（dir 全体を 1 回の jq で舐める）。
# --watch は tick ごとに自分を再 exec し、--pick も候補取得のたびに再帰起動するので、1 ファイル
# 1 プロセスにすると popup の常設経路が sidecar の件数だけプロセスを起こすことになる（実測で 176 件）。
# 実測: 拍動のために増える jq は 2 回（一括読み 1 + モデル名の sanitize 1）。**フレーム全体では
# 20 回前後**で、残りは登記とラベルの解決など既存の経路が使っている（拍動なしの版で 18 回）。
# 壊れた JSON があると jq は reader 段で全体を止めるため、その場合だけ 1 ファイルずつの遅い経路へ
# 落ちて件数を数える（正常時は 1 プロセス・異常時だけ honest degrade）。
#
# 帰属は oe-threads と同じ規則: 鮮度窓内の候補が 1 件なら確定 / 2 件以上は最新で潰さず ambiguous /
# 0 件なら何も足さない。突合は server_pid と pane の組で、server_pid が空の旧 sidecar は pane 単独で
# 突合する劣化動作（既存の記録を全部落とさないため）。
BEAT_DIR="${OE_HEARTBEAT_DIR:-}"
if [[ -z "$BEAT_DIR" ]]; then
  case "${HOME:-}" in
    /|//) BEAT_DIR="" ;;
    /*)   BEAT_DIR="${HOME}/.claude/state/oe-heartbeat" ;;
    *)    BEAT_DIR="" ;;
  esac
fi
BEAT_WINDOW="${OE_TREE_BEAT_WINDOW_SEC:-900}"
[[ "$BEAT_WINDOW" =~ ^[0-9]+$ && "$BEAT_WINDOW" -gt 0 ]] || BEAT_WINDOW=900
BEAT_NOW="${NOW_EPOCH:-$(date +%s 2>/dev/null)}"
[[ "$BEAT_NOW" =~ ^[0-9]+$ ]] || BEAT_NOW=0
# observer の身元は list-panes に答えた server（#{pid}）から取り、取れなければ $TMUX 由来の
# SERVER_PID へ落とす。**どちらも取れないときは fail-closed** にする（実装SO 指摘）:
# 身元不明のまま「server_pid を持つ sidecar を全部通す」と、別 server の同番ペインを誤帰属する。
BEAT_SPID="$(tmux display-message -p '#{pid}' 2>/dev/null)"
[[ "$BEAT_SPID" =~ ^[0-9]+$ ]] || BEAT_SPID="$SERVER_PID"
[[ "$BEAT_SPID" =~ ^[0-9]+$ ]] || BEAT_SPID=""
BEATS=""            # pane US n US ctx US model の行（n>=2 は ambiguous）
BEAT_UNREADABLE=0   # 読めなかった sidecar（権限 / I-O）
BEAT_MALFORMED=0    # 中身が壊れていた sidecar
BEAT_DIR_BAD=0      # 置き場そのものが読めない

# shellcheck disable=SC2016  # $now/$win/$spid/$sep は jq の変数（--argjson / --arg で渡す）なので展開させない
# **@tsv でエスケープしてから区切りを US へ変換する**（実装SO 指摘）。join で生の値を並べると、
# producer が保持する display_name 内の改行がそのままレコード境界になり、awk が別の行として読む。
# 悪意ある値なら別ペインの拍動を偽装して注入できる（実際に到達可能であることを実装SO が確認した）。
# @tsv は値の中の TAB / 改行 / バックスラッシュをエスケープするので、変換後の US は区切りだけになる。
#
# server の突合規則: observer の身元が分かっているときは「sidecar の server_pid が空（旧記録）か
# 一致」を通し、身元が分からないときは「空だけ」を通す（fail-closed）。
#
# 先頭に !skipped 行を出して、valid JSON だが object でない sidecar の件数を返す。jq は成功するので
# 遅い経路に落ちず、数えないと「壊れを note で開示する」契約を満たせない（実装SO 指摘）。
_beat_program='
  def s: if type == "string" then . else "" end;
  def n: if type == "number" then . else null end;
  [inputs] as $all
  | ([ $all[] | select(type != "object") ] | length) as $nonobj
  | ([ $all[]
       | select(type == "object")
       | { pane: (.pane | s),
           ts: (.ts | n),
           ctx: (.context_pct | n),
           spid: (.server_pid | s),
           model: (if (.model | type) == "object" then (.model.display_name | s) else "" end) }
       | select(.pane != "" and .ts != null)
       | select($now - .ts >= 0 and $now - .ts <= $win)
       | select(if $spid == "" then .spid == "" else (.spid == "" or .spid == $spid) end) ]
     | group_by(.pane)
     | map({ pane: .[0].pane, n: length, best: (sort_by(.ts) | last) })) as $rows
  | (["!skipped", ($nonobj | tostring), "", ""] | @tsv),
    ($rows[]
     | [ .pane, (.n | tostring),
         (if .n == 1 then (if .best.ctx == null then "" else (.best.ctx | floor | tostring) end) else "" end),
         (if .n == 1 then .best.model else "" end) ]
     | @tsv)'

if command -v jq >/dev/null 2>&1 && [[ -n "$BEAT_DIR" ]]; then
  if [[ -e "$BEAT_DIR" && ! -d "$BEAT_DIR" ]] || { [[ -d "$BEAT_DIR" ]] && ! { [[ -r "$BEAT_DIR" && -x "$BEAT_DIR" ]]; }; }; then
    BEAT_DIR_BAD=1
  else
    shopt -s nullglob
    _beat_files=("$BEAT_DIR"/*.json)
    shopt -u nullglob
    if [[ "${#_beat_files[@]}" -gt 0 ]]; then
      # 速い経路: 1 プロセスで dir 全体を舐める
      if ! BEATS="$(jq -rn --argjson now "$BEAT_NOW" --argjson win "$BEAT_WINDOW" \
                        --arg spid "$BEAT_SPID" \
                        "$_beat_program" "${_beat_files[@]}" 2>/dev/null | tr '\011' '\037')"; then
        # 遅い経路: 壊れた JSON が混じっているので 1 件ずつ読み、件数を数える
        BEATS=""
        _beat_ok=()
        for _bf in "${_beat_files[@]}"; do
          _brc=0
          jq -e 'type == "object"' "$_bf" >/dev/null 2>&1 || _brc=$?
          if [[ "$_brc" -eq 2 ]]; then
            BEAT_UNREADABLE=$((BEAT_UNREADABLE + 1))
          elif [[ "$_brc" -ne 0 ]]; then
            BEAT_MALFORMED=$((BEAT_MALFORMED + 1))
          else
            _beat_ok+=("$_bf")
          fi
        done
        if [[ "${#_beat_ok[@]}" -gt 0 ]]; then
          BEATS="$(jq -rn --argjson now "$BEAT_NOW" --argjson win "$BEAT_WINDOW" \
                       --arg spid "$BEAT_SPID" \
                       "$_beat_program" "${_beat_ok[@]}" 2>/dev/null | tr '\011' '\037')" || BEATS=""
        fi
      fi
    fi
  fi
fi

# 先頭の !skipped 行（object でない valid JSON の件数）を取り出して malformed に足す。
if [[ -n "$BEATS" ]]; then
  _beat_skipped="$(printf '%s' "$BEATS" | awk -F $'\037' '$1=="!skipped" {print $2; exit}')"
  [[ "$_beat_skipped" =~ ^[0-9]+$ ]] && BEAT_MALFORMED=$((BEAT_MALFORMED + _beat_skipped))
  BEATS="$(printf '%s' "$BEATS" | awk -F $'\037' '$1!="!skipped"')"
fi

# beat_of <pane> — 行末に足す文字列（無ければ空）。ENTRIES と同じ US 区切り + awk の idiom。
beat_of() {
  [[ -n "$BEATS" ]] || return 0
  local rec n ctx model
  rec="$(printf '%s' "$BEATS" | awk -F $'\037' -v p="$1" '$1==p {print $2 "\037" $3 "\037" $4; exit}')"
  [[ -n "$rec" ]] || return 0
  n="${rec%%$'\037'*}"; rec="${rec#*$'\037'}"
  ctx="${rec%%$'\037'*}"; model="${rec#*$'\037'}"
  if [[ "$n" != "1" ]]; then
    printf 'ambiguous(%s)' "$n"
    return 0
  fi
  model="$(sanitize_out "$model")"
  [[ "${#model}" -gt 40 ]] && model="${model:0:40}..."
  if [[ -n "$model" && -n "$ctx" ]]; then printf '%s %s%%' "$model" "$ctx"
  elif [[ -n "$model" ]];              then printf '%s' "$model"
  elif [[ -n "$ctx" ]];                then printf '%s%%' "$ctx"
  fi
}

# 読めない/解釈できない/重複の現 server entry は無言で捨てず件数を footer で開示する
# （foreign と同型の honest degrade — 全滅時も部分スキップ時も「登記どおり」と偽らない。実装SO 指摘）。
# picklist モードでは note / 空森メッセージを stderr へ流す（stdout は候補行だけに保つ —
# --pick 側が stdout を "%N<TAB>表示行" の候補列として読むため）。view モードは従来どおり stdout。
_note_fd=1
[[ "$MODE" == picklist ]] && _note_fd=2
print_notes() {
  [[ "$SKIPPED" -gt 0 ]] && echo "note: ${SKIPPED} entries skipped (unreadable or duplicate pane)" >&"$_note_fd"
  [[ "$FOREIGN" -gt 0 ]] && echo "note: ${FOREIGN} entries from other tmux servers not shown (stale)" >&"$_note_fd"
  # 拍動は装飾なので tree は止めないが、読めなかったことは黙って捨てない（#327）。
  [[ "$BEAT_DIR_BAD" -gt 0 ]] && echo "note: heartbeat dir unreadable (model/context omitted)" >&"$_note_fd"
  [[ "$BEAT_UNREADABLE" -gt 0 ]] && echo "note: ${BEAT_UNREADABLE} heartbeat files unreadable" >&"$_note_fd"
  [[ "$BEAT_MALFORMED" -gt 0 ]] && echo "note: ${BEAT_MALFORMED} heartbeat files malformed" >&"$_note_fd"
  return 0
}

if [[ -z "$ENTRIES" ]]; then
  if [[ "$SKIPPED" -gt 0 ]]; then
    echo "(no readable spawn entries for this tmux server)" >&"$_note_fd"
  else
    echo "(no spawn entries for this tmux server)" >&"$_note_fd"
  fi
  print_notes
  exit 0
fi

entry_field_of() { # <pane> <field-index> — ENTRIES から該当 pane の列を引く
  printf '%s' "$ENTRIES" | awk -F $'\037' -v p="$1" -v i="$2" '$1==p {print $i; exit}'
}

children_of() { # <pane> — 直下の子を表示順（order_panes: 画面配置順・座標なしは末尾）で
  printf '%s' "$ENTRIES" | awk -F $'\037' -v p="$1" '$2==p {print $1}' | order_panes
}

# sanitize_out <text> — 出力チョークポイントの sanitize（収集ループの clean と同じ
# codepoint クラス。pane-issue / pane_title / tmux 座標由来＝jq clean を通らない経路の一括防御）。
# jq 失敗時は C0+DEL のみの byte-wise tr へ縮退（C0/DEL は UTF-8 多バイト列に現れない）。
sanitize_out() {
  printf '%s' "$1" | jq -Rrs 'gsub("[\u0000-\u001f\u007f-\u009f]"; " ")' 2>/dev/null \
    || printf '%s' "$1" | LC_ALL=C tr '\000-\037\177' ' '
}

label_of() { # <pane> — pane-issue(.name) > registry(.label) > pane_title(alive のみ) > "?"
  local pane="$1" key label=""
  key="$(_oe_reg_key "$pane")"
  if [[ -n "$OE_PANE_ISSUE_DIR" && -f "${OE_PANE_ISSUE_DIR}/${key}" ]]; then
    label="$(jq -r '.name // empty' "${OE_PANE_ISSUE_DIR}/${key}" 2>/dev/null)" || label=""
  fi
  [[ -n "$label" ]] || label="$(entry_field_of "$pane" 4)"
  if [[ -z "$label" ]] && is_alive "$pane"; then
    label="$(tmux display-message -p -t "$pane" '#{pane_title}' 2>/dev/null)" || label=""
  fi
  label="$(sanitize_out "$label")"
  printf '%s' "${label:-?}"
}

# --- 森林構築: root = parent 参照のうち entry 無し pane ∪ parent 空の entry ---
ROOTS="$(
  {
    printf '%s' "$ENTRIES" | awk -F $'\037' '$2!="" {print $2}' | sort -u \
    | while IFS= read -r _p; do
        [[ -n "$_p" ]] || continue
        if ! printf '%s' "$ENTRIES" | awk -F $'\037' -v p="$_p" '$1==p {found=1} END {exit found?0:1}'; then
          printf '%s\n' "$_p"
        fi
      done
    printf '%s' "$ENTRIES" | awk -F $'\037' '$2=="" {print $1}'
  } | sort -u | order_panes
)"

VISITED=" "
render() { # <pane> <prefix> <child-prefix>
  local pane="$1" pfx="$2" cpfx="$3"
  local live coord label ws suffix="" _beat
  # picklist モードは各ノード行の先頭に隠しキー列 "%N<TAB>" を前置する（fzf の --with-nth 2 /
  # 番号 fallback の %N 抽出用）。表示本文（$pfx 以降）は view と同一なので木の形は保たれる。
  if [[ "$VISITED" == *" ${pane} "* ]]; then
    if [[ "$MODE" == picklist ]]; then
      printf '%s\t%s%s  [cycle]\n' "$pane" "$pfx" "$pane"
    else
      printf '%s%s  [cycle]\n' "$pfx" "$pane"
    fi
    return 0
  fi
  VISITED+="${pane} "
  live="$(liveness_of "$pane")"
  # 座標も出力チョークポイントを通す（session_name はユーザー入力由来）。座標が先頭列
  # （hg-2 ユーザー要望: 人間の導線 = window/pane 番号を %N より前に）。%-4s / %-5s は
  # "1.2" / "%120" 級の最小揃え（長い値は溢れてよい — 表示ツールの正直な degrade）。
  coord="$(sanitize_out "$(coord_of "$pane")")"
  label="$(label_of "$pane")"
  ws="$(entry_field_of "$pane" 3)"
  [[ -n "$ws" ]] && suffix+=" ~${ws##*/}"
  [[ -n "$SELF" && "$pane" == "$SELF" ]] && suffix+=" (you)"
  # 拍動は行末に足す（#327・owner 裁定）。gone / 拍動なしでは何も足さない。
  # gone は「tmux にそのペインが無い」なので、そのペインを名乗る sidecar が新しくても
  # 現役の帰属とは言えない（pane 再利用の誤帰属になる）。alive と ?（tmux 不明）だけに出す。
  _beat=""
  [[ "$live" != "gone" ]] && _beat="$(beat_of "$pane")"
  [[ -n "$_beat" ]] && suffix+="  ${_beat}"
  if [[ "$MODE" == picklist ]]; then
    printf '%s\t%s%-4s  %-5s  %-5s  %s%s\n' "$pane" "$pfx" "$coord" "$pane" "$live" "$label" "$suffix"
  else
    printf '%s%-4s  %-5s  %-5s  %s%s\n' "$pfx" "$coord" "$pane" "$live" "$label" "$suffix"
  fi
  local kids n i=0 c
  kids="$(children_of "$pane")"
  n="$(printf '%s' "$kids" | grep -c . || true)"
  while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    i=$((i + 1))
    if [[ "$i" -eq "$n" ]]; then
      render "$c" "${cpfx}└─ " "${cpfx}   "
    else
      render "$c" "${cpfx}├─ " "${cpfx}│  "
    fi
  done <<< "$kids"
}

while IFS= read -r _r; do
  [[ -n "$_r" ]] || continue
  render "$_r" "" ""
done <<< "$ROOTS"

# 未到達 entry の sweep: 純粋 cycle（全ノードが entry 持ち parent を指す輪）は root を
# 持たず上のループで描かれない。無言で消すと「登記に在るのに見えない」偽りになるため、
# 最小 pane を擬似 root として描く（cycle guard が輪の閉じで [cycle] を打って止める）。
while IFS= read -r _p; do
  [[ -n "$_p" ]] || continue
  [[ "$VISITED" == *" ${_p} "* ]] && continue
  render "$_p" "" ""
done < <(printf '%s' "$ENTRIES" | awk -F $'\037' '{print $1}' | sort -t% -k2 -n)

print_notes
exit 0
