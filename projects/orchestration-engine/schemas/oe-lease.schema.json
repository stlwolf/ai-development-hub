{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/stlwolf/ai-development-hub/schemas/oe-lease.schema.json",
  "title": "oe-lease record",
  "description": "#577: 統括と委譲子の「誰か」を持つ lease の記録。1つのファイル（~/.claude/state/oe-lease/<lease_id>.json）の中に、lease の表（持ち場の項目）と generations の表を分けて持つ（owner の答え Q73）。書き手は lib/lease.sh だけで、lease ごとのロックの中で epoch を比べてから書く。ペインと tmux server の pid は持たない（heartbeat の sidecar に観測として残し、読むときに突き合わせる・DJ-3）。",
  "type": "object",
  "required": ["format", "lease_id", "kind", "label", "workspace", "parent_lease_id", "state", "created_at", "closed_at", "epoch", "current_generation", "generations"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "lease_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "lease の ID（lib/session.sh の oe_generate_session_id と同じ形）" },
    "kind": { "enum": ["supervisor", "delegation"], "description": "supervisor は統括の持ち場（交代で generation が進む）、delegation は委譲1件の持ち場" },
    "label": { "type": "string", "description": "人が呼ぶ名前（cockpit・#577 など）。宛先の label の引き方に使う" },
    "workspace": { "type": "string" },
    "parent_lease_id": { "type": "string", "pattern": "^([0-9A-HJKMNP-TV-Z]{26})?$", "description": "親の lease。空なら root。書き換えると epoch が増える" },
    "state": { "enum": ["open", "closed"] },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "closed_at": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$" },
    "epoch": { "type": "integer", "minimum": 0, "description": "binding・generation・親が変わるたびに1つ増える。compare-and-swap で比べる（効くのは lease の記録への書き込みだけ・owner の答え Q72）" },
    "current_generation": { "type": "integer", "minimum": 1 },
    "generations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["generation", "state", "started_at", "retired_at", "successor", "session_ids", "binding"],
        "additionalProperties": false,
        "properties": {
          "generation": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["active", "retired"] },
          "started_at": { "type": "string" },
          "retired_at": { "type": "string" },
          "successor": { "type": ["integer", "null"] },
          "session_ids": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "uniqueItems": true, "description": "この generation の会話の session_id。登録するのは本人の verb だけ（DJ-18）。開いた lease のあいだで重ならない" },
          "rebinds": {
            "type": "array",
            "description": "#355: 同じ generation の中で binding を別のプロセスに張り替えたとき、張り替える前の binding を張り替えと同じ1回の書き込みで足していく並び（古い順）。張り替えが無ければ項目ごと無い",
            "items": {
              "type": "object",
              "required": ["pid", "started", "comm", "bound_at", "replaced_at"],
              "additionalProperties": false,
              "properties": {
                "pid": { "type": "integer", "minimum": 1 },
                "started": { "type": "string", "minLength": 1 },
                "comm": { "type": "string", "pattern": "claude" },
                "bound_at": { "type": "string" },
                "replaced_at": { "type": "string" }
              }
            }
          },
          "binding": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["pid", "started", "comm", "bound_at"],
                "additionalProperties": false,
                "properties": {
                  "pid": { "type": "integer", "minimum": 1 },
                  "started": { "type": "string", "minLength": 1, "description": "LC_ALL=C の ps -o lstart= の値（連続する空白は1つに詰める）" },
                  "comm": { "type": "string", "pattern": "claude" },
                  "bound_at": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
